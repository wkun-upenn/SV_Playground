    {
      "type": "text",
      "version": 376,
      "versionNonce": 1950516256,
      "index": "c0SH",
      "isDeleted": false,
      "id": "P30jbv8U9AD9CFBgaA0XE",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 936.5833333333328,
      "y": 1618.2389482770652,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
