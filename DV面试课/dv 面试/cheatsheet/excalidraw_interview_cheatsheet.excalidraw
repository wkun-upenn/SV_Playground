      "boundElements": [],
      "updated": 1731557653519,
      "link": null,
      "locked": false,
      "text": "`uvm_register_cb(driver, driver_callback)\n\nclass driver_callback extends uvm_callback;\nendclass\n\nclass my_callback extends driver_callback;\nendclass\n\nuvm_callbacks #(driver, driver_callback)::add(drv, my_cb);\n\n`uvm_do_callback(driver, driver_callback, func());\n\n`uvm_set_super_type(new_driver, driver)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "`uvm_register_cb(driver, driver_callback)\n\nclass driver_callback extends uvm_callback;\nendclass\n\nclass my_callback extends driver_callback;\nendclass\n\nuvm_callbacks #(driver, driver_callback)::add(drv, my_cb);\n\n`uvm_do_callback(driver, driver_callback, func());\n\n`uvm_set_super_type(new_driver, driver)",
      "autoResize": true,
      "lineHeight": 1.25
    },
