      "seed": 1385757470,
      "version": 44,
      "versionNonce": 86413918,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1730964321889,
      "link": null,
      "locked": false,
      "text": "task apb_master_monitor::run();\n  fork\n    monitor_transactions();\n  join_none\nendtask // run\n  \ntask apb_master_monitor::monitor_transactions();\n   forever begin\n \n      // Extract data from interface into transaction\n      collect_transfer();\n      // Check transaction\n      // Update coverage\n      // Publish to subscribers\n   end\nendtask // monitor_transactions\n  \ntask apb_master_monitor::collect_transfer();\n  // Advance clock\n  @(vif.cb_mon);\n  trans_collected = apb_transfer::type_id::create(\"trans_collected\");\n  case(vif.cb_mon.pwrite)\n    1'b1    : begin\n                @(vif.cb_mon iff vif.cb_mon.pready === 1'b1);\n                trans_collected.trans_kind = WRITE;\n              end \n    1'b0    : begin\n                @(vif.cb_mon iff vif.cb_mon.pready === 1'b1);\n                trans_collected.trans_kind = READ;\n              end\n  endcase\nendtask: collect_transfer \n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "task apb_master_monitor::run();\n  fork\n    monitor_transactions();\n  join_none\nendtask // run\n  \ntask apb_master_monitor::monitor_transactions();\n   forever begin\n \n      // Extract data from interface into transaction\n      collect_transfer();\n      // Check transaction\n      // Update coverage\n      // Publish to subscribers\n   end\nendtask // monitor_transactions\n  \ntask apb_master_monitor::collect_transfer();\n  // Advance clock\n  @(vif.cb_mon);\n  trans_collected = apb_transfer::type_id::create(\"trans_collected\");\n  case(vif.cb_mon.pwrite)\n    1'b1    : begin\n                @(vif.cb_mon iff vif.cb_mon.pready === 1'b1);\n                trans_collected.trans_kind = WRITE;\n              end \n    1'b0    : begin\n                @(vif.cb_mon iff vif.cb_mon.pready === 1'b1);\n                trans_collected.trans_kind = READ;\n              end\n  endcase\nendtask: collect_transfer \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "n0x9Q6k_dVDdzKdmIo0cg",
      "type": "text",
      "x": 4981.7867965368,
      "y": 1315.4337931491368,
      "width": 847,
