      "boundElements": [],
      "updated": 1727366781530,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "class sequence extends uvm_sequence #(chnl_trans);\n\n    `uvm_declare_p_sequencer(chnl_sequencer)\n    //p_sequencer.reg_sqr\n\n    task body();\n      repeat(ntrans) send_trans();\n    endtask\n\n    task send_trans();\n      chnl_trans req, rsp;\n      `uvm_do_with(req, \n        {\n          local::ch_id >= 0 -> ch_id == local::ch_id;    \n        })\n      get_response(rsp);\n\n      uvm_sequence_item temp;\n      item req,rsp;\n      temp = create_item(item::get_type(),m_sequencer,\"req\");\n      void'($cast(req,temp));\n      start_item(req);\n      //在 start_item 和 finish_item 之间需要对 sequence item 进行 randomize\n      req.randomize with{data==20;};\n      finish_item(req);\n      get_response(temp);\n      void'($cast(rsp,temp));\n    endtask\nendclass\n\nclass mcdf_virtual_sequencer extends uvm_sequencer #(uvm_sequence_item);\n  apb_master_sequencer reg_sqr;\n  mcdf_rgm rgm;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class sequence extends uvm_sequence #(chnl_trans);\n\n    `uvm_declare_p_sequencer(chnl_sequencer)\n    //p_sequencer.reg_sqr\n\n    task body();\n      repeat(ntrans) send_trans();\n    endtask\n\n    task send_trans();\n      chnl_trans req, rsp;\n      `uvm_do_with(req, \n        {\n          local::ch_id >= 0 -> ch_id == local::ch_id;    \n        })\n      get_response(rsp);\n\n      uvm_sequence_item temp;\n      item req,rsp;\n      temp = create_item(item::get_type(),m_sequencer,\"req\");\n      void'($cast(req,temp));\n      start_item(req);\n      //在 start_item 和 finish_item 之间需要对 sequence item 进行 randomize\n      req.randomize with{data==20;};\n      finish_item(req);\n      get_response(temp);\n      void'($cast(rsp,temp));\n    endtask\nendclass\n\nclass mcdf_virtual_sequencer extends uvm_sequencer #(uvm_sequence_item);\n  apb_master_sequencer reg_sqr;\n  mcdf_rgm rgm;",
      "autoResize": true,
      "lineHeight": 1.25
    },
