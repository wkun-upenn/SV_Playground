      "text": "string ans = \"\" = {\"a\", \"b\"} = {2{\"a\"}}\nstr.len()/putc(3, \"d\")/getc(3)/atio()/substr(i, j)\n\ntypedef enum{red,blue} light;\nint c = red + 1; light l = light'(c)\nl.first()/last()/next()/prev/num()\nlight l = l.first();\ndo begin\n    l = l.next();\nend\nwhile(l != l.first())\n\n//default : unsigned & unpacked \n//unpacked signed structure is illegal, defalut format is unpacked \n//packed structure cannot have rand variables\ntypedef struct packed signed{\n  int coins;\n  real dollars;\n  byte data[4];\n} money;\n//default 中的内容可以被后面的覆盖\nmoney array = '{coins:100，default: 0, data:0};\n\nbit[3:0][7:0] data;   data = 32'h0;   //4row 8col\nforeach (array[i][j]) \n\n//unpacked arrays\n      3           1    2     //Dimensionnumbers \nreg [15:0] mem3 [0:3][0:1];//4row 2col\nlogic [7:0] m [2][2] = '{ '{5, 10}, '{15, 20} };\n$size(mem3, 1) = 4\n\nint array[];\narray = new[8];\narray = {0, 1, 2, default:1};\narray = new[20](array);\n\ntypedef int array[] dy;\ndy queue[$];\n\nint array[index_type] = '{1:22, 6:34};\narray.exists()/delete(idx)/size()/num()\nforeach(array[key][value]) begin\nend\n\nint array[$] = {0, 1, 2};\nint array[$:2] = {1,}\narray2 = {1, array};\narray = array[0:$-1];\narray[$+1] = 3;\narray.push_back()/push_front()/pop_front()/pop_back()/delete()\n\nbit[7:0] array[2] = '{8'b1, 8'b2};\nbit[15:0] array2 = {>>{array}} 12; / {<<8{array}}; 21\n{>>{s0, s1}} = array2;\n\n$random(seed)%n:产生随机数范围为[(-n+1):(n-1)]\n{$random(seed)}%n:实现了一个范围在[0:(n-1)]的随机数，这里n为大于0的整数\n$random()%(b-a+1)+a:表示 a~b 之间的一个随机整数\n$urandom_range(10, 50)\nbit result = std::randomize(a) with{a >= 1};\naddr       = {$urandom, $urandom };  //64-bit random number\nnumber     = $urandom & 15;          //4-bit  random number\nobject.randomize() with {};\n\nclass C2; \n  integer x;\n  integer y;\n\n  task doit(C1 f, integer x, integer z); \n    int result;\n    result = f.randomize() with {x < y + z;}; \n    //x -> class C1 / y -> class C2 / z -> local argument.\n\n    result = f.randomize() with {local::x < y + z;}; \n    //x -> local argument\n  endtask\nendclass\n\nbus.cstr.constraint_mode(0);\nbus.constraint_mode(0);\n//these will change randc behavior\nbus.rand_mode(0);\nbus.data.rand_mode(0);\nconstraint bus::cstr2 { addr > 5; }\npre_randomize();\npost_randomize();\n\n\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "string ans = \"\" = {\"a\", \"b\"} = {2{\"a\"}}\nstr.len()/putc(3, \"d\")/getc(3)/atio()/substr(i, j)\n\ntypedef enum{red,blue} light;\nint c = red + 1; light l = light'(c)\nl.first()/last()/next()/prev/num()\nlight l = l.first();\ndo begin\n    l = l.next();\nend\nwhile(l != l.first())\n\n//default : unsigned & unpacked \n//unpacked signed structure is illegal, defalut format is unpacked \n//packed structure cannot have rand variables\ntypedef struct packed signed{\n  int coins;\n  real dollars;\n  byte data[4];\n} money;\n//default 中的内容可以被后面的覆盖\nmoney array = '{coins:100，default: 0, data:0};\n\nbit[3:0][7:0] data;   data = 32'h0;   //4row 8col\nforeach (array[i][j]) \n\n//unpacked arrays\n      3           1    2     //Dimensionnumbers \nreg [15:0] mem3 [0:3][0:1];//4row 2col\nlogic [7:0] m [2][2] = '{ '{5, 10}, '{15, 20} };\n$size(mem3, 1) = 4\n\nint array[];\narray = new[8];\narray = {0, 1, 2, default:1};\narray = new[20](array);\n\ntypedef int array[] dy;\ndy queue[$];\n\nint array[index_type] = '{1:22, 6:34};\narray.exists()/delete(idx)/size()/num()\nforeach(array[key][value]) begin\nend\n\nint array[$] = {0, 1, 2};\nint array[$:2] = {1,}\narray2 = {1, array};\narray = array[0:$-1];\narray[$+1] = 3;\narray.push_back()/push_front()/pop_front()/pop_back()/delete()\n\nbit[7:0] array[2] = '{8'b1, 8'b2};\nbit[15:0] array2 = {>>{array}} 12; / {<<8{array}}; 21\n{>>{s0, s1}} = array2;\n\n$random(seed)%n:产生随机数范围为[(-n+1):(n-1)]\n{$random(seed)}%n:实现了一个范围在[0:(n-1)]的随机数，这里n为大于0的整数\n$random()%(b-a+1)+a:表示 a~b 之间的一个随机整数\n$urandom_range(10, 50)\nbit result = std::randomize(a) with{a >= 1};\naddr       = {$urandom, $urandom };  //64-bit random number\nnumber     = $urandom & 15;          //4-bit  random number\nobject.randomize() with {};\n\nclass C2; \n  integer x;\n  integer y;\n\n  task doit(C1 f, integer x, integer z); \n    int result;\n    result = f.randomize() with {x < y + z;}; \n    //x -> class C1 / y -> class C2 / z -> local argument.\n\n    result = f.randomize() with {local::x < y + z;}; \n    //x -> local argument\n  endtask\nendclass\n\nbus.cstr.constraint_mode(0);\nbus.constraint_mode(0);\n//these will change randc behavior\nbus.rand_mode(0);\nbus.data.rand_mode(0);\nconstraint bus::cstr2 { addr > 5; }\npre_randomize();\npost_randomize();\n\n\n",
