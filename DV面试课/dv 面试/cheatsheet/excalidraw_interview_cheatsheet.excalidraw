    {
      "id": "qha-8IAotP7FYr7jwIVch",
      "type": "text",
      "x": 4811.279555547805,
      "y": 462.54431394546737,
      "width": 759,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0UD",
