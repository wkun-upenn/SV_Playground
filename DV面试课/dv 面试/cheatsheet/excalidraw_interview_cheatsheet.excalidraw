      "text": "\nclass smartisan_driver extends uvm_driver;\n    `uvm_component_param_utils(smartisan_driver)\n    virtual smartisan_if vif;\n\n    task run_phase(uvm_phase phase);\n    fork\n        get_and_drive();\n        reset_listener();\n    join_none\n    endtask : run\n\n    task apb_master_driver::get_and_drive();\n        forever begin\n            seq_item_port.get_next_item(req);\n            drive_transfer(req);\n            void'($cast(rsp, req.clone()));\n            rsp.set_sequence_id(req.get_sequence_id());\n            rsp.set_transaction_id(req.get_transaction_id());\n            seq_item_port.item_done(rsp);\n        end\n    endtask : get_and_drive\n\n    task apb_master_driver::drive_transfer (item t);\n        case(t.trans_kind)\n            WRITE   : this.do_write(t);\n            READ    : this.do_read(t);\n        endcase\n    endtask : drive_transfer\n\n    task apb_master_driver::do_write(apb_transfer t);\n        `uvm_info(get_type_name(), \"do_write ...\", UVM_HIGH)\n        @(vif.mp.cb);\n        vif.mp.cb.paddr <= t.addr;\n    endtask: do_write\n\n    task apb_master_driver::do_read(apb_transfer t);\n        @(vif.mp.cb);\n        t.data = vif.mp.cb.prdata;\n    endtask: do_read\n\n    task apb_master_driver::reset_listener();\n        forever begin\n        @(negedge vif.rstn); // ASYNC reset\n        vif.mp.cb.paddr <= 0;\n        end\n    endtask",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nclass smartisan_driver extends uvm_driver;\n    `uvm_component_param_utils(smartisan_driver)\n    virtual smartisan_if vif;\n\n    task run_phase(uvm_phase phase);\n    fork\n        get_and_drive();\n        reset_listener();\n    join_none\n    endtask : run\n\n    task apb_master_driver::get_and_drive();\n        forever begin\n            seq_item_port.get_next_item(req);\n            drive_transfer(req);\n            void'($cast(rsp, req.clone()));\n            rsp.set_sequence_id(req.get_sequence_id());\n            rsp.set_transaction_id(req.get_transaction_id());\n            seq_item_port.item_done(rsp);\n        end\n    endtask : get_and_drive\n\n    task apb_master_driver::drive_transfer (item t);\n        case(t.trans_kind)\n            WRITE   : this.do_write(t);\n            READ    : this.do_read(t);\n        endcase\n    endtask : drive_transfer\n\n    task apb_master_driver::do_write(apb_transfer t);\n        `uvm_info(get_type_name(), \"do_write ...\", UVM_HIGH)\n        @(vif.mp.cb);\n        vif.mp.cb.paddr <= t.addr;\n    endtask: do_write\n\n    task apb_master_driver::do_read(apb_transfer t);\n        @(vif.mp.cb);\n        t.data = vif.mp.cb.prdata;\n    endtask: do_read\n\n    task apb_master_driver::reset_listener();\n        forever begin\n        @(negedge vif.rstn); // ASYNC reset\n        vif.mp.cb.paddr <= 0;\n        end\n    endtask",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
