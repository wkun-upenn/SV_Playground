      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "class mcdf_env extends uvm_env;\n    chnl_agent chnl_agts[4];\n    mcdf_virtual_sequencer virt_sqr;\n    mcdf_rgm rgm;\n    reg2mcdf_adapter adapter;\n\n    function void build_phase(uvm_phase phase);\n      rgm = mcdf_rgm::type_id::create(\"rgm\", this);\n      rgm.build();\n      uvm_config_db#(mcdf_rgm)::set(this,\"*\",\"rgm\", rgm);\n    endfunction\n\n    function void connect_phase(uvm_phase phase);\n      chnl_agts[i].monitor.mon_ana_port.connect(chker.chnl_tlm_fifos[i].analysis_export);\n      rgm.map.set_sequencer(reg_agt.sequencer, adapter);\n      predictor.map = rgm.map;\n      predictor.adapter = adapter;\n    endfunction",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class mcdf_env extends uvm_env;\n    chnl_agent chnl_agts[4];\n    mcdf_virtual_sequencer virt_sqr;\n    mcdf_rgm rgm;\n    reg2mcdf_adapter adapter;\n\n    function void build_phase(uvm_phase phase);\n      rgm = mcdf_rgm::type_id::create(\"rgm\", this);\n      rgm.build();\n      uvm_config_db#(mcdf_rgm)::set(this,\"*\",\"rgm\", rgm);\n    endfunction\n\n    function void connect_phase(uvm_phase phase);\n      chnl_agts[i].monitor.mon_ana_port.connect(chker.chnl_tlm_fifos[i].analysis_export);\n      rgm.map.set_sequencer(reg_agt.sequencer, adapter);\n      predictor.map = rgm.map;\n      predictor.adapter = adapter;\n    endfunction",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
