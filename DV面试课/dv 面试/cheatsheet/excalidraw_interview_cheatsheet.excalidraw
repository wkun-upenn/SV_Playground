    {
      "id": "VL84NY32wd9wUeDPBgOoy",
      "type": "text",
      "x": 952.0595238095239,
      "y": -657.1804174998447,
      "width": 869,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Uz",
      "roundness": null,
      "seed": 355498590,
      "version": 63,
      "versionNonce": 272467586,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731601273095,
      "link": null,
      "locked": false,
      "text": "    int write_file, read_file;\n    int data_out;\n    int read_status;\n\n    write_file = $fopen(\"data.txt\", \"w\");\n    if (write_file == 0) begin\n        $display(\"ERROR: Could not open file for writing.\");\n        $finish;\n    end\n    $fdisplay(write_file, \"Data written to file:\");\n    $fclose(write_file);\n\n    read_file = $fopen(\"data.txt\", \"r\");\n    if (read_file == 0) begin\n        $display(\"ERROR: Could not open file for reading.\");\n        $finish;\n    end\n\n    while (!$feof(read_file)) begin\n        read_status = $fscanf(read_file, \"Value %d: %d\\n\", data_out, data_out);\n        $display(\"Read: %d\", data_out);\n    end\n\n    $fclose(read_file);",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    int write_file, read_file;\n    int data_out;\n    int read_status;\n\n    write_file = $fopen(\"data.txt\", \"w\");\n    if (write_file == 0) begin\n        $display(\"ERROR: Could not open file for writing.\");\n        $finish;\n    end\n    $fdisplay(write_file, \"Data written to file:\");\n    $fclose(write_file);\n\n    read_file = $fopen(\"data.txt\", \"r\");\n    if (read_file == 0) begin\n        $display(\"ERROR: Could not open file for reading.\");\n        $finish;\n    end\n\n    while (!$feof(read_file)) begin\n        read_status = $fscanf(read_file, \"Value %d: %d\\n\", data_out, data_out);\n        $display(\"Read: %d\", data_out);\n    end\n\n    $fclose(read_file);",
      "autoResize": true,
      "lineHeight": 1.25
    },
