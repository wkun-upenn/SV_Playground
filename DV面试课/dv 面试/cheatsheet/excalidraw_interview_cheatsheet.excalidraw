      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "uvm_test   \nuvm_config_db#(uvm_object_wrapper)::set(this,                           \n                                           \"env.i_agt.sqr.main_phase\",     \n                                           \"default_sequence\",             \n                                           case0_sequence::type_id::get());\n\n\ninterface smartisan_if(input logic clk, input logic reset);\n        logic[MAX_WIDTH  - 1] req_data;\n        logic                                  req_valid;\n        logic                 req_stall;\n\n\n        clocking send_req_cb @(posedge clk);\n                default input #1step output #1ps;\n                output req_data;\n                output req_valid;\n                input  req_stall;\n        endclocking\n\n    modport send_req_mp   (clocking send_req_cb,   input rst);\nendinterface",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uvm_test   \nuvm_config_db#(uvm_object_wrapper)::set(this,                           \n                                           \"env.i_agt.sqr.main_phase\",     \n                                           \"default_sequence\",             \n                                           case0_sequence::type_id::get());\n\n\ninterface smartisan_if(input logic clk, input logic reset);\n        logic[MAX_WIDTH  - 1] req_data;\n        logic                                  req_valid;\n        logic                 req_stall;\n\n\n        clocking send_req_cb @(posedge clk);\n                default input #1step output #1ps;\n                output req_data;\n                output req_valid;\n                input  req_stall;\n        endclocking\n\n    modport send_req_mp   (clocking send_req_cb,   input rst);\nendinterface",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
