      "updated": 1731028084505,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "class my_scoreboard extends uvm_scoreboard;\n        my_reference_block reference_block;\n        mcdf_rgm rgm;\n\n        uvm_tlm_analysis_fifo #(fmt_trans)   refer_data_in_fifo;\n        uvm_tlm_analysis_fifo #(fmt_trans)   real_data_in_fifo;\n        uvm_blocking_get_port #(fmt_trans)   refer_data_out_port;\n\n        `uvm_component_utils(my_scoreboard)\n\n        function new(string name = \"checker\", uvm_component parent);\n                real_data_fifo = new(\"real_data_fifo\", this);\n                refer_data_in_fifo = new(\"refer_data_in_fifo\", this);\n                refer_data_out_port = new(\"refer_data_out_port\", this);\n        endfunction\n\n        function void connect_phase(uvm_phase phase);\n                refmod.input_port.connect(refer_data_in_fifo.blocking_get_peek_export);\n                refer_data_out_port.connect(refmod.output_data_fifo.blocking_get_export);\n        endfunction\n\n        task run_phase(uvm_phase phase);\n                data_compare();\n        endtask\n\n        task data_compare();\n                transaction expt, mont;\n                forever begin\n                        this.real_data_in_fifo.get(mont);\n                        this.refer_data_out_port.get(expt);\n                        comp = mont.comp(expt);\n                end\n        endtask\n\nendclass\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class my_scoreboard extends uvm_scoreboard;\n        my_reference_block reference_block;\n        mcdf_rgm rgm;\n\n        uvm_tlm_analysis_fifo #(fmt_trans)   refer_data_in_fifo;\n        uvm_tlm_analysis_fifo #(fmt_trans)   real_data_in_fifo;\n        uvm_blocking_get_port #(fmt_trans)   refer_data_out_port;\n\n        `uvm_component_utils(my_scoreboard)\n\n        function new(string name = \"checker\", uvm_component parent);\n                real_data_fifo = new(\"real_data_fifo\", this);\n                refer_data_in_fifo = new(\"refer_data_in_fifo\", this);\n                refer_data_out_port = new(\"refer_data_out_port\", this);\n        endfunction\n\n        function void connect_phase(uvm_phase phase);\n                refmod.input_port.connect(refer_data_in_fifo.blocking_get_peek_export);\n                refer_data_out_port.connect(refmod.output_data_fifo.blocking_get_export);\n        endfunction\n\n        task run_phase(uvm_phase phase);\n                data_compare();\n        endtask\n\n        task data_compare();\n                transaction expt, mont;\n                forever begin\n                        this.real_data_in_fifo.get(mont);\n                        this.refer_data_out_port.get(expt);\n                        comp = mont.comp(expt);\n                end\n        endtask\n\nendclass\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
