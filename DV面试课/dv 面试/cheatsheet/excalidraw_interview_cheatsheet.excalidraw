      "boundElements": [],
      "updated": 1727366865545,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "    Packet pkt ;\n    BadPacket badPkt1, badPkt2;\n    badPkt1 = new(1);\n    pkt = badPkt1;                         \n    //子类->父类\n    //对于属性的访问，使用什么类型的句柄就访问的是哪个class中的属性\n    //对于方法的访问，如果使用了 virtual 父类句柄使用的是子类方法，否则访问的是父类方法\n    void'($cast(badPkt2, pkt));       \n    //父类->子类(父类保证实质上是一个子类)\n    pkt.compute_crc();\n    badPkt2.compute_crc();\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    Packet pkt ;\n    BadPacket badPkt1, badPkt2;\n    badPkt1 = new(1);\n    pkt = badPkt1;                         \n    //子类->父类\n    //对于属性的访问，使用什么类型的句柄就访问的是哪个class中的属性\n    //对于方法的访问，如果使用了 virtual 父类句柄使用的是子类方法，否则访问的是父类方法\n    void'($cast(badPkt2, pkt));       \n    //父类->子类(父类保证实质上是一个子类)\n    pkt.compute_crc();\n    badPkt2.compute_crc();\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 359,
      "versionNonce": 872387771,
      "index": "c0SL",
      "isDeleted": false,
      "id": "oRuJx-dG7Q1Xruyrp8aOr",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 109.91666666666703,
      "y": 633.7945038326205,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 847,
      "height": 1650,
      "seed": 229680160,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1731522826107,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "assert property(p_name); else $display(\"fail\");\n\nsequence seq2(a, b, c);\n   a ##1 b ##1 c;\nendsequence\n\nproperty name;\n@(posedge clk) disable iff(condition)  A |-> ##0 B;\n@(posedge clk) A |=> B;\n//多条件时候使用: &，｜， !   多个序列之间使用：and, or, not\n@(posedge clk) A |-> ##[1:3] B;\n@(posedge clk) A[*1:2] |-> B; \n@(posedge clk) A |=> B[->1:2] |=> C;                                   \n//A #1 -> ... -> B ... -> B -> C\n@(posedge clk) A |=> B[=1:2] |=> C;                                    \n//A #1 -> ... -> B ... -> B -> ... -> C\n@(posedge clk) $rose(A)/$fell(A) |-> B;\n$onehot(A);\n$onehot0(A);\n$countones(A)\n$isunknown({A, B}); \n@(posedge clk) A |-> B and C;                                          \n//B和C同时开始，以其中最后一个完成的作为触发事件；若B，C多次触发，最终结果多次触发\n@(posedge clk) A |-> B intersect C;                                    \n//B和C同时开始，同时结束作为触发条件\n@(posedge clk) A |-> B or C;                                           \n//B和C同时开始，任意一个结束作为触发条件\n@(posedge clk) first_match(A |-> B) |-> C;                             \n//use sequence as parameter and only used in the LHS\n@(posedge clk) $rose(A) |=> (B[*5] within !C[->1]);                    \n//C 长于 B\n@(posedge clk) $rose(A) |=> (B throughout C[*5]);                      \n//B 长于 C, B 不能是 sequence\n@(posedge clk) $rose(C) |-> sequence(param1,param2).ended();           \n//使用ended()的序列前不能有表达式操作符\n\n\nsequence check_rd_adr;\n  ((rd_addr == $past (rd_addr+1)) && read)[*0:$] ##1 $fell (read);\nendsequence \n//rd_addr is incremented by one \n\nproperty checkCounter;\n  int LCount;\n  @(posedge clk) disable iff (lrst_n)\n  (\n    ($rose(startCount), LCount=initCount) ##1\n    (1, LCount = LCount + 1)[*0:$] ##1 (LCount == maxCount) |-> \n    (Intr == 1'b1))；\n  );\nendproperty\n\n\n!req |-> !ack;\n\n(!req || ack) ##1 req |-> (req && !ack)[*0:100] ## ack;\n\n$rose(ack) |-> ack[*0:100] ##1 (!ack);\n\n$rose(ack) && req |=> !req;\n\n!(isunknown(req));\n\n$stable(value) |-> (val < $past(val) ? \n                        ($past(val) - val == value) : \n                        ($past(val) + ({width{1'b1}} - value + 1 == value)));",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "assert property(p_name); else $display(\"fail\");\n\nsequence seq2(a, b, c);\n   a ##1 b ##1 c;\nendsequence\n\nproperty name;\n@(posedge clk) disable iff(condition)  A |-> ##0 B;\n@(posedge clk) A |=> B;\n//多条件时候使用: &，｜， !   多个序列之间使用：and, or, not\n@(posedge clk) A |-> ##[1:3] B;\n@(posedge clk) A[*1:2] |-> B; \n@(posedge clk) A |=> B[->1:2] |=> C;                                   \n//A #1 -> ... -> B ... -> B -> C\n@(posedge clk) A |=> B[=1:2] |=> C;                                    \n//A #1 -> ... -> B ... -> B -> ... -> C\n@(posedge clk) $rose(A)/$fell(A) |-> B;\n$onehot(A);\n$onehot0(A);\n$countones(A)\n$isunknown({A, B}); \n@(posedge clk) A |-> B and C;                                          \n//B和C同时开始，以其中最后一个完成的作为触发事件；若B，C多次触发，最终结果多次触发\n@(posedge clk) A |-> B intersect C;                                    \n//B和C同时开始，同时结束作为触发条件\n@(posedge clk) A |-> B or C;                                           \n//B和C同时开始，任意一个结束作为触发条件\n@(posedge clk) first_match(A |-> B) |-> C;                             \n//use sequence as parameter and only used in the LHS\n@(posedge clk) $rose(A) |=> (B[*5] within !C[->1]);                    \n//C 长于 B\n@(posedge clk) $rose(A) |=> (B throughout C[*5]);                      \n//B 长于 C, B 不能是 sequence\n@(posedge clk) $rose(C) |-> sequence(param1,param2).ended();           \n//使用ended()的序列前不能有表达式操作符\n\n\nsequence check_rd_adr;\n  ((rd_addr == $past (rd_addr+1)) && read)[*0:$] ##1 $fell (read);\nendsequence \n//rd_addr is incremented by one \n\nproperty checkCounter;\n  int LCount;\n  @(posedge clk) disable iff (lrst_n)\n  (\n    ($rose(startCount), LCount=initCount) ##1\n    (1, LCount = LCount + 1)[*0:$] ##1 (LCount == maxCount) |-> \n    (Intr == 1'b1))；\n  );\nendproperty\n\n\n!req |-> !ack;\n\n(!req || ack) ##1 req |-> (req && !ack)[*0:100] ## ack;\n\n$rose(ack) |-> ack[*0:100] ##1 (!ack);\n\n$rose(ack) && req |=> !req;\n\n!(isunknown(req));\n\n$stable(value) |-> (val < $past(val) ? \n                        ($past(val) - val == value) : \n                        ($past(val) + ({width{1'b1}} - value + 1 == value)));",
      "autoResize": true,
      "lineHeight": 1.25
    },
