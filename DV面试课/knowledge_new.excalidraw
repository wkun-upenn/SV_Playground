    {
      "id": "FtXvsIN8CjRBC9nZm0i9G",
      "type": "text",
      "x": -7153.89866186568,
      "y": 6889.147435051191,
      "width": 835.9777221679691,
      "height": 783.7499999999992,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0dJ",
      "roundness": null,
      "seed": 376980984,
      "version": 559,
      "versionNonce": 740158602,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776731192885,
      "link": null,
      "locked": false,
      "text": "\nint pos = 0;\n\nfunction int pred(int req);\n   \n\n    if(req == 0) return pos;\n\n    for(int I = pos + 1; I < 32; I += 1) begin\n        if(req >> I & 1 == 1) begin\n            pos = I;\n            return pos;\n        end\n\n    for(int I = 0; I <= pos; I += 1)\n        if(req >> I & 1 == 1) begin\n            pos = I;\n            return pos;\n        end",
      "fontSize": 32.999999999999964,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nint pos = 0;\n\nfunction int pred(int req);\n   \n\n    if(req == 0) return pos;\n\n    for(int I = pos + 1; I < 32; I += 1) begin\n        if(req >> I & 1 == 1) begin\n            pos = I;\n            return pos;\n        end\n\n    for(int I = 0; I <= pos; I += 1)\n        if(req >> I & 1 == 1) begin\n            pos = I;\n            return pos;\n        end",
      "autoResize": false,
      "lineHeight": 1.25
    },
