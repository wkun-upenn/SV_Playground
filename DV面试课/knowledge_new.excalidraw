      "seed": 1434540260,
      "version": 38,
      "versionNonce": 412931888,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774238883074,
      "link": null,
      "locked": false,
      "text": "leetcode 01: 两数之和（哈希表）\nleetcode 20: 有效括号（栈思想）\nleetcode 190: 反转 32 bit 整数的每一位\nleetcode 509: 斐波那契数列\nleetcode 88: 合并两个有序数组\nleetcode 231: 2 的幂\nleetcode 338: 比特位计数\nleetcode 899: 有序队列\nleetcode 225: 用队列实现栈\nleetcode 7: 整数反转",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "leetcode 01: 两数之和（哈希表）\nleetcode 20: 有效括号（栈思想）\nleetcode 190: 反转 32 bit 整数的每一位\nleetcode 509: 斐波那契数列\nleetcode 88: 合并两个有序数组\nleetcode 231: 2 的幂\nleetcode 338: 比特位计数\nleetcode 899: 有序队列\nleetcode 225: 用队列实现栈\nleetcode 7: 整数反转",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QOqREjCByLP0a3goiUIIG",
      "type": "text",
      "x": 1824.4330893601057,
      "y": 118.90469877768726,
      "width": 297.4439697265625,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0We",
      "roundness": null,
      "seed": 643461476,
      "version": 99,
      "versionNonce": 1362533614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772083052331,
      "link": null,
      "locked": false,
      "text": "\n\n\nfile = \"\"\nwith open(file, 'r') as f:\n  for line in f.readlines():\n    line.strip()\n\nsplit() find() count()\n",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\nfile = \"\"\nwith open(file, 'r') as f:\n  for line in f.readlines():\n    line.strip()\n\nsplit() find() count()\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
