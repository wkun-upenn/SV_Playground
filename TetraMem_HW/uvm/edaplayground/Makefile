# =====================================================================
# Makefile - This is generated by Claude AI to copy over the file tree
#            to update with edaplayground for convenient copying.
# =====================================================================
RTL := ../rtl
TB  := ../tb

# files this Makefile must never overwrite or delete (EDA-Playground-only)
KEEP := design.sv testbench.sv

.DEFAULT_GOAL := copy
.PHONY: copy list clean help

copy:
	@find $(RTL) $(TB) -type f \( -name '*.sv' -o -name '*.svh' \) \
	    ! -name design.sv ! -name testbench.sv \
	    -exec cp {} . \;
	@echo "Synced grain files from $(RTL) and $(TB)."
	@echo "Includers kept: $(KEEP)"

list:
	@ls -1 *.sv *.svh 2>/dev/null

# remove copied grain files but keep the includers, docs and this Makefile
clean:
	@find . -maxdepth 1 -type f \( -name '*.sv' -o -name '*.svh' \) \
	    ! -name design.sv ! -name testbench.sv -delete
	@echo "Removed grain files (kept $(KEEP), HOW_TO_RUN.md, Makefile)."

help:
	@echo "make copy   - refresh flat grain files from ../rtl and ../tb"
	@echo "make list   - list the flat files"
	@echo "make clean  - remove grain files (keep includers + docs)"
