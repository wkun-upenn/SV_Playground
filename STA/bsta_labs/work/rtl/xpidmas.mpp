
//mpp <clock=XpiCoreClk, reset=GlCoreResetR00C>

`include "xpiuc.vh"

module xpidmas (/*AUTOARG*/
   // Outputs
   XpiDmaPciArbReqPsn13S, XpiDmaPciTxnIDPsn13S, 
   XpiDmaPciAddrIrdyPsn13S, XpiDmaPciAddrPsn13S, 
   XpiDmaPciDataIrdyPsn13S, XpiDmaPciDataPsn13S, XpiDmaPciCmdPsn13S, 
   XpiDmaPciAttrPsn13S, XpiDmaPciByteEnPsn13S, XpiDmaPciLengthPsn13S, 
   XpiDmaPciTrdyPsn13S, XpiDmaPciIntrPsn13S, XpiDmaRbArbReqPns13S, 
   XpiDmaRbIrdyPns13S, XpiDmaRbAddrPns13S, XpiDmaRbCmdPns13S, 
   XpiDmaRbDataLenPns13S, XpiDmaRbTxnIDPns13S, XpiDmaRbTrdyPns13S, 
   // Inputs
   XpiPciClk, XpiCoreClk, GlCoreResetR00C, XpiPciAppDmaFreq133P11S, 
   XpiPciAppDmaFreq66P11S, XpiPciAppDmaFreq33P11S, 
   XpiPciAppDmaAddrIrdyP11S, XpiPciAppDmaAddrP11S, 
   XpiPciAppDmaCmdP11S, XpiPciAppDmaAttrP11S, XpiPciAppDmaByteEnP11S, 
   XpiPciAppDmaLengthP11S, XpiPciAppDmaDataIrdyP11S, 
   XpiPciAppDmaDataP11S, XpiPciAppDmaTrdyP10S, XpiPciAppDmaTrdyP11S, 
   XpiPciAppDmaValidTxnP11S, XpiPciAppDmaRdStopP11S, 
   XpiPciArbDmaBusyP11S, XpiPciArbDmaStopP11S, XpiPciArbDmaSrvP11S, 
   XpiPciArbDmaReqAbortP11S, XpiPciArbDmaSplitAbortP11S, 
   XpiRbiDmaGntPsn11S, XpiRbiDmaStopPsn11S, XpiRbiDmaIrdyPsn11S, 
   XpiRbiDmaCmdPsn11S, XpiRbiDmaDataPsn11S, XpiRbiDmaTrdyPsn11S, 
   XpiRbiDmaValidXfrPsn11S
   );

  parameter [2:0] TXNID = 3'b000;

  //-------------------------------------
  //--------  Interface Signals  --------
  //-------------------------------------
  
  //---- Global Signals ----

  input                           XpiPciClk;
  input 			  XpiCoreClk;
  input 			  GlCoreResetR00C;
  
  //---- DMA - PCI-X Interface Signals ----
  input 			  XpiPciAppDmaFreq133P11S;
