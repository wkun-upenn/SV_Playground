  input 			  XpiPciAppDmaFreq33P11S;
  input 			  XpiPciAppDmaAddrIrdyP11S;
  input [`PCI_ADDR_WIDTH-1:0] 	  XpiPciAppDmaAddrP11S;
  input [3:0] 			  XpiPciAppDmaCmdP11S;
  input [`PCI_ATTR_WIDTH-1:0] 	  XpiPciAppDmaAttrP11S;
  input [7:0] 			  XpiPciAppDmaByteEnP11S;
  input [`RQ_BYTECNT_WIDTH-1:0]   XpiPciAppDmaLengthP11S;
  input 			  XpiPciAppDmaDataIrdyP11S;
  input [`PCI_DATA_WIDTH-1:0] 	  XpiPciAppDmaDataP11S;
  input 			  XpiPciAppDmaTrdyP10S;
  input 			  XpiPciAppDmaTrdyP11S;
  input 			  XpiPciAppDmaValidTxnP11S;
  input 			  XpiPciAppDmaRdStopP11S;
  
  input 			  XpiPciArbDmaBusyP11S;
  input 			  XpiPciArbDmaStopP11S;
  input 			  XpiPciArbDmaSrvP11S;
  input 			  XpiPciArbDmaReqAbortP11S;
  input 			  XpiPciArbDmaSplitAbortP11S;
  
  output 			  XpiDmaPciArbReqPsn13S;
  output [2:0] 			  XpiDmaPciTxnIDPsn13S;
  output 			  XpiDmaPciAddrIrdyPsn13S;
  output [`PCI_ADDR_WIDTH-1:0] 	  XpiDmaPciAddrPsn13S;
  output 			  XpiDmaPciDataIrdyPsn13S;
  output [`PCI_DATA_WIDTH-1:0] 	  XpiDmaPciDataPsn13S;
  output [3:0] 			  XpiDmaPciCmdPsn13S;
  output [`PCI_ATTR_WIDTH-1:0] 	  XpiDmaPciAttrPsn13S;
  output [7:0] 			  XpiDmaPciByteEnPsn13S;
  output [`BYTECNT_WIDTH-1:0] 	  XpiDmaPciLengthPsn13S;
  output 			  XpiDmaPciTrdyPsn13S;
  output [`DMA_INTR_EVENTS-1:0]   XpiDmaPciIntrPsn13S;
  
  
