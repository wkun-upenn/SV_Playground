  reg [1:0] 			XpiGilGrpXMuxSelP14C;

  reg [`GIL_DATA_WIDTH-1:0] 	XpiGilPciDataP11C;
  reg 				XpiGilNewIntrEventP12C;
  reg 				XpiGilAssertCntEnP10C;
  reg [3:0] 			XpiGilAssertCntP10C;

  
  //=========================
  //==== CORE CLK DOMAIN ====
  //=========================

  
  //--------------------------------------------------
  //---- Edge Detect of Incoming Interrupt Events ----
  //--------------------------------------------------

DFFR #(256,256'b0) U1_dff (.q(XpiGilIntrEventsP11S),.d(XpiGilIntrEventsP10S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  // Splitting 256b into 8x32b bus
  assign XpiGilGrpAIntrEventsP11C = XpiGilIntrEventsP11S[31:0];
  assign XpiGilGrpBIntrEventsP11C = XpiGilIntrEventsP11S[63:32];
  assign XpiGilGrpCIntrEventsP11C = XpiGilIntrEventsP11S[95:64];
  assign XpiGilGrpDIntrEventsP11C = XpiGilIntrEventsP11S[127:96];
  assign XpiGilGrpEIntrEventsP11C = XpiGilIntrEventsP11S[159:128];
  assign XpiGilGrpFIntrEventsP11C = XpiGilIntrEventsP11S[191:160];
  assign XpiGilGrpGIntrEventsP11C = XpiGilIntrEventsP11S[223:192];
  assign XpiGilGrpHIntrEventsP11C = XpiGilIntrEventsP11S[`GIL_INTR_EVENTS-1:224];

  // Resetting the Pulse Detect Logic during ISR Clearing Operation
  // This will catch a situation where software thinks it has corrected the
  // underlying reason of previous interrupt, however the Unit Interrput
  // Pulse is still active indicating that interrupt condition is not cleared

  // NANDing Write Clear Pulse with Data
  
  assign XpiGilGrpAWrClrEnP14C = (~({32{XpiGilGrpAISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpBWrClrEnP14C = (~({32{XpiGilGrpBISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpCWrClrEnP14C = (~({32{XpiGilGrpCISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpDWrClrEnP14C = (~({32{XpiGilGrpDISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpEWrClrEnP14C = (~({32{XpiGilGrpEISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpFWrClrEnP14C = (~({32{XpiGilGrpFISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpGWrClrEnP14C = (~({32{XpiGilGrpGISRWrP14S}} & XpiGilWrClrDataP14S));
  assign XpiGilGrpHWrClrEnP14C = (~({32{XpiGilGrpHISRWrP14S}} & XpiGilWrClrDataP14S));

  // ANDing Interrupt Pulse with Write Clear Data

  assign XpiGilGrpAIntrEventsP12C = (XpiGilGrpAIntrEventsP11C & XpiGilGrpAWrClrEnP14C);
  assign XpiGilGrpBIntrEventsP12C = (XpiGilGrpBIntrEventsP11C & XpiGilGrpBWrClrEnP14C);
  assign XpiGilGrpCIntrEventsP12C = (XpiGilGrpCIntrEventsP11C & XpiGilGrpCWrClrEnP14C);
  assign XpiGilGrpDIntrEventsP12C = (XpiGilGrpDIntrEventsP11C & XpiGilGrpDWrClrEnP14C);
  assign XpiGilGrpEIntrEventsP12C = (XpiGilGrpEIntrEventsP11C & XpiGilGrpEWrClrEnP14C);
  assign XpiGilGrpFIntrEventsP12C = (XpiGilGrpFIntrEventsP11C & XpiGilGrpFWrClrEnP14C);
  assign XpiGilGrpGIntrEventsP12C = (XpiGilGrpGIntrEventsP11C & XpiGilGrpGWrClrEnP14C);
  assign XpiGilGrpHIntrEventsP12C = (XpiGilGrpHIntrEventsP11C & XpiGilGrpHWrClrEnP14C);

  // Pulse Generation Logic, Second Stage Flop

DFFR #(32,32'b0) U2_dff (.q(XpiGilGrpAIntrEventsP12S),.d(XpiGilGrpAIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U3_dff (.q(XpiGilGrpBIntrEventsP12S),.d(XpiGilGrpBIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U4_dff (.q(XpiGilGrpCIntrEventsP12S),.d(XpiGilGrpCIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U5_dff (.q(XpiGilGrpDIntrEventsP12S),.d(XpiGilGrpDIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U6_dff (.q(XpiGilGrpEIntrEventsP12S),.d(XpiGilGrpEIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U7_dff (.q(XpiGilGrpFIntrEventsP12S),.d(XpiGilGrpFIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U8_dff (.q(XpiGilGrpGIntrEventsP12S),.d(XpiGilGrpGIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U9_dff (.q(XpiGilGrpHIntrEventsP12S),.d(XpiGilGrpHIntrEventsP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
  // Pulse Generation

  assign XpiGilGrpAIntrEventsP13C = (XpiGilGrpAIntrEventsP11C & (~XpiGilGrpAIntrEventsP12S));
  assign XpiGilGrpBIntrEventsP13C = (XpiGilGrpBIntrEventsP11C & (~XpiGilGrpBIntrEventsP12S));
  assign XpiGilGrpCIntrEventsP13C = (XpiGilGrpCIntrEventsP11C & (~XpiGilGrpCIntrEventsP12S));
  assign XpiGilGrpDIntrEventsP13C = (XpiGilGrpDIntrEventsP11C & (~XpiGilGrpDIntrEventsP12S));
  assign XpiGilGrpEIntrEventsP13C = (XpiGilGrpEIntrEventsP11C & (~XpiGilGrpEIntrEventsP12S));
  assign XpiGilGrpFIntrEventsP13C = (XpiGilGrpFIntrEventsP11C & (~XpiGilGrpFIntrEventsP12S));
  assign XpiGilGrpGIntrEventsP13C = (XpiGilGrpGIntrEventsP11C & (~XpiGilGrpGIntrEventsP12S));
  assign XpiGilGrpHIntrEventsP13C = (XpiGilGrpHIntrEventsP11C & (~XpiGilGrpHIntrEventsP12S));
  
  // BitWise OR to Detect a New Event Occurrence
  
  assign XpiGilGrpANewIntrEventP11C = (|XpiGilGrpAIntrEventsP13C);
  assign XpiGilGrpBNewIntrEventP11C = (|XpiGilGrpBIntrEventsP13C);
  assign XpiGilGrpCNewIntrEventP11C = (|XpiGilGrpCIntrEventsP13C);
  assign XpiGilGrpDNewIntrEventP11C = (|XpiGilGrpDIntrEventsP13C);
  assign XpiGilGrpENewIntrEventP11C = (|XpiGilGrpEIntrEventsP13C);
  assign XpiGilGrpFNewIntrEventP11C = (|XpiGilGrpFIntrEventsP13C);
  assign XpiGilGrpGNewIntrEventP11C = (|XpiGilGrpGIntrEventsP13C);
  assign XpiGilGrpHNewIntrEventP11C = (|XpiGilGrpHIntrEventsP13C);
  
  //------------------------------------------------
  //---- Interrupt Status Register Update Logic ----
  //------------------------------------------------

  // BitWise OR of ISR Contents and New Event
  assign XpiGilGrpANewEventDataP11C = (XpiGilGrpAISRP11S | XpiGilGrpAIntrEventsP13C);
  assign XpiGilGrpBNewEventDataP11C = (XpiGilGrpBISRP11S | XpiGilGrpBIntrEventsP13C);
  assign XpiGilGrpCNewEventDataP11C = (XpiGilGrpCISRP11S | XpiGilGrpCIntrEventsP13C);
  assign XpiGilGrpDNewEventDataP11C = (XpiGilGrpDISRP11S | XpiGilGrpDIntrEventsP13C);
  assign XpiGilGrpENewEventDataP11C = (XpiGilGrpEISRP11S | XpiGilGrpEIntrEventsP13C);
  assign XpiGilGrpFNewEventDataP11C = (XpiGilGrpFISRP11S | XpiGilGrpFIntrEventsP13C);
  assign XpiGilGrpGNewEventDataP11C = (XpiGilGrpGISRP11S | XpiGilGrpGIntrEventsP13C);
  assign XpiGilGrpHNewEventDataP11C = (XpiGilGrpHISRP11S | XpiGilGrpHIntrEventsP13C);

  // BitWise XOR of ISR Contents and Write Clear Data
  assign XpiGilGrpAWrClrDataP14C = (XpiGilGrpAISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpBWrClrDataP14C = (XpiGilGrpBISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpCWrClrDataP14C = (XpiGilGrpCISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpDWrClrDataP14C = (XpiGilGrpDISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpEWrClrDataP14C = (XpiGilGrpEISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpFWrClrDataP14C = (XpiGilGrpFISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpGWrClrDataP14C = (XpiGilGrpGISRP11S ^ XpiGilWrClrDataP14S);
  assign XpiGilGrpHWrClrDataP14C = (XpiGilGrpHISRP11S ^ XpiGilWrClrDataP14S);

  //---- Mux Select Logic ----

  always @(/*AS*/XpiGilGrpAISRWrP14S or XpiGilGrpANewIntrEventP11C)
    begin
      if (XpiGilGrpANewIntrEventP11C)
	XpiGilGrpAMuxSelP11C = 2'b01;
      else if (XpiGilGrpAISRWrP14S)
	XpiGilGrpAMuxSelP11C = 2'b10;
      else
	XpiGilGrpAMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpBISRWrP14S or XpiGilGrpBNewIntrEventP11C)
    begin
      if (XpiGilGrpBNewIntrEventP11C)
	XpiGilGrpBMuxSelP11C = 2'b01;
      else if (XpiGilGrpBISRWrP14S)
	XpiGilGrpBMuxSelP11C = 2'b10;
      else
	XpiGilGrpBMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpCISRWrP14S or XpiGilGrpCNewIntrEventP11C)
    begin
      if (XpiGilGrpCNewIntrEventP11C)
	XpiGilGrpCMuxSelP11C = 2'b01;
      else if (XpiGilGrpCISRWrP14S)
	XpiGilGrpCMuxSelP11C = 2'b10;
      else
	XpiGilGrpCMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpDISRWrP14S or XpiGilGrpDNewIntrEventP11C)
    begin
      if (XpiGilGrpDNewIntrEventP11C)
	XpiGilGrpDMuxSelP11C = 2'b01;
      else if (XpiGilGrpDISRWrP14S)
	XpiGilGrpDMuxSelP11C = 2'b10;
      else
	XpiGilGrpDMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpEISRWrP14S or XpiGilGrpENewIntrEventP11C)
    begin
      if (XpiGilGrpENewIntrEventP11C)
	XpiGilGrpEMuxSelP11C = 2'b01;
      else if (XpiGilGrpEISRWrP14S)
	XpiGilGrpEMuxSelP11C = 2'b10;
      else
	XpiGilGrpEMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpFISRWrP14S or XpiGilGrpFNewIntrEventP11C)
    begin
      if (XpiGilGrpFNewIntrEventP11C)
	XpiGilGrpFMuxSelP11C = 2'b01;
      else if (XpiGilGrpFISRWrP14S)
	XpiGilGrpFMuxSelP11C = 2'b10;
      else
	XpiGilGrpFMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpGISRWrP14S or XpiGilGrpGNewIntrEventP11C)
    begin
      if (XpiGilGrpGNewIntrEventP11C)
	XpiGilGrpGMuxSelP11C = 2'b01;
      else if (XpiGilGrpGISRWrP14S)
	XpiGilGrpGMuxSelP11C = 2'b10;
      else
	XpiGilGrpGMuxSelP11C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpHISRWrP14S or XpiGilGrpHNewIntrEventP11C)
    begin
      if (XpiGilGrpHNewIntrEventP11C)
	XpiGilGrpHMuxSelP11C = 2'b01;
      else if (XpiGilGrpHISRWrP14S)
	XpiGilGrpHMuxSelP11C = 2'b10;
      else
	XpiGilGrpHMuxSelP11C = 2'b00;
    end
  
  //---- ISR Register Set ----

MUX4S2 #(32) U10_mux4 (.mo(XpiGilGrpAISRP11C),.in0(XpiGilGrpAISRP11S),.in1(XpiGilGrpANewEventDataP11C),.in2(XpiGilGrpAWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpAMuxSelP11C));



DFFR #(32,32'b0) U11_dff (.q(XpiGilGrpAISRP11S),.d(XpiGilGrpAISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U12_mux4 (.mo(XpiGilGrpBISRP11C),.in0(XpiGilGrpBISRP11S),.in1(XpiGilGrpBNewEventDataP11C),.in2(XpiGilGrpBWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpBMuxSelP11C));



DFFR #(32,32'b0) U13_dff (.q(XpiGilGrpBISRP11S),.d(XpiGilGrpBISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

MUX4S2 #(32) U14_mux4 (.mo(XpiGilGrpCISRP11C),.in0(XpiGilGrpCISRP11S),.in1(XpiGilGrpCNewEventDataP11C),.in2(XpiGilGrpCWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpCMuxSelP11C));



DFFR #(32,32'b0) U15_dff (.q(XpiGilGrpCISRP11S),.d(XpiGilGrpCISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

MUX4S2 #(32) U16_mux4 (.mo(XpiGilGrpDISRP11C),.in0(XpiGilGrpDISRP11S),.in1(XpiGilGrpDNewEventDataP11C),.in2(XpiGilGrpDWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpDMuxSelP11C));



DFFR #(32,32'b0) U17_dff (.q(XpiGilGrpDISRP11S),.d(XpiGilGrpDISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

MUX4S2 #(32) U18_mux4 (.mo(XpiGilGrpEISRP11C),.in0(XpiGilGrpEISRP11S),.in1(XpiGilGrpENewEventDataP11C),.in2(XpiGilGrpEWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpEMuxSelP11C));


  
DFFR #(32,32'b0) U19_dff (.q(XpiGilGrpEISRP11S),.d(XpiGilGrpEISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U20_mux4 (.mo(XpiGilGrpFISRP11C),.in0(XpiGilGrpFISRP11S),.in1(XpiGilGrpFNewEventDataP11C),.in2(XpiGilGrpFWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpFMuxSelP11C));



DFFR #(32,32'b0) U21_dff (.q(XpiGilGrpFISRP11S),.d(XpiGilGrpFISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

MUX4S2 #(32) U22_mux4 (.mo(XpiGilGrpGISRP11C),.in0(XpiGilGrpGISRP11S),.in1(XpiGilGrpGNewEventDataP11C),.in2(XpiGilGrpGWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpGMuxSelP11C));



DFFR #(32,32'b0) U23_dff (.q(XpiGilGrpGISRP11S),.d(XpiGilGrpGISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

MUX4S2 #(32) U24_mux4 (.mo(XpiGilGrpHISRP11C),.in0(XpiGilGrpHISRP11S),.in1(XpiGilGrpHNewEventDataP11C),.in2(XpiGilGrpHWrClrDataP14C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpHMuxSelP11C));



DFFR #(32,32'b0) U25_dff (.q(XpiGilGrpHISRP11S),.d(XpiGilGrpHISRP11C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  //==========================
  //==== PCI CLOCK DOMAIN ====
  //==========================
  
  //mpp <clock=XpiPciClk, reset=GlCoreResetR00C>

  //-----------------------------------------------------
  //--- Edge Detect of DMA, RX or TX Interrupt Event ----
  //-----------------------------------------------------
  
  assign XpiGilDRTIntrEventsP13C = 
	 {XpiPciAppIntrP11S, XpiPktTxPciIntrPsn13S, XpiPktRxPciIntrPsn13S, 
	  XpiDescDmaPciIntrPsn13S, XpiDma1PciIntrPsn13S, XpiDma0PciIntrPsn13S};
  
DFFR #(32,32'b0) U26_dff (.q(XpiGilDRTIntrEventsP13S),.d(XpiGilDRTIntrEventsP13C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiGilDRTIntrEventsP14C = (XpiGilDRTIntrEventsP13C &
				    (~XpiGilDRTIntrEventsP13S));
  
  // Reduction OR to detect occurence of New Interrupt Event
  assign XpiGilGrpXNewIntrEventP14C = {|XpiGilDRTIntrEventsP14C};
  
  // BitWise OR of ISR Contents and New Event
  assign XpiGilGrpXNewEventDataP11C = (XpiGilGrpXISRP15S | XpiGilDRTIntrEventsP14C);
    
  //-------------------------------------------
  //---- Interrupt Control Register Update ----
  //-------------------------------------------

  // Group X : ICR & ISR corresponds to DMA0, DMA1, DESCDMA, 
  // PKTRX & PKTTX Interrupts
  
  // Offset 0x00 -> 0x20 is reserved for 8x32b Control Registers
  // Offset 0x20 -> 0x40 is reserved for 8x32b Status Registers
  
DFFR #(1,1'b0) U27_dff (.q(XpiGilPciAddrIrdyP10S),.d(XpiPciAppGilAddrIrdyP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(5,5'b0) U28_dff (.q(XpiGilPciOffsetP10S),.d(XpiPciAppGilOffsetP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(4,4'b0) U29_dff (.q(XpiGilPciCmdP10S),.d(XpiPciAppGilCmdP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiGilValidCfgWrP11C = (XpiGilPciAddrIrdyP10S && XpiPciAppGilDataIrdyP11S &&
				 (XpiGilPciCmdP10S==`CTRLWR));
  
  assign XpiGilGrpAICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h00));
  assign XpiGilGrpBICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h01));
  assign XpiGilGrpCICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h02));
  assign XpiGilGrpDICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h03));  
  assign XpiGilGrpEICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h04));
  assign XpiGilGrpFICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h05));
  assign XpiGilGrpGICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h06));
  assign XpiGilGrpHICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h07));  
  assign XpiGilGrpXICRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h10));

  //---- Interrupt Control Register Set ----
  
  assign XpiGilGrpAICRP11C = XpiGilGrpAICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpAICRP11S;
DFFR #(32,32'b0) U30_dff (.q(XpiGilGrpAICRP11S),.d(XpiGilGrpAICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiGilGrpBICRP11C = XpiGilGrpBICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpBICRP11S;
DFFR #(32,32'b0) U31_dff (.q(XpiGilGrpBICRP11S),.d(XpiGilGrpBICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiGilGrpCICRP11C = XpiGilGrpCICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpCICRP11S;
DFFR #(32,32'b0) U32_dff (.q(XpiGilGrpCICRP11S),.d(XpiGilGrpCICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiGilGrpDICRP11C = XpiGilGrpDICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpDICRP11S;
DFFR #(32,32'b0) U33_dff (.q(XpiGilGrpDICRP11S),.d(XpiGilGrpDICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiGilGrpEICRP11C = XpiGilGrpEICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpEICRP11S;
DFFR #(32,32'b0) U34_dff (.q(XpiGilGrpEICRP11S),.d(XpiGilGrpEICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiGilGrpFICRP11C = XpiGilGrpFICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpFICRP11S;
DFFR #(32,32'b0) U35_dff (.q(XpiGilGrpFICRP11S),.d(XpiGilGrpFICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiGilGrpGICRP11C = XpiGilGrpGICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpGICRP11S;
DFFR #(32,32'b0) U36_dff (.q(XpiGilGrpGICRP11S),.d(XpiGilGrpGICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiGilGrpHICRP11C = XpiGilGrpHICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpHICRP11S;
DFFR #(32,32'b0) U37_dff (.q(XpiGilGrpHICRP11S),.d(XpiGilGrpHICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiGilGrpXICRP11C = XpiGilGrpXICRWrP11C ? 
	 XpiPciAppGilDataP11S : XpiGilGrpXICRP11S;
DFFR #(32,32'b0) U38_dff (.q(XpiGilGrpXICRP11S),.d(XpiGilGrpXICRP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //-----------------------------------
  //---- ISR Data Mux Select Logic ----
  //-----------------------------------

  assign XpiGilGrpAISRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h08));
  assign XpiGilGrpBISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h09));
  assign XpiGilGrpCISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h0a));
  assign XpiGilGrpDISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h0b));
  assign XpiGilGrpEISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h0c));
  assign XpiGilGrpFISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h0d));
  assign XpiGilGrpGISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h0e));
  assign XpiGilGrpHISRWrP11C =
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h0f));
  assign XpiGilGrpXISRWrP11C = 
	 (XpiGilValidCfgWrP11C && (XpiGilPciOffsetP10S == `GIL_OFFSET_WIDTH'h11));
  
  // BitWise XOR of ISR Contents and Write Clear Data
  assign XpiGilGrpAWrClrDataP11C = (XpiGilGrpAISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpBWrClrDataP11C = (XpiGilGrpBISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpCWrClrDataP11C = (XpiGilGrpCISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpDWrClrDataP11C = (XpiGilGrpDISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpEWrClrDataP11C = (XpiGilGrpEISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpFWrClrDataP11C = (XpiGilGrpFISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpGWrClrDataP11C = (XpiGilGrpGISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpHWrClrDataP11C = (XpiGilGrpHISRP15S ^ XpiPciAppGilDataP11S);
  assign XpiGilGrpXWrClrDataP11C = (XpiGilGrpXISRP15S ^ XpiPciAppGilDataP11S);
  
  // Setting Mux Select for Interrupt Assertion or Write Transaction
  
  always @(/*AS*/XpiGilGrpAISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpAMuxSelP14C = 2'b01;
      else if (XpiGilGrpAISRWrP11C)
	XpiGilGrpAMuxSelP14C = 2'b10;
      else
	XpiGilGrpAMuxSelP14C = 2'b00;
    end
  
  always @(/*AS*/XpiGilGrpBISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpBMuxSelP14C = 2'b01;
      else if (XpiGilGrpBISRWrP11C)
	XpiGilGrpBMuxSelP14C = 2'b10;
      else
	XpiGilGrpBMuxSelP14C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpCISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpCMuxSelP14C = 2'b01;
      else if (XpiGilGrpCISRWrP11C)
	XpiGilGrpCMuxSelP14C = 2'b10;
      else
	XpiGilGrpCMuxSelP14C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpDISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpDMuxSelP14C = 2'b01;
      else if (XpiGilGrpDISRWrP11C)
	XpiGilGrpDMuxSelP14C = 2'b10;
      else
	XpiGilGrpDMuxSelP14C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpEISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpEMuxSelP14C = 2'b01;
      else if (XpiGilGrpEISRWrP11C)
	XpiGilGrpEMuxSelP14C = 2'b10;
      else
	XpiGilGrpEMuxSelP14C = 2'b00;
    end
  
  always @(/*AS*/XpiGilGrpFISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpFMuxSelP14C = 2'b01;
      else if (XpiGilGrpFISRWrP11C)
	XpiGilGrpFMuxSelP14C = 2'b10;
      else
	XpiGilGrpFMuxSelP14C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpGISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpGMuxSelP14C = 2'b01;
      else if (XpiGilGrpGISRWrP11C)
	XpiGilGrpGMuxSelP14C = 2'b10;
      else
	XpiGilGrpGMuxSelP14C = 2'b00;
    end

  always @(/*AS*/XpiGilGrpHISRWrP11C or XpiGilNewIntrEventP15S)
    begin
      if (XpiGilNewIntrEventP15S)
	XpiGilGrpHMuxSelP14C = 2'b01;
      else if (XpiGilGrpHISRWrP11C)
	XpiGilGrpHMuxSelP14C = 2'b10;
      else
	XpiGilGrpHMuxSelP14C = 2'b00;
    end
    
  always @(/*AS*/XpiGilGrpXISRWrP11C or XpiGilGrpXNewIntrEventP14C)
    begin
      if (XpiGilGrpXNewIntrEventP14C)
	XpiGilGrpXMuxSelP14C = 2'b01;
      else if (XpiGilGrpXISRWrP11C)
	XpiGilGrpXMuxSelP14C = 2'b10;
      else
	XpiGilGrpXMuxSelP14C = 2'b00;
    end
    
  //---- ISR Data Muxing ----
  
MUX4S2 #(32) U39_mux4 (.mo(XpiGilGrpAISRP15C),.in0(XpiGilGrpAISRP15S),.in1(XpiGilGrpAISRP14S),.in2(XpiGilGrpAWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpAMuxSelP14C));


  
DFFR #(32,32'b0) U40_dff (.q(XpiGilGrpAISRP15S),.d(XpiGilGrpAISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U41_mux4 (.mo(XpiGilGrpBISRP15C),.in0(XpiGilGrpBISRP15S),.in1(XpiGilGrpBISRP14S),.in2(XpiGilGrpBWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpBMuxSelP14C));


  
DFFR #(32,32'b0) U42_dff (.q(XpiGilGrpBISRP15S),.d(XpiGilGrpBISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U43_mux4 (.mo(XpiGilGrpCISRP15C),.in0(XpiGilGrpCISRP15S),.in1(XpiGilGrpCISRP14S),.in2(XpiGilGrpCWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpCMuxSelP14C));


  
DFFR #(32,32'b0) U44_dff (.q(XpiGilGrpCISRP15S),.d(XpiGilGrpCISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U45_mux4 (.mo(XpiGilGrpDISRP15C),.in0(XpiGilGrpDISRP15S),.in1(XpiGilGrpDISRP14S),.in2(XpiGilGrpDWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpDMuxSelP14C));


  
DFFR #(32,32'b0) U46_dff (.q(XpiGilGrpDISRP15S),.d(XpiGilGrpDISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

MUX4S2 #(32) U47_mux4 (.mo(XpiGilGrpEISRP15C),.in0(XpiGilGrpEISRP15S),.in1(XpiGilGrpEISRP14S),.in2(XpiGilGrpEWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpEMuxSelP14C));


  
DFFR #(32,32'b0) U48_dff (.q(XpiGilGrpEISRP15S),.d(XpiGilGrpEISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U49_mux4 (.mo(XpiGilGrpFISRP15C),.in0(XpiGilGrpFISRP15S),.in1(XpiGilGrpFISRP14S),.in2(XpiGilGrpFWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpFMuxSelP14C));


  
DFFR #(32,32'b0) U50_dff (.q(XpiGilGrpFISRP15S),.d(XpiGilGrpFISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U51_mux4 (.mo(XpiGilGrpGISRP15C),.in0(XpiGilGrpGISRP15S),.in1(XpiGilGrpGISRP14S),.in2(XpiGilGrpGWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpGMuxSelP14C));


  
DFFR #(32,32'b0) U52_dff (.q(XpiGilGrpGISRP15S),.d(XpiGilGrpGISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U53_mux4 (.mo(XpiGilGrpHISRP15C),.in0(XpiGilGrpHISRP15S),.in1(XpiGilGrpHISRP14S),.in2(XpiGilGrpHWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpHMuxSelP14C));


  
DFFR #(32,32'b0) U54_dff (.q(XpiGilGrpHISRP15S),.d(XpiGilGrpHISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
MUX4S2 #(32) U55_mux4 (.mo(XpiGilGrpXISRP15C),.in0(XpiGilGrpXISRP15S),.in1(XpiGilGrpXNewEventDataP11C),.in2(XpiGilGrpXWrClrDataP11C),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiGilGrpXMuxSelP14C));


  
DFFR #(32,32'b0) U56_dff (.q(XpiGilGrpXISRP15S),.d(XpiGilGrpXISRP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //----------------------------------
  //---- Register Read Completion ----
  //----------------------------------
  
  assign XpiGilValidCfgRdP11C = 
	 (XpiGilPciAddrIrdyP10S && (XpiGilPciCmdP10S==`CTRLRD));

  always @(/*AS*/XpiGilGrpAICRP11S or XpiGilGrpAISRP15S
	   or XpiGilGrpBICRP11S or XpiGilGrpBISRP15S
	   or XpiGilGrpCICRP11S or XpiGilGrpCISRP15S
	   or XpiGilGrpDICRP11S or XpiGilGrpDISRP15S
	   or XpiGilGrpEICRP11S or XpiGilGrpEISRP15S
	   or XpiGilGrpFICRP11S or XpiGilGrpFISRP15S
	   or XpiGilGrpGICRP11S or XpiGilGrpGISRP15S
	   or XpiGilGrpHICRP11S or XpiGilGrpHISRP15S
	   or XpiGilGrpXICRP11S or XpiGilGrpXISRP15S
	   or XpiGilPciOffsetP10S)
    begin

      case (XpiGilPciOffsetP10S)
	
	`GIL_OFFSET_WIDTH'h00 : XpiGilPciDataP11C = XpiGilGrpAICRP11S;
	
	`GIL_OFFSET_WIDTH'h01 : XpiGilPciDataP11C = XpiGilGrpBICRP11S;
	
	`GIL_OFFSET_WIDTH'h02 : XpiGilPciDataP11C = XpiGilGrpCICRP11S;
	
	`GIL_OFFSET_WIDTH'h03 : XpiGilPciDataP11C = XpiGilGrpDICRP11S;
	
	`GIL_OFFSET_WIDTH'h04 : XpiGilPciDataP11C = XpiGilGrpEICRP11S;
	
	`GIL_OFFSET_WIDTH'h05 : XpiGilPciDataP11C = XpiGilGrpFICRP11S;
	
	`GIL_OFFSET_WIDTH'h06 : XpiGilPciDataP11C = XpiGilGrpGICRP11S;
	
	`GIL_OFFSET_WIDTH'h07 : XpiGilPciDataP11C = XpiGilGrpHICRP11S;
	
	`GIL_OFFSET_WIDTH'h10 : XpiGilPciDataP11C = XpiGilGrpXICRP11S;
	
	`GIL_OFFSET_WIDTH'h08 : XpiGilPciDataP11C = XpiGilGrpAISRP15S;
	
	`GIL_OFFSET_WIDTH'h09 : XpiGilPciDataP11C = XpiGilGrpBISRP15S;
	
	`GIL_OFFSET_WIDTH'h0a : XpiGilPciDataP11C = XpiGilGrpCISRP15S;
	
	`GIL_OFFSET_WIDTH'h0b : XpiGilPciDataP11C = XpiGilGrpDISRP15S;
	
	`GIL_OFFSET_WIDTH'h0c : XpiGilPciDataP11C = XpiGilGrpEISRP15S;
	
	`GIL_OFFSET_WIDTH'h0d : XpiGilPciDataP11C = XpiGilGrpFISRP15S;
	
	`GIL_OFFSET_WIDTH'h0e : XpiGilPciDataP11C = XpiGilGrpGISRP15S;
	
	`GIL_OFFSET_WIDTH'h0f : XpiGilPciDataP11C = XpiGilGrpHISRP15S;
	
	`GIL_OFFSET_WIDTH'h11: XpiGilPciDataP11C = XpiGilGrpXISRP15S;

	default: XpiGilPciDataP11C = {`CFG_WIDTH{1'b0}};

      endcase // case(XpiGilPciOffsetP10S)
      
    end // always @ (...
  
DFFR #(1,1'b0) U57_dff (.q(XpiGilPciDataIrdyP11S),.d(XpiGilValidCfgRdP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U58_dff (.q(XpiGilPciDataP11S),.d(XpiGilPciDataP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //------------------------------------------
  //---- Interrupt Pulse Generation Logic ----
  //------------------------------------------

  // BitWise ANDing ICR & ISR
  assign XpiGilGrpANewIntrP10C = (XpiGilGrpAICRP11S & XpiGilGrpAISRP15S);
  assign XpiGilGrpBNewIntrP10C = (XpiGilGrpBICRP11S & XpiGilGrpBISRP15S);
  assign XpiGilGrpCNewIntrP10C = (XpiGilGrpCICRP11S & XpiGilGrpCISRP15S);
  assign XpiGilGrpDNewIntrP10C = (XpiGilGrpDICRP11S & XpiGilGrpDISRP15S);
  assign XpiGilGrpENewIntrP10C = (XpiGilGrpEICRP11S & XpiGilGrpEISRP15S);
  assign XpiGilGrpFNewIntrP10C = (XpiGilGrpFICRP11S & XpiGilGrpFISRP15S);
  assign XpiGilGrpGNewIntrP10C = (XpiGilGrpGICRP11S & XpiGilGrpGISRP15S);
  assign XpiGilGrpHNewIntrP10C = (XpiGilGrpHICRP11S & XpiGilGrpHISRP15S);
  assign XpiGilGrpXNewIntrP10C = (XpiGilGrpXICRP11S & XpiGilGrpXISRP15S);

  // Reduction ORing to detect a New Interrupt
  assign XpiGilGrpANewIntrP11C = (|XpiGilGrpANewIntrP10C);
  assign XpiGilGrpBNewIntrP11C = (|XpiGilGrpBNewIntrP10C);
  assign XpiGilGrpCNewIntrP11C = (|XpiGilGrpCNewIntrP10C);
  assign XpiGilGrpDNewIntrP11C = (|XpiGilGrpDNewIntrP10C);
  assign XpiGilGrpENewIntrP11C = (|XpiGilGrpENewIntrP10C);
  assign XpiGilGrpFNewIntrP11C = (|XpiGilGrpFNewIntrP10C);
  assign XpiGilGrpGNewIntrP11C = (|XpiGilGrpGNewIntrP10C);
  assign XpiGilGrpHNewIntrP11C = (|XpiGilGrpHNewIntrP10C);
  assign XpiGilGrpXNewIntrP11C = (|XpiGilGrpXNewIntrP10C);

  assign XpiGilNewIntrP11C = (XpiGilGrpANewIntrP11C || XpiGilGrpBNewIntrP11C ||
			      XpiGilGrpCNewIntrP11C || XpiGilGrpDNewIntrP11C ||
			      XpiGilGrpENewIntrP11C || XpiGilGrpFNewIntrP11C ||
			      XpiGilGrpGNewIntrP11C || XpiGilGrpHNewIntrP11C ||
			      XpiGilGrpXNewIntrP11C);

DFFR #(1,1'b0) U59_dff (.q(XpiGilINTAP11S),.d(XpiGilNewIntrP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiGilINTBP11S = 1'b0;
  assign XpiGilINTCP11S = 1'b0;
  assign XpiGilINTDP11S = 1'b0;

  assign XpiGilINTAENP11S = 1'b1;
  assign XpiGilINTBENP11S = 1'b1;
  assign XpiGilINTCENP11S = 1'b1;
  assign XpiGilINTDENP11S = 1'b1;
  
  //---------------------------------------------
  //---- Core Clk -> Pci Clk Synchronization ----
  //---------------------------------------------

  //mpp <clock=XpiCoreClk, reset=GlCoreResetR00C>

  // Grouping all 8 ISR Write Enables into single Enable to save up
  // on duplicate logic. A single Interrupt Enable is going to update all 8 ISR's
  // in PCI domain, however since only the ISR in Core Clock domain
  // corresponding to Interrupting event is updated, the contents of remaining
  // 7 ISR's in PCI domain remain unchanged.

  assign XpiGilNewIntrEventP11C = 
	 (XpiGilGrpANewIntrEventP11C || XpiGilGrpBNewIntrEventP11C ||
	  XpiGilGrpCNewIntrEventP11C || XpiGilGrpDNewIntrEventP11C ||
	  XpiGilGrpENewIntrEventP11C || XpiGilGrpFNewIntrEventP11C ||
	  XpiGilGrpGNewIntrEventP11C || XpiGilGrpHNewIntrEventP11C);
				       
  //-------------------------------------
  //---- Synchronizing State Machine ----
  //-------------------------------------
  //** 5*CoreClk (333MHz) == PciClk(66MHz)
  //** 10*CoreClk (333MHz) == PciClk(33MHz)  
  //** A single CoreClk Pulse is to be asserted for 5+1=6
  //** Core Clk cycles to result into a single PCI Clk Pulse

`define XPIGILCPSYNCIDLE   1'b0
`define XPIGILCPSYNCASSERT 1'b1

  // Internal State Variables
  wire 	 xpigilcpsyncstate;
  reg 	 next_xpigilcpsyncstate;

  //---- State Change ----
  
DFFR #(1,1'b0) U60_dff (.q(xpigilcpsyncstate),.d(next_xpigilcpsyncstate),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
  //---- State Assignment ----

  always @(/*AS*/xpigilcpsyncstate)
    begin

      XpiGilAssertCntEnP10C  = 1'b0;
      XpiGilNewIntrEventP12C = 1'b0;

      case (xpigilcpsyncstate)

	`XPIGILCPSYNCIDLE :
	  begin
	    XpiGilAssertCntEnP10C  = 1'b0;
	    XpiGilNewIntrEventP12C = 1'b0;
	  end

	`XPIGILCPSYNCASSERT :
	  begin
	    XpiGilAssertCntEnP10C  = 1'b1;
	    XpiGilNewIntrEventP12C = 1'b1;
	  end
	
	default:
	  begin
	    XpiGilAssertCntEnP10C  = 1'b0;
	    XpiGilNewIntrEventP12C = 1'b0;
	  end

      endcase // case(xpigilcpsyncstate)
    end // always @ (...

  //---- State Transition ----
  
  always @(/*AS*/XpiGilAssertCntP10S or XpiGilNewIntrEventP11C
	   or XpiPciAppFreq133P11S or XpiPciAppFreq33P11S
	   or XpiPciAppFreq66P11S or xpigilcpsyncstate)
    begin
      
      case (xpigilcpsyncstate)
	
	`XPIGILCPSYNCIDLE:
	  begin
	    if (XpiGilNewIntrEventP11C)
	      next_xpigilcpsyncstate = `XPIGILCPSYNCASSERT;
	    else
	      next_xpigilcpsyncstate = `XPIGILCPSYNCIDLE;
	  end
	    
	`XPIGILCPSYNCASSERT:
	  begin
	    if ((XpiPciAppFreq133P11S && (XpiGilAssertCntP10S == 4'b0011)) ||
		(XpiPciAppFreq66P11S && (XpiGilAssertCntP10S == 4'b0110))  ||
		(XpiPciAppFreq33P11S && (XpiGilAssertCntP10S == 4'b1100)))
	      next_xpigilcpsyncstate = `XPIGILCPSYNCIDLE;
	    else
	      next_xpigilcpsyncstate = `XPIGILCPSYNCASSERT;
	  end

	default : next_xpigilcpsyncstate = `XPIGILCPSYNCIDLE;

      endcase // case(xpigilcpsyncstate)
    end // always @ (...
    
  //---- Signal Assertion Counter ----
  
  always @(/*AS*/XpiGilAssertCntEnP10C or XpiGilAssertCntP10S)
    begin
      if (XpiGilAssertCntEnP10C)
	XpiGilAssertCntP10C = {XpiGilAssertCntP10S + 4'b1};
      else if (XpiGilAssertCntP10S == 4'hf)
	XpiGilAssertCntP10C = 4'h0;
      else
	XpiGilAssertCntP10C = 4'h0;
    end

DFFR #(4,4'b0) U61_dff (.q(XpiGilAssertCntP10S),.d(XpiGilAssertCntP10C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

DFFR #(1,1'b0) U62_dff (.q(XpiGilNewIntrEventP12S),.d(XpiGilNewIntrEventP12C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
  //mpp <clock=XpiPciClk, reset=GlCoreResetR00C>
  
  // First PCI Clock Sync Stage

DFFR #(1,1'b0) U63_dff (.q(XpiGilNewIntrEventP13S),.d(XpiGilNewIntrEventP12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));

DFFR #(32,32'b0) U64_dff (.q(XpiGilGrpAISRP12S),.d(XpiGilGrpAISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U65_dff (.q(XpiGilGrpBISRP12S),.d(XpiGilGrpBISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U66_dff (.q(XpiGilGrpCISRP12S),.d(XpiGilGrpCISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U67_dff (.q(XpiGilGrpDISRP12S),.d(XpiGilGrpDISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U68_dff (.q(XpiGilGrpEISRP12S),.d(XpiGilGrpEISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U69_dff (.q(XpiGilGrpFISRP12S),.d(XpiGilGrpFISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U70_dff (.q(XpiGilGrpGISRP12S),.d(XpiGilGrpGISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U71_dff (.q(XpiGilGrpHISRP12S),.d(XpiGilGrpHISRP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Second PCI Clock Sync Stage

DFFR #(1,1'b0) U72_dff (.q(XpiGilNewIntrEventP14S),.d(XpiGilNewIntrEventP13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));

