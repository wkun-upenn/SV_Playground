DFFR #(1,1'b0) U82_dff (.q(XpiGilNewIntrEventP15S),.d(XpiGilNewIntrEventP15C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Muxing the Synchronized Data

  assign XpiGilGrpAISRP14C = XpiGilNewIntrEventP15C ?
