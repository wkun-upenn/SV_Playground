  // Flopping the Write Clear Enable
DFFR #(1,1'b0) U91_dff (.q(XpiGilGrpAISRWrP11S),.d(XpiGilGrpAISRWrP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U92_dff (.q(XpiGilGrpBISRWrP11S),.d(XpiGilGrpBISRWrP11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
