DFFR #(1,1'b0) U118_dff (.q(XpiGilGrpAISRWrP15S),.d(XpiGilGrpAISRWrP13S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U119_dff (.q(XpiGilGrpBISRWrP15S),.d(XpiGilGrpBISRWrP13S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U120_dff (.q(XpiGilGrpCISRWrP15S),.d(XpiGilGrpCISRWrP13S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U121_dff (.q(XpiGilGrpDISRWrP15S),.d(XpiGilGrpDISRWrP13S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U122_dff (.q(XpiGilGrpEISRWrP15S),.d(XpiGilGrpEISRWrP13S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
