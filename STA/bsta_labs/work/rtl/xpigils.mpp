DFFR #(1,1'b0) U100_dff (.q(XpiGilGrpAISRWrP12S),.d(XpiGilGrpAISRWrP11S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U101_dff (.q(XpiGilGrpBISRWrP12S),.d(XpiGilGrpBISRWrP11S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
