DFFR #(32,32'b0) U76_dff (.q(XpiGilGrpDISRP13S),.d(XpiGilGrpDISRP12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U77_dff (.q(XpiGilGrpEISRP13S),.d(XpiGilGrpEISRP12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U78_dff (.q(XpiGilGrpFISRP13S),.d(XpiGilGrpFISRP12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(32,32'b0) U79_dff (.q(XpiGilGrpGISRP13S),.d(XpiGilGrpGISRP12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
