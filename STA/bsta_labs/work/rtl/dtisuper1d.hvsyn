
module dtisuper1d ( DtiSampleOneS, DtiSampleTwoS, DtiSampleClk, DtiSampleData
     );
input  DtiSampleClk, DtiSampleData;
output DtiSampleOneS, DtiSampleTwoS;
    wire DtiSampleTwo1S, DtiSampleOne0S, DtiSampleOne1S, DtiSampleTwo0S;
    TLATX1 DtiSampleOne0S_reg ( .D(DtiSampleData), .G(DtiSampleClk), .Q(
        DtiSampleOne0S), .QN() );
    TLATX1 DtiSampleTwo1S_reg ( .D(DtiSampleTwo0S), .G(DtiSampleClk), .Q(
        DtiSampleTwo1S), .QN() );
    TLATNX1 DtiSampleTwo0S_reg ( .D(DtiSampleData), .GN(DtiSampleClk), .Q(
        DtiSampleTwo0S), .QN() );
    DFFQX1 U1_DFF_QI_reg_0 ( .D(DtiSampleOne1S), .CK(DtiSampleClk), .Q(
        DtiSampleOneS) );
    DFFQX1 U0_DFF_QI_reg_0 ( .D(DtiSampleOne0S), .CK(DtiSampleClk), .Q(
        DtiSampleOne1S) );
    DFFQX1 U2_DFF_QI_reg_0 ( .D(DtiSampleTwo1S), .CK(DtiSampleClk), .Q(
        DtiSampleTwoS) );
endmodule

