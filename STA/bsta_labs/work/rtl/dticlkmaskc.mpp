`include "dtiuc.vh"

module dticlkmaskc (
   /*AUTOARG*/
   // Outputs
   DtiPosMaskS, DtiNegMaskS, 
   // Inputs
   xxin_IDCLK
);

   //==========================================================================
   //==========               Interface Signals                      ==========
   //==========================================================================
   // You should not have to explicitly declare your input/output for a
   // connectivity file. The AUTOINPUT and AUTOOUTPUT should take care of it.

   /*AUTOINPUT*/
   // Beginning of automatic inputs (from unused autoinst inputs)
   input                xxin_IDCLK;             // To U_dticlkmaskdelayd of dticlkmaskdelayd.v, ...
   // End of automatics

   /*AUTOOUTPUT*/
   // Beginning of automatic outputs (from unused autoinst outputs)
   output [30:0]        DtiNegMaskS;            // From U0_dticlkmask1d of dtisuper1d.v, ...
   output [30:0]        DtiPosMaskS;            // From U0_dticlkmask1d of dtisuper1d.v, ...
   // End of automatics


   //==========================================================================
   //==========               Internal Signals                       ==========
   //==========================================================================
   // You should not have to explicitly declare wires for a connectivity file.
   // AUTOWIRE should declare it for you.

   /*AUTOWIRE*/
   // Beginning of automatic wires (for undeclared instantiated-module outputs)
   wire [`DTI_CLK_MASK_WIDTH-1:0]DtiSuperClk;   // From U_dticlkmaskdelayd of dticlkmaskdelayd.v
   // End of automatics


   //==========================================================================
   //==========             SubBlock Instantiation                   ==========
   //==========================================================================
   // You should instantiate your sub blocks here. It may be useful to use
   // AUTO_TEMPLATE when instantiating multiple instances of the same module.


   // Module Name: dticlkmaskdelayd
   // Instance Name: U_dticlkmaskdelayd
   // Description: Create delayed clocks

   dticlkmaskdelayd U_dticlkmaskdelayd (/*AUTOINST*/
                                        // Outputs
                                        .DtiSuperClk(DtiSuperClk[`DTI_CLK_MASK_WIDTH-1:0]),
                                        // Inputs
                                        .xxin_IDCLK(xxin_IDCLK));


   // Module Name: dtisuper1d
   // Instance Name: U_dtisuper1d
   // Description: Measure the phase overlap of one delayed clock

   // The number of instances below should match `DTI_CLK_MASK_WIDTH

/* dtisuper1d AUTO_TEMPLATE (
      // Outputs
      .DtiSampleOneS (DtiPosMaskS[@]),
      .DtiSampleTwoS (DtiNegMaskS[@]),
      // Inputs
      .DtiSampleClk  (xxin_IDCLK),
      .DtiSampleData (DtiSuperClk[@]));
*/

   dtisuper1d U0_dticlkmask1d (/*AUTOINST*/
                               // Outputs
                               .DtiSampleOneS(DtiPosMaskS[0]),   // Templated
                               .DtiSampleTwoS(DtiNegMaskS[0]),   // Templated
                               // Inputs
                               .DtiSampleClk(xxin_IDCLK),        // Templated
                               .DtiSampleData(DtiSuperClk[0]));   // Templated

   dtisuper1d U1_dticlkmask1d (/*AUTOINST*/
                               // Outputs
                               .DtiSampleOneS(DtiPosMaskS[1]),   // Templated
                               .DtiSampleTwoS(DtiNegMaskS[1]),   // Templated
                               // Inputs
                               .DtiSampleClk(xxin_IDCLK),        // Templated
                               .DtiSampleData(DtiSuperClk[1]));   // Templated

   dtisuper1d U2_dticlkmask1d (/*AUTOINST*/
                               // Outputs
                               .DtiSampleOneS(DtiPosMaskS[2]),   // Templated
                               .DtiSampleTwoS(DtiNegMaskS[2]),   // Templated
                               // Inputs
                               .DtiSampleClk(xxin_IDCLK),        // Templated
