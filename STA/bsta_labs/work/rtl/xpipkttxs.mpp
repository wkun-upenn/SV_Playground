	    XpiPktTxQ6SetSOPPns11C      = 1'b0;
	    XpiPktTxQ6SetEOPPns11C      = 1'b0;
	    XpiPktTxQ6SetSOPEOPPns11C   = 1'b0;
	    XpiPktTxQ6UnSetSOPEOPPns11C = 1'b0;
	  end
	
	`XPIPKTTXQ6DESCUPDTS0: XpiPktTxQ6SetSOPPns11C = 1'b1;
	  	    
	`XPIPKTTXQ6DESCUPDTS1: XpiPktTxQ6SetSOPEOPPns11C = 1'b1;
	
	`XPIPKTTXQ6DESCUPDTS2: XpiPktTxQ6UnSetSOPEOPPns11C = 1'b1;

	`XPIPKTTXQ6DESCUPDTS3: XpiPktTxQ6SetEOPPns11C = 1'b1;

	default:
	  begin
	    XpiPktTxQ6SetSOPPns11C      = 1'b0;
	    XpiPktTxQ6SetEOPPns11C      = 1'b0;
	    XpiPktTxQ6SetSOPEOPPns11C   = 1'b0;
	    XpiPktTxQ6UnSetSOPEOPPns11C = 1'b0;
	  end
	  
      endcase // case(xpipkttxQ6descupdtstate)
    end // always @ (...
  
  // State Transition
      
  always @(/*AS*/XpiPktTxDescWrBackEn2Psn10C
	   or XpiPktTxQ6BufFullPsn11C or XpiPktTxQ6FinalUpdatePsn11S
	   or XpiPktTxQ6NextDescRdPsn11C
	   or XpiPktTxQ6UpdateStatusPsn11S or xpipkttxQ6descupdtstate)
    begin

      case (xpipkttxQ6descupdtstate)

	`XPIPKTTXQ6DESCUPDTIDLE: 
	  begin
	    if (XpiPktTxQ6FinalUpdatePsn11S)
	      // Less than One Chunk Packet, Set SOP & EOP
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS1;
	    else if (XpiPktTxQ6UpdateStatusPsn11S)
	      // First Packet Chunk, Set SOP
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS0;
	    else
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTIDLE;
	  end
	      
	`XPIPKTTXQ6DESCUPDTS0:
	  begin
	    if (XpiPktTxQ6BufFullPsn11C && XpiPktTxDescWrBackEn2Psn10C &&
		(~XpiPktTxQ6FinalUpdatePsn11S))
	      // Packet Straddling across multiple buffers, current
	      // buffer is full, however packet not complete, transition
	      // S2 to unset SOP & EOP for subsequent Descriptor
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS2;
	    else if (XpiPktTxQ6FinalUpdatePsn11S)
	      // Packet residing in single buffer, set SOP, EOP
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS1;
	    else  
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS0;
	  end // case: `XPIPKTTXQ6DESCUPDTS0
	
	`XPIPKTTXQ6DESCUPDTS1: 
	  begin
	    if (XpiPktTxQ6NextDescRdPsn11C)
	      // Descriptor Write Back complete, transition to Idle
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTIDLE;
	    else
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS1;
	  end
	
	`XPIPKTTXQ6DESCUPDTS2: 
	  begin
	    if (XpiPktTxQ6FinalUpdatePsn11S)
	      // Packet straddling multiple buffers, Packet Transfer complete,
	      // transition to unset SOP & set EOP.
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS3;
	    else
	      next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTS2;
	  end
	
	`XPIPKTTXQ6DESCUPDTS3: next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTIDLE;

	default: next_xpipkttxQ6descupdtstate = `XPIPKTTXQ6DESCUPDTIDLE;

      endcase // case(xpipkttxQ6descupdtstate)
    end // always @ (...
    

  //---- Egress Queue 2 Descriptor Update ----
  
  always @(/*AS*/XpiPktTxDescPtrRegPns10C
	   or XpiPktTxQ6DescPtrRegPns11S or XpiPktTxQ6DescWrPns11C
	   or XpiPktTxQ6SetEOPPns11C or XpiPktTxQ6SetSOPEOPPns11C
	   or XpiPktTxQ6SetSOPPns11C or XpiPktTxQ6UnSetSOPEOPPns11C
	   or XpiPktTxQ6UsedBufLenPsn11S)
    begin
      
      if (XpiPktTxQ6DescWrPns11C)
	// New Descriptor read from CPU Memory
	XpiPktTxQ6DescPtrRegPns11C = XpiPktTxDescPtrRegPns10C;
      else if (XpiPktTxQ6SetSOPPns11C)
	XpiPktTxQ6DescPtrRegPns11C = {XpiPktTxQ6DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ6UsedBufLenPsn11S,
				      XpiPktTxQ6DescPtrRegPns11S[31:3], 3'b010};
      else if (XpiPktTxQ6SetEOPPns11C)
	XpiPktTxQ6DescPtrRegPns11C = {XpiPktTxQ6DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ6UsedBufLenPsn11S,
				      XpiPktTxQ6DescPtrRegPns11S[31:3], 3'b100};
      else if (XpiPktTxQ6SetSOPEOPPns11C)
	XpiPktTxQ6DescPtrRegPns11C = {XpiPktTxQ6DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ6UsedBufLenPsn11S,
				      XpiPktTxQ6DescPtrRegPns11S[31:3], 3'b110};
      else if (XpiPktTxQ6UnSetSOPEOPPns11C)
	XpiPktTxQ6DescPtrRegPns11C = {XpiPktTxQ6DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ6UsedBufLenPsn11S,
				      XpiPktTxQ6DescPtrRegPns11S[31:3], 3'b000};
      else
	XpiPktTxQ6DescPtrRegPns11C = XpiPktTxQ6DescPtrRegPns11S;
    end // always @ (...
  
DFFR #(128,128'b0) U192_dff (.q(XpiPktTxQ6DescPtrRegPns11S),.d(XpiPktTxQ6DescPtrRegPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //----------------------------------------------------------------
  //---- Egress Queue 3 Descriptor Update Control State Machine ----
  //----------------------------------------------------------------

`define XPIPKTTXQ7DESCUPDTIDLE 3'b000
`define XPIPKTTXQ7DESCUPDTS0   3'b001
`define XPIPKTTXQ7DESCUPDTS1   3'b010
`define XPIPKTTXQ7DESCUPDTS2   3'b011
`define XPIPKTTXQ7DESCUPDTS3   3'b101
  
  // State Variables
  wire [2:0] xpipkttxQ7descupdtstate;
  reg [2:0]  next_xpipkttxQ7descupdtstate;
 
  // State Change

DFFR #(3,3'b0) U193_dff (.q(xpipkttxQ7descupdtstate),.d(next_xpipkttxQ7descupdtstate),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // State Assignment

  always @(/*AS*/xpipkttxQ7descupdtstate)
    begin
      
      XpiPktTxQ7SetSOPPns11C      = 1'b0;
      XpiPktTxQ7SetEOPPns11C      = 1'b0;
      XpiPktTxQ7SetSOPEOPPns11C   = 1'b0;
      XpiPktTxQ7UnSetSOPEOPPns11C = 1'b0;
      
      case (xpipkttxQ7descupdtstate)

	`XPIPKTTXQ7DESCUPDTIDLE: 
	  begin
	    XpiPktTxQ7SetSOPPns11C      = 1'b0;
	    XpiPktTxQ7SetEOPPns11C      = 1'b0;
	    XpiPktTxQ7SetSOPEOPPns11C   = 1'b0;
	    XpiPktTxQ7UnSetSOPEOPPns11C = 1'b0;
	  end
	
	`XPIPKTTXQ7DESCUPDTS0: XpiPktTxQ7SetSOPPns11C = 1'b1;
	  	    
	`XPIPKTTXQ7DESCUPDTS1: XpiPktTxQ7SetSOPEOPPns11C = 1'b1;
	
	`XPIPKTTXQ7DESCUPDTS2: XpiPktTxQ7UnSetSOPEOPPns11C = 1'b1;

	`XPIPKTTXQ7DESCUPDTS3: XpiPktTxQ7SetEOPPns11C = 1'b1;

	default:
	  begin
	    XpiPktTxQ7SetSOPPns11C      = 1'b0;
	    XpiPktTxQ7SetEOPPns11C      = 1'b0;
	    XpiPktTxQ7SetSOPEOPPns11C   = 1'b0;
	    XpiPktTxQ7UnSetSOPEOPPns11C = 1'b0;
	  end
	  
      endcase // case(xpipkttxQ7descupdtstate)
    end // always @ (...
  
  // State Transition
      
  always @(/*AS*/XpiPktTxDescWrBackEn2Psn10C
	   or XpiPktTxQ7BufFullPsn11C or XpiPktTxQ7FinalUpdatePsn11S
	   or XpiPktTxQ7NextDescRdPsn11C
	   or XpiPktTxQ7UpdateStatusPsn11S or xpipkttxQ7descupdtstate)
    begin

      case (xpipkttxQ7descupdtstate)

	`XPIPKTTXQ7DESCUPDTIDLE: 
	  begin
	    if (XpiPktTxQ7FinalUpdatePsn11S)
	      // Less than One Chunk Packet, Set SOP & EOP
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS1;
	    else if (XpiPktTxQ7UpdateStatusPsn11S)
	      // First Packet Chunk, Set SOP
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS0;
	    else
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTIDLE;
	  end
	      
	`XPIPKTTXQ7DESCUPDTS0:
	  begin
	    if (XpiPktTxQ7BufFullPsn11C && XpiPktTxDescWrBackEn2Psn10C &&
		(~XpiPktTxQ7FinalUpdatePsn11S))
	      // Packet Straddling across multiple buffers, current
	      // buffer is full, however packet not complete, transition
	      // S2 to unset SOP & EOP for subsequent Descriptor
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS2;
	    else if (XpiPktTxQ7FinalUpdatePsn11S)
	      // Packet residing in single buffer, set SOP, EOP
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS1;
	    else  
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS0;
	  end // case: `XPIPKTTXQ7DESCUPDTS0
	
	`XPIPKTTXQ7DESCUPDTS1: 
	  begin
	    if (XpiPktTxQ7NextDescRdPsn11C)
	      // Descriptor Write Back complete, transition to Idle
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTIDLE;
	    else
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS1;
	  end
	
	`XPIPKTTXQ7DESCUPDTS2: 
	  begin
	    if (XpiPktTxQ7FinalUpdatePsn11S)
	      // Packet straddling multiple buffers, Packet Transfer complete,
	      // transition to unset SOP & set EOP.
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS3;
	    else
	      next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTS2;
	  end
	
	`XPIPKTTXQ7DESCUPDTS3: next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTIDLE;

	default: next_xpipkttxQ7descupdtstate = `XPIPKTTXQ7DESCUPDTIDLE;

      endcase // case(xpipkttxQ7descupdtstate)
    end // always @ (...
    

  //---- Egress Queue 3 Descriptor Update ----
  
  always @(/*AS*/XpiPktTxDescPtrRegPns10C
	   or XpiPktTxQ7DescPtrRegPns11S or XpiPktTxQ7DescWrPns11C
	   or XpiPktTxQ7SetEOPPns11C or XpiPktTxQ7SetSOPEOPPns11C
	   or XpiPktTxQ7SetSOPPns11C or XpiPktTxQ7UnSetSOPEOPPns11C
	   or XpiPktTxQ7UsedBufLenPsn11S)
    begin
      
      if (XpiPktTxQ7DescWrPns11C)
	// New Descriptor read from CPU Memory
	XpiPktTxQ7DescPtrRegPns11C = XpiPktTxDescPtrRegPns10C;
      else if (XpiPktTxQ7SetSOPPns11C)
	XpiPktTxQ7DescPtrRegPns11C = {XpiPktTxQ7DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ7UsedBufLenPsn11S,
				      XpiPktTxQ7DescPtrRegPns11S[31:3], 3'b010};
      else if (XpiPktTxQ7SetEOPPns11C)
	XpiPktTxQ7DescPtrRegPns11C = {XpiPktTxQ7DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ7UsedBufLenPsn11S,
				      XpiPktTxQ7DescPtrRegPns11S[31:3], 3'b100};
      else if (XpiPktTxQ7SetSOPEOPPns11C)
	XpiPktTxQ7DescPtrRegPns11C = {XpiPktTxQ7DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ7UsedBufLenPsn11S,
				      XpiPktTxQ7DescPtrRegPns11S[31:3], 3'b110};
      else if (XpiPktTxQ7UnSetSOPEOPPns11C)
	XpiPktTxQ7DescPtrRegPns11C = {XpiPktTxQ7DescPtrRegPns11S[`DESC_WIDTH-1:48],
				      XpiPktTxQ7UsedBufLenPsn11S,
				      XpiPktTxQ7DescPtrRegPns11S[31:3], 3'b000};
      else
	XpiPktTxQ7DescPtrRegPns11C = XpiPktTxQ7DescPtrRegPns11S;
    end // always @ (...
  
DFFR #(128,128'b0) U194_dff (.q(XpiPktTxQ7DescPtrRegPns11S),.d(XpiPktTxQ7DescPtrRegPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  
  //----------------------------
  //---- Descriptor Parsing ----
  //----------------------------

  // Ingress Queue 0
  assign XpiPktTxQ0CPUOwnerIntrPns11C  = XpiPktTxQ0CommandRegPns10S[23];
  assign XpiPktTxQ0DescASICOwnerPns11C = XpiPktTxQ0DescPtrRegPns11S[0];
  assign XpiPktTxQ0AvailBufLenPns11C   = XpiPktTxQ0DescPtrRegPns11S[63:48];

  // Ingress Queue 1
  assign XpiPktTxQ1CPUOwnerIntrPns11C  = XpiPktTxQ1CommandRegPns10S[23];
  assign XpiPktTxQ1DescASICOwnerPns11C = XpiPktTxQ1DescPtrRegPns11S[0];
  assign XpiPktTxQ1AvailBufLenPns11C   = XpiPktTxQ1DescPtrRegPns11S[63:48];

  // Ingress Queue 2
  assign XpiPktTxQ2CPUOwnerIntrPns11C  = XpiPktTxQ2CommandRegPns10S[23];
  assign XpiPktTxQ2DescASICOwnerPns11C = XpiPktTxQ2DescPtrRegPns11S[0];
  assign XpiPktTxQ2AvailBufLenPns11C   = XpiPktTxQ2DescPtrRegPns11S[63:48];

  // Ingress Queue 3
  assign XpiPktTxQ3CPUOwnerIntrPns11C  = XpiPktTxQ3CommandRegPns10S[23];
  assign XpiPktTxQ3DescASICOwnerPns11C = XpiPktTxQ3DescPtrRegPns11S[0];
  assign XpiPktTxQ3AvailBufLenPns11C   = XpiPktTxQ3DescPtrRegPns11S[63:48];

  // Egress Queue 0
  assign XpiPktTxQ4CPUOwnerIntrPns11C  = XpiPktTxQ4CommandRegPns10S[23];
  assign XpiPktTxQ4DescASICOwnerPns11C = XpiPktTxQ4DescPtrRegPns11S[0];
  assign XpiPktTxQ4AvailBufLenPns11C   = XpiPktTxQ4DescPtrRegPns11S[63:48];

  // Egress Queue 1
  assign XpiPktTxQ5CPUOwnerIntrPns11C  = XpiPktTxQ5CommandRegPns10S[23];
  assign XpiPktTxQ5DescASICOwnerPns11C = XpiPktTxQ5DescPtrRegPns11S[0];
  assign XpiPktTxQ5AvailBufLenPns11C   = XpiPktTxQ5DescPtrRegPns11S[63:48];

  // Egress Queue 2
  assign XpiPktTxQ6CPUOwnerIntrPns11C  = XpiPktTxQ6CommandRegPns10S[23];
  assign XpiPktTxQ6DescASICOwnerPns11C = XpiPktTxQ6DescPtrRegPns11S[0];
  assign XpiPktTxQ6AvailBufLenPns11C   = XpiPktTxQ6DescPtrRegPns11S[63:48];

  // Egress Queue 3
  assign XpiPktTxQ7CPUOwnerIntrPns11C  = XpiPktTxQ7CommandRegPns10S[23];
  assign XpiPktTxQ7DescASICOwnerPns11C = XpiPktTxQ7DescPtrRegPns11S[0];
  assign XpiPktTxQ7AvailBufLenPns11C   = XpiPktTxQ7DescPtrRegPns11S[63:48];

  //--------------------------------------------------
  //---- Total Number of Bytes Transferred Update ----
  //--------------------------------------------------

  // EOPOffset = size, hence Offset is zeroes for Full Chunk
  assign XpiPktTxIFullChunkPsn11C = {XpiPktTxIEOPOffsetPsn12S == 6'b000000};
  assign XpiPktTxEFullChunkPsn11C = {XpiPktTxEEOPOffsetPsn12S == 6'b000000};
  
  // Ingress Queue 0

  always @(/*AS*/XpiPktTxIEOPOffsetPsn12S or XpiPktTxIFullChunkPsn11C
	   or XpiPktTxQ0FinalUpdatePsn11C
	   or XpiPktTxQ0NextDescRdPsn11C
	   or XpiPktTxQ0UpdateStatusPsn11C
	   or XpiPktTxQ0UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ0UpdateStatusPsn11C)
	// 64B Chunk Transfer
	XpiPktTxQ0UsedBufLenPsn11C = {XpiPktTxQ0UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ0FinalUpdatePsn11C && XpiPktTxIFullChunkPsn11C)
	// Final Chunk Transfer
	XpiPktTxQ0UsedBufLenPsn11C = {XpiPktTxQ0UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ0FinalUpdatePsn11C && (~XpiPktTxIFullChunkPsn11C))
	// Final Chunk Transfer
	XpiPktTxQ0UsedBufLenPsn11C = {XpiPktTxQ0UsedBufLenPsn11S +
				      XpiPktTxIEOPOffsetPsn12S};
      else if (XpiPktTxQ0NextDescRdPsn11C)
	// Reset Length after Descriptor Write Back
	XpiPktTxQ0UsedBufLenPsn11C = {`AVAIL_BUFFER_LENGTH{1'b0}};
      else
	XpiPktTxQ0UsedBufLenPsn11C = XpiPktTxQ0UsedBufLenPsn11S;
    end // always @ (...
  
DFFR #(16,16'b0) U195_dff (.q(XpiPktTxQ0UsedBufLenPsn11S),.d(XpiPktTxQ0UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 1
  
  always @(/*AS*/XpiPktTxIEOPOffsetPsn12S or XpiPktTxIFullChunkPsn11C
	   or XpiPktTxQ1FinalUpdatePsn11C
	   or XpiPktTxQ1NextDescRdPsn11C
	   or XpiPktTxQ1UpdateStatusPsn11C
	   or XpiPktTxQ1UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ1UpdateStatusPsn11C)
	XpiPktTxQ1UsedBufLenPsn11C = {XpiPktTxQ1UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ1FinalUpdatePsn11C && XpiPktTxIFullChunkPsn11C)
	XpiPktTxQ1UsedBufLenPsn11C = {XpiPktTxQ1UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ1FinalUpdatePsn11C && (~XpiPktTxIFullChunkPsn11C))
	XpiPktTxQ1UsedBufLenPsn11C = {XpiPktTxQ1UsedBufLenPsn11S +
				      XpiPktTxIEOPOffsetPsn12S};
      else if (XpiPktTxQ1NextDescRdPsn11C)
	// Reset Length after Descriptor Write Back
	XpiPktTxQ1UsedBufLenPsn11C = {`AVAIL_BUFFER_LENGTH{1'b0}};
      else
	XpiPktTxQ1UsedBufLenPsn11C = XpiPktTxQ1UsedBufLenPsn11S;
    end // always @ (...
  
DFFR #(16,16'b0) U196_dff (.q(XpiPktTxQ1UsedBufLenPsn11S),.d(XpiPktTxQ1UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 2
  
  always @(/*AS*/XpiPktTxIEOPOffsetPsn12S or XpiPktTxIFullChunkPsn11C
	   or XpiPktTxQ2FinalUpdatePsn11C
	   or XpiPktTxQ2NextDescRdPsn11C
	   or XpiPktTxQ2UpdateStatusPsn11C
	   or XpiPktTxQ2UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ2UpdateStatusPsn11C)
	XpiPktTxQ2UsedBufLenPsn11C = {XpiPktTxQ2UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ2FinalUpdatePsn11C && XpiPktTxIFullChunkPsn11C)
	XpiPktTxQ2UsedBufLenPsn11C = {XpiPktTxQ2UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ2FinalUpdatePsn11C && (~XpiPktTxIFullChunkPsn11C))
	XpiPktTxQ2UsedBufLenPsn11C = {XpiPktTxQ2UsedBufLenPsn11S +
				      XpiPktTxIEOPOffsetPsn12S};
      else if (XpiPktTxQ2NextDescRdPsn11C)
	// Reset Length after Descriptor Write Back
	XpiPktTxQ2UsedBufLenPsn11C = {`AVAIL_BUFFER_LENGTH{1'b0}};
      else
	XpiPktTxQ2UsedBufLenPsn11C = XpiPktTxQ2UsedBufLenPsn11S;
    end // always @ (...
  
DFFR #(16,16'b0) U197_dff (.q(XpiPktTxQ2UsedBufLenPsn11S),.d(XpiPktTxQ2UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 3
  
  always @(/*AS*/XpiPktTxIEOPOffsetPsn12S or XpiPktTxIFullChunkPsn11C
	   or XpiPktTxQ3FinalUpdatePsn11C
	   or XpiPktTxQ3NextDescRdPsn11C
	   or XpiPktTxQ3UpdateStatusPsn11C
	   or XpiPktTxQ3UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ3UpdateStatusPsn11C)
	XpiPktTxQ3UsedBufLenPsn11C = {XpiPktTxQ3UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ3FinalUpdatePsn11C && XpiPktTxIFullChunkPsn11C)
	XpiPktTxQ3UsedBufLenPsn11C = {XpiPktTxQ3UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};	
      else if (XpiPktTxQ3FinalUpdatePsn11C && (~XpiPktTxIFullChunkPsn11C))
	XpiPktTxQ3UsedBufLenPsn11C = {XpiPktTxQ3UsedBufLenPsn11S +
				      XpiPktTxIEOPOffsetPsn12S};
      else if (XpiPktTxQ3NextDescRdPsn11C)
	// Reset Length after Descriptor Write Back
	XpiPktTxQ3UsedBufLenPsn11C = {`AVAIL_BUFFER_LENGTH{1'b0}};
      else
	XpiPktTxQ3UsedBufLenPsn11C = XpiPktTxQ3UsedBufLenPsn11S;
    end // always @ (...
  
DFFR #(16,16'b0) U198_dff (.q(XpiPktTxQ3UsedBufLenPsn11S),.d(XpiPktTxQ3UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0
  
  always @(/*AS*/XpiPktTxEEOPOffsetPsn12S or XpiPktTxEFullChunkPsn11C
	   or XpiPktTxQ4FinalUpdatePsn11C
	   or XpiPktTxQ4NextDescRdPsn11C
	   or XpiPktTxQ4UpdateStatusPsn11C
	   or XpiPktTxQ4UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ4UpdateStatusPsn11C)
	XpiPktTxQ4UsedBufLenPsn11C = {XpiPktTxQ4UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ4FinalUpdatePsn11C && XpiPktTxEFullChunkPsn11C)
	XpiPktTxQ4UsedBufLenPsn11C = {XpiPktTxQ4UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ4FinalUpdatePsn11C && (~XpiPktTxEFullChunkPsn11C))
	XpiPktTxQ4UsedBufLenPsn11C = {XpiPktTxQ4UsedBufLenPsn11S +
				      XpiPktTxEEOPOffsetPsn12S};
      else if (XpiPktTxQ4NextDescRdPsn11C)
	// Reset Length after Descriptor Write Back
	XpiPktTxQ4UsedBufLenPsn11C = {`AVAIL_BUFFER_LENGTH{1'b0}};
      else
	XpiPktTxQ4UsedBufLenPsn11C = XpiPktTxQ4UsedBufLenPsn11S;
    end // always @ (...
  
DFFR #(16,16'b0) U199_dff (.q(XpiPktTxQ4UsedBufLenPsn11S),.d(XpiPktTxQ4UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1
  
  always @(/*AS*/XpiPktTxEEOPOffsetPsn12S or XpiPktTxEFullChunkPsn11C
	   or XpiPktTxQ5FinalUpdatePsn11C
	   or XpiPktTxQ5NextDescRdPsn11C
	   or XpiPktTxQ5UpdateStatusPsn11C
	   or XpiPktTxQ5UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ5UpdateStatusPsn11C)
	XpiPktTxQ5UsedBufLenPsn11C = {XpiPktTxQ5UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ5FinalUpdatePsn11C && XpiPktTxEFullChunkPsn11C)
	XpiPktTxQ5UsedBufLenPsn11C = {XpiPktTxQ5UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ5FinalUpdatePsn11C && (~XpiPktTxEFullChunkPsn11C))
	XpiPktTxQ5UsedBufLenPsn11C = {XpiPktTxQ5UsedBufLenPsn11S +
