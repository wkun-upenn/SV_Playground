    end // always @ (...
  
DFFR #(16,16'b0) U201_dff (.q(XpiPktTxQ6UsedBufLenPsn11S),.d(XpiPktTxQ6UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3
  
  always @(/*AS*/XpiPktTxEEOPOffsetPsn12S or XpiPktTxEFullChunkPsn11C
	   or XpiPktTxQ7FinalUpdatePsn11C
	   or XpiPktTxQ7NextDescRdPsn11C
	   or XpiPktTxQ7UpdateStatusPsn11C
	   or XpiPktTxQ7UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ7UpdateStatusPsn11C)
	XpiPktTxQ7UsedBufLenPsn11C = {XpiPktTxQ7UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ7FinalUpdatePsn11C && XpiPktTxEFullChunkPsn11C)
	XpiPktTxQ7UsedBufLenPsn11C = {XpiPktTxQ7UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ7FinalUpdatePsn11C && (~XpiPktTxEFullChunkPsn11C))
	XpiPktTxQ7UsedBufLenPsn11C = {XpiPktTxQ7UsedBufLenPsn11S +
				      XpiPktTxEEOPOffsetPsn12S};
      else if (XpiPktTxQ7NextDescRdPsn11C)
