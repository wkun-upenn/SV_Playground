  wire [3:0] 			     XpiPktTxDataN14Psn11C;
  wire [3:0] 			     XpiPktTxDataN15Psn11C;
  wire [`TRDXPI_DATA_WIDTH-1:0]       XpiPktTxDataPsn11C;
  
  //------------------------------
  //---- Register Declaration ----
  //------------------------------
  reg 				     XpiPktTxIFifoWrEnPsn10C;
  reg 				     XpiPktTxEFifoWrEnPsn10C;
  reg [1:0] 			     XpiTrdChunkSendP11S;
  
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxCfgDataPsn12C;
  reg [3:0] 			     XpiPktTxCmdPsn12C;
  
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ0PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ1PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ2PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ3PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ4PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ5PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ6PciAddrPsn11C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ7PciAddrPsn11C;

  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ0StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ1StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ2StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ3StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ4StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ5StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ6StatusRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ7StatusRegPns10C;
  
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxPciAddrPsn12C;
  reg [`PCI_DATA_WIDTH-1:0] 	     XpiPktTxPciDataPsn12C;
  reg [`BYTECNT_WIDTH-1:0] 	     XpiPktTxPciLengthPsn12C;
  reg [`CMD_BE_WIDTH-1:0] 	     XpiPktTxPciByteEnPsn12C;
    
  reg 				     XpiPktTxIngressReqPsn11C;
  reg 				     XpiPktTxIPciArbReqPsn12C;
  reg 				     XpiPktTxSrvCfgRdPns10C;
  reg 				     XpiPktTxQ0DescRdPsn10C;
  reg 				     XpiPktTxQ1DescRdPsn10C;
  reg 				     XpiPktTxQ2DescRdPsn10C;
  reg 				     XpiPktTxQ3DescRdPsn10C;
  reg 				     XpiPktTxIDescRdPendingPsn10C ;
  reg 				     XpiPktTxIDescPh1WrEnPsn10C;
  reg 				     XpiPktTxIDescPh2WrEnPsn10C;
  reg 				     XpiPktTxIDescWrIrdyPsn11C;
  reg 				     XpiPktTxIDescWrBackEn1Psn10C ;
  reg 				     XpiPktTxIDescWrBackEn2Psn10C ;
  reg 				     XpiPktTxIAddrIrdyPsn11C;
  reg 				     XpiPktTxIDataIrdyPsn11C;
  reg 				     XpiPktTxIFifoRdEnPsn10C;
  reg 				     XpiPktTxIDataRdStatePsn11C;
  reg 				     XpiPktTxIDataStallPsn11C;
  reg 				     XpiPktTxILastChunkPsn11C;
  reg 				     XpiPktTxIChunkSendPsn11C;
  reg 				     XpiPktTxIKillPsn11C;

  reg 				     XpiPktTxEgressReqPsn11C;
  reg 				     XpiPktTxEPciArbReqPsn12C;
  reg 				     XpiPktTxQ4DescRdPsn10C;
  reg 				     XpiPktTxQ5DescRdPsn10C;
  reg 				     XpiPktTxQ6DescRdPsn10C;
  reg 				     XpiPktTxQ7DescRdPsn10C;
  reg 				     XpiPktTxEDescPh1WrEnPsn10C;
  reg 				     XpiPktTxEDescPh2WrEnPsn10C;
  reg 				     XpiPktTxEDescWrIrdyPsn11C;
  reg 				     XpiPktTxEDescWrBackEn1Psn10C;
  reg 				     XpiPktTxEDescWrBackEn2Psn10C;
  reg 				     XpiPktTxEAddrIrdyPsn11C;
  reg 				     XpiPktTxEDataIrdyPsn11C;
  reg 				     XpiPktTxEFifoRdEnPsn10C;
  reg 				     XpiPktTxEDataRdStatePsn11C;
  reg 				     XpiPktTxEDataStallPsn11C;
  reg 				     XpiPktTxELastChunkPsn11C;
  reg 				     XpiPktTxEChunkSendPsn11C;
  reg 				     XpiPktTxEKillPsn11C;
  
  reg 				     XpiPktTxIngressGoPsn11C;
  reg 				     XpiPktTxEgressGoPsn11C;
  
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ0AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ1AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ2AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ3AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ4AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ5AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ6AddressRegPns10C;
  reg [`CFG_WIDTH-1:0] 		     XpiPktTxQ7AddressRegPns10C;
  
  reg [3:0] 			     XpiPktTxDataCntPsn11C;
  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ0UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ1UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ2UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ3UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ4UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ5UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ6UsedBufLenPsn11C;  
  reg [`AVAIL_BUFFER_LENGTH-1:0]     XpiPktTxQ7UsedBufLenPsn11C;  
    
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ0DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ1DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ2DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ3DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ4DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ5DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ6DescPtrRegPns11C;
  reg [`DESC_WIDTH-1:0] 	     XpiPktTxQ7DescPtrRegPns11C;

  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ0PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ1PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ2PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ3PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ4PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ5PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ6PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ7PktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ0IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ1IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ2IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ3IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ4IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ5IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ6IntrPktCntPsn11C;
  reg [`XPI_MAX_NUM_PKTS-1:0] 	     XpiPktTxQ7IntrPktCntPsn11C;
  reg [`PKTTX_INTR_EVENTS-1:0] 	     XpiPktTxPciIntrPsn13C;
  
  reg 				     XpiPktTxQ0ValidPns10C;
  reg 				     XpiPktTxQ1ValidPns10C;
  reg 				     XpiPktTxQ2ValidPns10C;
  reg 				     XpiPktTxQ3ValidPns10C;
  reg 				     XpiPktTxQ4ValidPns10C;
  reg 				     XpiPktTxQ5ValidPns10C;
  reg 				     XpiPktTxQ6ValidPns10C;
  reg 				     XpiPktTxQ7ValidPns10C;

  reg 				     XpiPktTxQ0SetSOPPns11C;
  reg 				     XpiPktTxQ0SetEOPPns11C;
  reg 				     XpiPktTxQ0SetSOPEOPPns11C;
  reg 				     XpiPktTxQ0UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ1SetSOPPns11C;
  reg 				     XpiPktTxQ1SetEOPPns11C;
  reg 				     XpiPktTxQ1SetSOPEOPPns11C;
  reg 				     XpiPktTxQ1UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ2SetSOPPns11C;
  reg 				     XpiPktTxQ2SetEOPPns11C;
  reg 				     XpiPktTxQ2SetSOPEOPPns11C;
  reg 				     XpiPktTxQ2UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ3SetSOPPns11C;
  reg 				     XpiPktTxQ3SetEOPPns11C;
  reg 				     XpiPktTxQ3SetSOPEOPPns11C;
  reg 				     XpiPktTxQ3UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ4SetSOPPns11C;
  reg 				     XpiPktTxQ4SetEOPPns11C;
  reg 				     XpiPktTxQ4SetSOPEOPPns11C;
  reg 				     XpiPktTxQ4UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ5SetSOPPns11C;
  reg 				     XpiPktTxQ5SetEOPPns11C;
  reg 				     XpiPktTxQ5SetSOPEOPPns11C;
  reg 				     XpiPktTxQ5UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ6SetSOPPns11C;
  reg 				     XpiPktTxQ6SetEOPPns11C;
  reg 				     XpiPktTxQ6SetSOPEOPPns11C;
  reg 				     XpiPktTxQ6UnSetSOPEOPPns11C;
  reg 				     XpiPktTxQ7SetSOPPns11C;
  reg 				     XpiPktTxQ7SetEOPPns11C;
  reg 				     XpiPktTxQ7SetSOPEOPPns11C;
  reg 				     XpiPktTxQ7UnSetSOPEOPPns11C;

  integer              i;

  // Assumption: At least One descriptor for every packet, a packet can
  // straddle across multiple descriptors, however a descriptor will not
  // have multiple packets
  
  //==================================
  //======== PCI CLOCK DOMAIN ========
  //==================================
  
  //mpp <clock=XpiPciClk, reset=GlCoreResetR00C>
  
  //------------------------------------------------
  //---- PCI-App to Pkt Tx Input Register Stage ----
  //------------------------------------------------
  
DFFR #(64,64'b0) U1_dff (.q(XpiPktTxDataPns10S),.d(XpiPciAppPktTxDataP11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxAddrPns10C = (XpiPktTxCtlWrTxnPns10C || XpiPktTxCtlRdTxnPns10C) ?
				XpiPciAppPktTxAddrP11S : XpiPktTxAddrPns10S;
  
DFFR #(64,64'b0) U2_dff (.q(XpiPktTxAddrPns10S),.d(XpiPktTxAddrPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  	                         
  assign XpiPktTxCfgDataPns10S = XpiPktTxDataPns10S[`PCI_DATA_WIDTH/2-1:0];
  
  //** Note: Initially Control Register WR/RD Control and
  //** PKT TX Operation State Machines were seperate, however in
  //** order to account for the situation when Control Register Read
  //** occurs during FIFO Read Operation, since Datapath for both Reads
  //** is shared, combining two SM's and asserting back pressure (trdy)
  //** for Control Register Read during Fifo Read Operation
  
  //========================================
  //==== Pkt Tx Control Register Write  ====
  //========================================

  // Control Register Write Enable Determination
  assign XpiPktTxCtlWrTxnPns10C = ( (XpiPciAppPktTxAddrIrdyP11S) && 
				    (XpiPciAppPktTxCmdP11S == `CTRLWR) && 
				    (XpiPciAppPktTxValidTxnP11S) );

DFFR #(1,1'b0) U3_dff (.q(XpiPktTxCtlWrTxnPns10S),.d(XpiPktTxCtlWrTxnPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxSrvCfgWrPns10C = (XpiPktTxCtlWrTxnPns10S && 
				   XpiPciAppPktTxDataIrdyP11S &&
				   XpiPciAppPktTxValidTxnP11S);

DFFR #(1,1'b0) U4_dff (.q(XpiPktTxSrvCfgWrPns10S),.d(XpiPktTxSrvCfgWrPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Ingress CPU Queue 0 Control Registers ----
  //-----------------------------------------------

  // Command
  assign XpiPktTxQ0CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'h70));
  
  assign XpiPktTxQ0CommandRegPns10C = XpiPktTxQ0CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ0CommandRegPns10S;
  
DFFR #(32,32'b0) U5_dff (.q(XpiPktTxQ0CommandRegPns10S),.d(XpiPktTxQ0CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Address Register Update
  // Update the Address register for a New Register Write and to the Address
  // of the Next Descriptor to be read after the Write Back of Current
  // Descriptor to CPU Memory occurs
  
  assign XpiPktTxQ0AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'h74));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ0AddrRegWrValidPns10C
	   or XpiPktTxQ0AddressRegPns10S or XpiPktTxQ0DescPtrRegPns11S
	   or XpiPktTxQ0DescWrBackPsn12C)
    begin
      if (XpiPktTxQ0AddrRegWrValidPns10C)
	XpiPktTxQ0AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ0DescWrBackPsn12C)
	XpiPktTxQ0AddressRegPns10C = XpiPktTxQ0DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ0AddressRegPns10C = XpiPktTxQ0AddressRegPns10S;
    end // always @ (...
  
DFFR #(32,32'b0) U6_dff (.q(XpiPktTxQ0AddressRegPns10S),.d(XpiPktTxQ0AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Status Register Update
  
  always @(/*AS*/XpiPktTxQ0DescASICOwnerPns11C
	   or XpiPktTxQ0DescWrPns11S or XpiPktTxQ0FinalUpdatePsn11S
	   or XpiPktTxQ0PktCntPsn11S or XpiPktTxQ0RunSetPns10C
	   or XpiPktTxQ0StatusRegPns10S)
    begin
      if (XpiPktTxQ0RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ0StatusRegPns10C = {XpiPktTxQ0StatusRegPns10S[31:1],1'b1};
      else if (XpiPktTxQ0FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ0StatusRegPns10C = {XpiPktTxQ0StatusRegPns10S[31:22],XpiPktTxQ0PktCntPsn11S,1'b1};
      else if (XpiPktTxQ0DescWrPns11S && (~XpiPktTxQ0DescASICOwnerPns11C))
	// No Buffer Avail Condition
	XpiPktTxQ0StatusRegPns10C = {XpiPktTxQ0StatusRegPns10S[31:23],1'b1,
				     XpiPktTxQ0StatusRegPns10S[21:1],1'b0};
      else if (XpiPktTxQ0DescWrPns11S && XpiPktTxQ0DescASICOwnerPns11C)
	// Resetting No Buffer Avail Bit
	XpiPktTxQ0StatusRegPns10C = {XpiPktTxQ0StatusRegPns10S[31:23],1'b0,
				     XpiPktTxQ0StatusRegPns10S[21:1],1'b1};
      else
	XpiPktTxQ0StatusRegPns10C = XpiPktTxQ0StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U7_dff (.q(XpiPktTxQ0StatusRegPns10S),.d(XpiPktTxQ0StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Ingress CPU Queue 1 Control Registers ----
  //-----------------------------------------------
  
  // Command
  assign XpiPktTxQ1CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'h80));
  
  assign XpiPktTxQ1CommandRegPns10C = XpiPktTxQ1CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ1CommandRegPns10S;
DFFR #(32,32'b0) U8_dff (.q(XpiPktTxQ1CommandRegPns10S),.d(XpiPktTxQ1CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Address
  assign XpiPktTxQ1AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'h84));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ1AddrRegWrValidPns10C
	   or XpiPktTxQ1AddressRegPns10S or XpiPktTxQ1DescPtrRegPns11S
	   or XpiPktTxQ1DescWrBackPsn12C)
    begin
      if (XpiPktTxQ1AddrRegWrValidPns10C)
	XpiPktTxQ1AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ1DescWrBackPsn12C)
	XpiPktTxQ1AddressRegPns10C = XpiPktTxQ1DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ1AddressRegPns10C = XpiPktTxQ1AddressRegPns10S;
    end // always @ (...

DFFR #(32,32'b0) U9_dff (.q(XpiPktTxQ1AddressRegPns10S),.d(XpiPktTxQ1AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Status Register Update

  always @(/*AS*/XpiPktTxQ1FinalUpdatePsn11S or XpiPktTxQ1PktCntPsn11S
	   or XpiPktTxQ1RunSetPns10C or XpiPktTxQ1StatusRegPns10S)
    begin
      if (XpiPktTxQ1RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ1StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ1FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ1StatusRegPns10C = {{10{1'b0}},XpiPktTxQ1PktCntPsn11S,1'b1};
      else
	XpiPktTxQ1StatusRegPns10C = XpiPktTxQ1StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U10_dff (.q(XpiPktTxQ1StatusRegPns10S),.d(XpiPktTxQ1StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Ingress CPU Queue 2 Control Registers ----
  //-----------------------------------------------
  
  // Command
  assign XpiPktTxQ2CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'h90));
  
  assign XpiPktTxQ2CommandRegPns10C = XpiPktTxQ2CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ2CommandRegPns10S;
DFFR #(32,32'b0) U11_dff (.q(XpiPktTxQ2CommandRegPns10S),.d(XpiPktTxQ2CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Address
  assign XpiPktTxQ2AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'h94));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ2AddrRegWrValidPns10C
	   or XpiPktTxQ2AddressRegPns10S or XpiPktTxQ2DescPtrRegPns11S
	   or XpiPktTxQ2DescWrBackPsn12C)
    begin
      if (XpiPktTxQ2AddrRegWrValidPns10C)
	XpiPktTxQ2AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ2DescWrBackPsn12C)
	XpiPktTxQ2AddressRegPns10C = XpiPktTxQ2DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ2AddressRegPns10C = XpiPktTxQ2AddressRegPns10S;
    end // always @ (...
  
DFFR #(32,32'b0) U12_dff (.q(XpiPktTxQ2AddressRegPns10S),.d(XpiPktTxQ2AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Status Register Update

  always @(/*AS*/XpiPktTxQ2FinalUpdatePsn11S or XpiPktTxQ2PktCntPsn11S
	   or XpiPktTxQ2RunSetPns10C or XpiPktTxQ2StatusRegPns10S)
    begin
      if (XpiPktTxQ2RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ2StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ2FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ2StatusRegPns10C = {{10{1'b0}},XpiPktTxQ2PktCntPsn11S,1'b1};
      else
	XpiPktTxQ2StatusRegPns10C = XpiPktTxQ2StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U13_dff (.q(XpiPktTxQ2StatusRegPns10S),.d(XpiPktTxQ2StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Ingress CPU Queue 3 Control Registers ----
  //-----------------------------------------------
  
  // Command
  assign XpiPktTxQ3CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'ha0));
  
  assign XpiPktTxQ3CommandRegPns10C = XpiPktTxQ3CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ3CommandRegPns10S;
DFFR #(32,32'b0) U14_dff (.q(XpiPktTxQ3CommandRegPns10S),.d(XpiPktTxQ3CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
