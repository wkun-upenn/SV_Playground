	// Reset Length after Descriptor Write Back
	XpiPktTxQ5UsedBufLenPsn11C = {`AVAIL_BUFFER_LENGTH{1'b0}};
      else
	XpiPktTxQ5UsedBufLenPsn11C = XpiPktTxQ5UsedBufLenPsn11S;
    end // always @ (...
  
DFFR #(16,16'b0) U200_dff (.q(XpiPktTxQ5UsedBufLenPsn11S),.d(XpiPktTxQ5UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2
  
  always @(/*AS*/XpiPktTxEEOPOffsetPsn12S or XpiPktTxEFullChunkPsn11C
	   or XpiPktTxQ6FinalUpdatePsn11C
	   or XpiPktTxQ6NextDescRdPsn11C
	   or XpiPktTxQ6UpdateStatusPsn11C
	   or XpiPktTxQ6UsedBufLenPsn11S)
    begin      
      if (XpiPktTxQ6UpdateStatusPsn11C)
	XpiPktTxQ6UsedBufLenPsn11C = {XpiPktTxQ6UsedBufLenPsn11S +
				      `AVAIL_BUFFER_LENGTH'h0040};
      else if (XpiPktTxQ6FinalUpdatePsn11C && XpiPktTxEFullChunkPsn11C)
	XpiPktTxQ6UsedBufLenPsn11C = {XpiPktTxQ6UsedBufLenPsn11S +
