    end // always @ (...
  
DFFR #(16,16'b0) U202_dff (.q(XpiPktTxQ7UsedBufLenPsn11S),.d(XpiPktTxQ7UsedBufLenPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //================================================
  //==== PKT TX INGRESS QUEUE ASYNCHRONOUS FIFO ====
  //================================================
  
ASYNCFIFO #(`PKTTXFIFO_DATA_WIDTH, `PKTTXFIFO_DEPTH, `PKTTXFIFO_PTR_WIDTH) XPIPKTTXIFIFO ( .RESET_RDCLK(GlCoreResetR00C), .RESET_WRCLK(GlCoreResetR00C), .WRCLK(XpiCoreClk), .RDCLK(XpiPciClk), .WRITE(XpiPktTxIFifoWrEnPsn10C), .READ(XpiPktTxIFifoRdEnPsn11C), .WRDATA(XpiPktTxIFifoWrDataPsn10S), .RDDATA(XpiPktTxIFifoRdDataPsn11C), .EMPTY(XpiPktTxIFifoEFPsn11C), .FULL(XpiPktTxIFifoFFPsn10C), .RDPTR_WRCLK(XpiPktTxIFifoRdPtrPsn10C), .WRPTR_WRCLK(XpiPktTxIFifoWrPtrPsn10C), .RDPTR_RDCLK(XpiPktTxIFifoRdPtrPsn11C), .WRPTR_RDCLK(XpiPktTxIFifoWrPtrPsn11C));







DFFR #(1,1'b0) U203_dff (.q(XpiPktTxIFifoEFPsn11S),.d(XpiPktTxIFifoEFPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //=============+=================================
  //==== PKT TX EGRESS QUEUE ASYNCHRONOUS FIFO ====
  //===============================================
  
ASYNCFIFO #(`PKTTXFIFO_DATA_WIDTH, `PKTTXFIFO_DEPTH, `PKTTXFIFO_PTR_WIDTH) XPIPKTTXEFIFO ( .RESET_RDCLK(GlCoreResetR00C), .RESET_WRCLK(GlCoreResetR00C), .WRCLK(XpiCoreClk), .RDCLK(XpiPciClk), .WRITE(XpiPktTxEFifoWrEnPsn10C), .READ(XpiPktTxEFifoRdEnPsn11C), .WRDATA(XpiPktTxEFifoWrDataPsn10S), .RDDATA(XpiPktTxEFifoRdDataPsn11C), .EMPTY(XpiPktTxEFifoEFPsn11C), .FULL(XpiPktTxEFifoFFPsn10C), .RDPTR_WRCLK(XpiPktTxEFifoRdPtrPsn10C), .WRPTR_WRCLK(XpiPktTxEFifoWrPtrPsn10C), .RDPTR_RDCLK(XpiPktTxEFifoRdPtrPsn11C), .WRPTR_RDCLK(XpiPktTxEFifoWrPtrPsn11C));







DFFR #(1,1'b0) U204_dff (.q(XpiPktTxEFifoEFPsn11S),.d(XpiPktTxEFifoEFPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //--------------------------------
  //---- PKTTX FIFO Read Enable ----
  //--------------------------------
  // Read Enable is only asserted when PCI Application
  // is ready to accept the Data. Because of Back pressure
  // mechanism this special control is required to generate
  // the Read Enable

  // Ingress Fifo
  
  assign XpiPktTxIFifoRdEnM0Psn11C = ((XpiPciAppPktTxTrdyP10S)   && 
		      		      (~XpiPciAppPktTxTrdyP11S)  && 
		      		      (~XpiPktTxIFifoEFPsn11C)   &&
		      		      (XpiPktTxIDataStallPsn11C));
  
  assign XpiPktTxIFifoRdEnM1Psn11C = ((XpiPktTxIFifoRdEnPsn10C) && 
				      (XpiPciAppPktTxTrdyP10S)  && 
				      (~XpiPktTxIFifoEFPsn11C));
  
MUX2 #(1) U205_mux2 (.mo(XpiPktTxIFifoRdEnPsn11C),.in0(XpiPktTxIFifoRdEnM0Psn11C),.in1(XpiPktTxIFifoRdEnM1Psn11C),.sel(XpiPciAppPktTxTrdyP11S));


  // Egress Fifo
     
  assign XpiPktTxEFifoRdEnM0Psn11C = ((XpiPciAppPktTxTrdyP10S)   && 
		      		      (~XpiPciAppPktTxTrdyP11S)  && 
		      		      (~XpiPktTxEFifoEFPsn11C)   &&
		      		      (XpiPktTxEDataStallPsn11C));
  
  assign XpiPktTxEFifoRdEnM1Psn11C = ((XpiPktTxEFifoRdEnPsn10C) && 
				      (XpiPciAppPktTxTrdyP10S)  && 
				      (~XpiPktTxEFifoEFPsn11C));
  
MUX2 #(1) U206_mux2 (.mo(XpiPktTxEFifoRdEnPsn11C),.in0(XpiPktTxEFifoRdEnM0Psn11C),.in1(XpiPktTxEFifoRdEnM1Psn11C),.sel(XpiPciAppPktTxTrdyP11S));

  
  
  //----------------------------------
  //---- Write Address Generation ----
  //----------------------------------
  // Address for Write Transaction needs to be 
  // incremented after each Chunk Transfer to point to
  // subsequent entry in CPU Data Buffer
  
  // Ingress Queue 0
  
  always @(/*AS*/XpiPktTxQ0DescPtrRegPns11S or XpiPktTxQ0DescWrPns11S
	   or XpiPktTxQ0FinalUpdatePsn11C or XpiPktTxQ0PciAddrPsn11S
	   or XpiPktTxQ0UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ0DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ0PciAddrPsn11C = XpiPktTxQ0DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ0UpdateStatusPsn11C || XpiPktTxQ0FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ0PciAddrPsn11C = {XpiPktTxQ0PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ0PciAddrPsn11C = XpiPktTxQ0PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U207_dff (.q(XpiPktTxQ0PciAddrPsn11S),.d(XpiPktTxQ0PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 1

  always @(/*AS*/XpiPktTxQ1DescPtrRegPns11S or XpiPktTxQ1DescWrPns11S
	   or XpiPktTxQ1FinalUpdatePsn11C or XpiPktTxQ1PciAddrPsn11S
	   or XpiPktTxQ1UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ1DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ1PciAddrPsn11C = XpiPktTxQ1DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ1UpdateStatusPsn11C || XpiPktTxQ1FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ1PciAddrPsn11C = {XpiPktTxQ1PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ1PciAddrPsn11C = XpiPktTxQ1PciAddrPsn11S;
    end // always @ (...
  
DFFR #(32,32'b0) U208_dff (.q(XpiPktTxQ1PciAddrPsn11S),.d(XpiPktTxQ1PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 2

  always @(/*AS*/XpiPktTxQ2DescPtrRegPns11S or XpiPktTxQ2DescWrPns11S
	   or XpiPktTxQ2FinalUpdatePsn11C or XpiPktTxQ2PciAddrPsn11S
	   or XpiPktTxQ2UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ2DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ2PciAddrPsn11C = XpiPktTxQ2DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ2UpdateStatusPsn11C || XpiPktTxQ2FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ2PciAddrPsn11C = {XpiPktTxQ2PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ2PciAddrPsn11C = XpiPktTxQ2PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U209_dff (.q(XpiPktTxQ2PciAddrPsn11S),.d(XpiPktTxQ2PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 3
  
  always @(/*AS*/XpiPktTxQ3DescPtrRegPns11S or XpiPktTxQ3DescWrPns11S
	   or XpiPktTxQ3FinalUpdatePsn11C or XpiPktTxQ3PciAddrPsn11S
	   or XpiPktTxQ3UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ3DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ3PciAddrPsn11C = XpiPktTxQ3DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ3UpdateStatusPsn11C || XpiPktTxQ3FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ3PciAddrPsn11C = {XpiPktTxQ3PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ3PciAddrPsn11C = XpiPktTxQ3PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U210_dff (.q(XpiPktTxQ3PciAddrPsn11S),.d(XpiPktTxQ3PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0
  
  always @(/*AS*/XpiPktTxQ4DescPtrRegPns11S or XpiPktTxQ4DescWrPns11S
	   or XpiPktTxQ4FinalUpdatePsn11C or XpiPktTxQ4PciAddrPsn11S
	   or XpiPktTxQ4UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ4DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ4PciAddrPsn11C = XpiPktTxQ4DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ4UpdateStatusPsn11C || XpiPktTxQ4FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ4PciAddrPsn11C = {XpiPktTxQ4PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ4PciAddrPsn11C = XpiPktTxQ4PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U211_dff (.q(XpiPktTxQ4PciAddrPsn11S),.d(XpiPktTxQ4PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1
  
  always @(/*AS*/XpiPktTxQ5DescPtrRegPns11S or XpiPktTxQ5DescWrPns11S
	   or XpiPktTxQ5FinalUpdatePsn11C or XpiPktTxQ5PciAddrPsn11S
	   or XpiPktTxQ5UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ5DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ5PciAddrPsn11C = XpiPktTxQ5DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ5UpdateStatusPsn11C || XpiPktTxQ5FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ5PciAddrPsn11C = {XpiPktTxQ5PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ5PciAddrPsn11C = XpiPktTxQ5PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U212_dff (.q(XpiPktTxQ5PciAddrPsn11S),.d(XpiPktTxQ5PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2
  
  always @(/*AS*/XpiPktTxQ6DescPtrRegPns11S or XpiPktTxQ6DescWrPns11S
	   or XpiPktTxQ6FinalUpdatePsn11C or XpiPktTxQ6PciAddrPsn11S
	   or XpiPktTxQ6UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ6DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ6PciAddrPsn11C = XpiPktTxQ6DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ6UpdateStatusPsn11C || XpiPktTxQ6FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ6PciAddrPsn11C = {XpiPktTxQ6PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ6PciAddrPsn11C = XpiPktTxQ6PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U213_dff (.q(XpiPktTxQ6PciAddrPsn11S),.d(XpiPktTxQ6PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3
  
  always @(/*AS*/XpiPktTxQ7DescPtrRegPns11S or XpiPktTxQ7DescWrPns11S
	   or XpiPktTxQ7FinalUpdatePsn11C or XpiPktTxQ7PciAddrPsn11S
	   or XpiPktTxQ7UpdateStatusPsn11C)
    begin
      if (XpiPktTxQ7DescWrPns11S)
	// Address update after New Descriptor Write
	XpiPktTxQ7PciAddrPsn11C = XpiPktTxQ7DescPtrRegPns11S[`DESC_WIDTH-1:`DESC_WIDTH-32];
      else if (XpiPktTxQ7UpdateStatusPsn11C || XpiPktTxQ7FinalUpdatePsn11C)
	// Chunk transferred, Increment Address
	XpiPktTxQ7PciAddrPsn11C = {XpiPktTxQ7PciAddrPsn11S + `CFG_WIDTH'h00000040};
      else
	XpiPktTxQ7PciAddrPsn11C = XpiPktTxQ7PciAddrPsn11S;
    end // always @ (...

DFFR #(32,32'b0) U214_dff (.q(XpiPktTxQ7PciAddrPsn11S),.d(XpiPktTxQ7PciAddrPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //-----------------------------------------
  //---- Pkt Tx -> PCI App Output Stage -----
  //-----------------------------------------

  //---- Address Irdy Selection ----
  
  assign XpiPktTxPciAddrIrdyPsn12C = 
	 (XpiPktTxQ0DescRdPsn10C || XpiPktTxQ1DescRdPsn10C || 
	  XpiPktTxQ2DescRdPsn10C || XpiPktTxQ3DescRdPsn10C || 
	  XpiPktTxQ4DescRdPsn10C || XpiPktTxQ5DescRdPsn10C ||
	  XpiPktTxQ6DescRdPsn10C || XpiPktTxQ7DescRdPsn10C ||
	  XpiPktTxAddrIrdyPsn11C || XpiPktTxDescWrBackEn1Psn10C);
  
  //---- Data Irdy Selection ----
  
  // Muxing Data Irdy for Write Txn & Control Read Completion
  
DFFR #(1,1'b0) U215_dff (.q(XpiPktTxSrvCfgRdPsn11S),.d(XpiPktTxSrvCfgRdPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxDataIrdyPsn12C = 
	 (XpiPktTxDataIrdyPsn11C || (XpiPktTxDescWrIrdyPsn11C && XpiPktTxPktCmpltPsn12C));
  
DFFR #(1,1'b0) U216_dff (.q(XpiPktTxDataIrdyPsn12S),.d(XpiPktTxDataIrdyPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxPciDataIrdyPsn13S = XpiPktTxSrvCfgRdPsn11S ?
	 XpiPktTxSrvCfgRdPsn11S : XpiPktTxDataIrdyPsn12S;
  
  //---- Command Selection ----
  
  always @(/*AS*/XpiPktTxAddrIrdyPsn11C or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxPciCmdPsn13S or XpiPktTxQ0DescRdPsn10C
	   or XpiPktTxQ1DescRdPsn10C or XpiPktTxQ2DescRdPsn10C
	   or XpiPktTxQ3DescRdPsn10C or XpiPktTxQ4DescRdPsn10C
	   or XpiPktTxQ5DescRdPsn10C or XpiPktTxQ6DescRdPsn10C
	   or XpiPktTxQ7DescRdPsn10C or XpiPktTxSrvCfgRdPns10C)
    begin
      if (XpiPktTxQ0DescRdPsn10C ||
	  XpiPktTxQ1DescRdPsn10C ||
	  XpiPktTxQ2DescRdPsn10C ||
	  XpiPktTxQ3DescRdPsn10C ||
	  XpiPktTxQ4DescRdPsn10C ||
	  XpiPktTxQ5DescRdPsn10C ||
	  XpiPktTxQ6DescRdPsn10C ||
	  XpiPktTxQ7DescRdPsn10C)
	XpiPktTxCmdPsn12C = `MEMRDLINE;
      else if (XpiPktTxAddrIrdyPsn11C || XpiPktTxDescWrBackEn1Psn10C)
	XpiPktTxCmdPsn12C = `MEMWR;
      else if (XpiPktTxSrvCfgRdPns10C)
	XpiPktTxCmdPsn12C = `RDCMP;
      else
	XpiPktTxCmdPsn12C = XpiPktTxPciCmdPsn13S;
    end
    
  //---- Address Selection ----
  
  always @(/*AS*/XpiPktTxAddrIrdyPsn11C or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxPciAddrPsn12S or XpiPktTxQ0ActivePsn11C
	   or XpiPktTxQ0AddressRegPns10S or XpiPktTxQ0DescPtrRegPns11S
	   or XpiPktTxQ0DescRdPsn10C or XpiPktTxQ0DescWrBackPsn12C
	   or XpiPktTxQ0NextDescRdPsn14S or XpiPktTxQ0PciAddrPsn11S
	   or XpiPktTxQ1ActivePsn11C or XpiPktTxQ1AddressRegPns10S
	   or XpiPktTxQ1DescPtrRegPns11S or XpiPktTxQ1DescRdPsn10C
	   or XpiPktTxQ1DescWrBackPsn12C or XpiPktTxQ1NextDescRdPsn14S
	   or XpiPktTxQ1PciAddrPsn11S or XpiPktTxQ2ActivePsn11C
	   or XpiPktTxQ2AddressRegPns10S or XpiPktTxQ2DescPtrRegPns11S
	   or XpiPktTxQ2DescRdPsn10C or XpiPktTxQ2DescWrBackPsn12C
	   or XpiPktTxQ2NextDescRdPsn14S or XpiPktTxQ2PciAddrPsn11S
	   or XpiPktTxQ3ActivePsn11C or XpiPktTxQ3AddressRegPns10S
	   or XpiPktTxQ3DescPtrRegPns11S or XpiPktTxQ3DescRdPsn10C
	   or XpiPktTxQ3DescWrBackPsn12C or XpiPktTxQ3NextDescRdPsn14S
	   or XpiPktTxQ3PciAddrPsn11S or XpiPktTxQ4ActivePsn11C
	   or XpiPktTxQ4AddressRegPns10S or XpiPktTxQ4DescPtrRegPns11S
	   or XpiPktTxQ4DescRdPsn10C or XpiPktTxQ4DescWrBackPsn12C
	   or XpiPktTxQ4NextDescRdPsn14S or XpiPktTxQ4PciAddrPsn11S
	   or XpiPktTxQ5ActivePsn11C or XpiPktTxQ5AddressRegPns10S
	   or XpiPktTxQ5DescPtrRegPns11S or XpiPktTxQ5DescRdPsn10C
	   or XpiPktTxQ5DescWrBackPsn12C or XpiPktTxQ5NextDescRdPsn14S
	   or XpiPktTxQ5PciAddrPsn11S or XpiPktTxQ6ActivePsn11C
	   or XpiPktTxQ6AddressRegPns10S or XpiPktTxQ6DescPtrRegPns11S
	   or XpiPktTxQ6DescRdPsn10C or XpiPktTxQ6DescWrBackPsn12C
	   or XpiPktTxQ6NextDescRdPsn14S or XpiPktTxQ6PciAddrPsn11S
	   or XpiPktTxQ7ActivePsn11C or XpiPktTxQ7AddressRegPns10S
	   or XpiPktTxQ7DescPtrRegPns11S or XpiPktTxQ7DescRdPsn10C
	   or XpiPktTxQ7DescWrBackPsn12C or XpiPktTxQ7NextDescRdPsn14S
	   or XpiPktTxQ7PciAddrPsn11S)
    begin
      // Head Descriptor Read, address supplied by Address register
      if (XpiPktTxQ0DescRdPsn10C && (~XpiPktTxQ0NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ0AddressRegPns10S;
      else if (XpiPktTxQ1DescRdPsn10C && (~XpiPktTxQ1NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ1AddressRegPns10S;
      else if (XpiPktTxQ2DescRdPsn10C && (~XpiPktTxQ2NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ2AddressRegPns10S;
      else if (XpiPktTxQ3DescRdPsn10C && (~XpiPktTxQ3NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ3AddressRegPns10S;
      else if (XpiPktTxQ4DescRdPsn10C && (~XpiPktTxQ4NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ4AddressRegPns10S;
      else if (XpiPktTxQ5DescRdPsn10C && (~XpiPktTxQ5NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ5AddressRegPns10S;
      else if (XpiPktTxQ6DescRdPsn10C && (~XpiPktTxQ6NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ6AddressRegPns10S;
      else if (XpiPktTxQ7DescRdPsn10C && (~XpiPktTxQ7NextDescRdPsn14S))
	XpiPktTxPciAddrPsn12C = XpiPktTxQ7AddressRegPns10S;

      // Subsequent Descriptor reads, address supplied by existing descriptor
      else if (XpiPktTxQ0DescRdPsn10C && XpiPktTxQ0NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ0DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ1DescRdPsn10C && XpiPktTxQ1NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ1DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ2DescRdPsn10C && XpiPktTxQ2NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ2DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ3DescRdPsn10C && XpiPktTxQ3NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ3DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ4DescRdPsn10C && XpiPktTxQ4NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ4DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ5DescRdPsn10C && XpiPktTxQ5NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ5DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ6DescRdPsn10C && XpiPktTxQ6NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ6DescPtrRegPns11S[95:64];
      else if (XpiPktTxQ7DescRdPsn10C && XpiPktTxQ7NextDescRdPsn14S)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ7DescPtrRegPns11S[95:64];

      // Packet Data Write, Buffer address provided by the descriptor
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ0ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ0PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ1ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ1PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ2ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ2PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ3ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ3PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ4ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ4PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ5ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ5PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ6ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ6PciAddrPsn11S;
      else if (XpiPktTxAddrIrdyPsn11C && XpiPktTxQ7ActivePsn11C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ7PciAddrPsn11S;

      // Descriptor Write back to CPU memory, 
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ0DescWrBackPsn12C)
      	XpiPktTxPciAddrPsn12C = XpiPktTxQ0AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ1DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ1AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ2DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ2AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ3DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ3AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ4DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ4AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ5DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ5AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ6DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ6AddressRegPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ7DescWrBackPsn12C)
	XpiPktTxPciAddrPsn12C = XpiPktTxQ7AddressRegPns10S;
      else
	XpiPktTxPciAddrPsn12C = XpiPktTxPciAddrPsn12S;
    end // always @ (...
  
DFFR #(32,32'b0) U217_dff (.q(XpiPktTxPciAddrPsn12S),.d(XpiPktTxPciAddrPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
    
  //---- Data Selection ----
  
  always @(/*AS*/XpiPktTxCfgDataPsn12C or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxDescWrBackEn2Psn10C or XpiPktTxEFifoRdDataPsn11C
	   or XpiPktTxEFifoRdEnPsn11C or XpiPktTxIFifoRdDataPsn11C
	   or XpiPktTxIFifoRdEnPsn11C or XpiPktTxPciDataPsn13S
	   or XpiPktTxQ0DescPtrRegPns11S or XpiPktTxQ0DescWrBackPsn12C
	   or XpiPktTxQ1DescPtrRegPns11S or XpiPktTxQ1DescWrBackPsn12C
	   or XpiPktTxQ2DescPtrRegPns11S or XpiPktTxQ2DescWrBackPsn12C
	   or XpiPktTxQ3DescPtrRegPns11S or XpiPktTxQ3DescWrBackPsn12C
	   or XpiPktTxQ4DescPtrRegPns11S or XpiPktTxQ4DescWrBackPsn12C
	   or XpiPktTxQ5DescPtrRegPns11S or XpiPktTxQ5DescWrBackPsn12C
	   or XpiPktTxQ6DescPtrRegPns11S or XpiPktTxQ6DescWrBackPsn12C
	   or XpiPktTxQ7DescPtrRegPns11S or XpiPktTxQ7DescWrBackPsn12C
	   or XpiPktTxSrvCfgRdPns10C)
    begin
      if (XpiPktTxSrvCfgRdPns10C)
	XpiPktTxPciDataPsn12C = {{`CFG_WIDTH{1'b0}},XpiPktTxCfgDataPsn12C};
      // Ingress Queue Packet Write
      else if (XpiPktTxIFifoRdEnPsn11C)
	XpiPktTxPciDataPsn12C = XpiPktTxIFifoRdDataPsn11C[`PCI_DATA_WIDTH-1:0];
      // Egress Queue Packet Write
      else if (XpiPktTxEFifoRdEnPsn11C)
	XpiPktTxPciDataPsn12C = XpiPktTxEFifoRdDataPsn11C[`PCI_DATA_WIDTH-1:0];
      // Descriptor Write Back to CPU Memory
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ0DescWrBackPsn12C)
      	XpiPktTxPciDataPsn12C = XpiPktTxQ0DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ0DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ0DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ1DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ1DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ1DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ1DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ2DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ2DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ2DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ2DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ3DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ3DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ3DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ3DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ4DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ4DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ4DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ4DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ5DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ5DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ5DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ5DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ6DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ6DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ6DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ6DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ7DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ7DescPtrRegPns11S[`PCI_DATA_WIDTH-1:0];
      else if (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ7DescWrBackPsn12C)
	XpiPktTxPciDataPsn12C = XpiPktTxQ7DescPtrRegPns11S[`DESC_WIDTH-1:`PCI_DATA_WIDTH];
      else
	XpiPktTxPciDataPsn12C = XpiPktTxPciDataPsn13S;
    end // always @ (...

  //---- Length Selection ----
    
  always @(/*AS*/XpiPktTxDataIrdyPsn11C or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxEOPOffsetOctet0Psn11C
	   or XpiPktTxEOPOffsetOctet1Psn11C
	   or XpiPktTxEOPOffsetOctet2Psn11C
	   or XpiPktTxEOPOffsetOctet3Psn11C
	   or XpiPktTxEOPOffsetOctet4Psn11C
	   or XpiPktTxEOPOffsetOctet5Psn11C
	   or XpiPktTxEOPOffsetOctet6Psn11C
	   or XpiPktTxEOPOffsetOctet7Psn11C or XpiPktTxPciLengthPsn13S
	   or XpiPktTxQ0DescRdPsn10C or XpiPktTxQ1DescRdPsn10C
	   or XpiPktTxQ2DescRdPsn10C or XpiPktTxQ3DescRdPsn10C
	   or XpiPktTxQ4DescRdPsn10C or XpiPktTxQ5DescRdPsn10C
	   or XpiPktTxQ6DescRdPsn10C or XpiPktTxQ7DescRdPsn10C)
    begin
      if (XpiPktTxQ0DescRdPsn10C || XpiPktTxQ1DescRdPsn10C ||
	  XpiPktTxQ2DescRdPsn10C || XpiPktTxQ3DescRdPsn10C ||
	  XpiPktTxQ4DescRdPsn10C || XpiPktTxQ5DescRdPsn10C ||
	  XpiPktTxQ6DescRdPsn10C || XpiPktTxQ7DescRdPsn10C)
	// Length = 128B for Descriptor Read
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h010;
      else if (XpiPktTxDescWrBackEn1Psn10C)
	// Descriptor Write, Length = 16B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h010;
      else if (XpiPktTxEOPOffsetOctet0Psn11C)
	// Length = 8B for Last Chunk <=8B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h008;
      else if (XpiPktTxEOPOffsetOctet1Psn11C)
	// Length = 16B for Last Chunk >8B & <=16B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h010;
      else if (XpiPktTxEOPOffsetOctet2Psn11C)
	// Length = 24B for Last Chunk >16B & <=24B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h018;
      else if (XpiPktTxEOPOffsetOctet3Psn11C)
	// Length = 32B for Last Chunk >24B & <=32B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h020;
      else if (XpiPktTxEOPOffsetOctet4Psn11C)
	// Length = 40B for Last Chunk >32B & <=40B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h028;
      else if (XpiPktTxEOPOffsetOctet5Psn11C)
	// Length = 48B for Last Chunk >40B & <=48B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h030;
      else if (XpiPktTxEOPOffsetOctet6Psn11C)
	// Length = 56B for Last Chunk >48B & <=56B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h038;
      else if (XpiPktTxEOPOffsetOctet7Psn11C)
	// Length = 54B for Last Chunk >56B & <=64B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h040;
      //else if (XpiPktTxDataIrdyPsn11C && (~XpiPktTxILastChunkPsn11C))
      else if (XpiPktTxDataIrdyPsn11C)
	// Full Chunk Write, Length = 64B
	XpiPktTxPciLengthPsn12C = `BYTECNT_WIDTH'h040;
      else
	XpiPktTxPciLengthPsn12C = XpiPktTxPciLengthPsn13S;
    end

  //-----------------------------
  //---- Byte Enable Setting ----
  //-----------------------------
  // Byte Enable are required to be set for the last 8B transfer
  // of an odd size packets that are not multiple of 8B
  
  always @ (/*AS*/XpiPktTxDataCntPsn11S or XpiPktTxEEOPOffsetPsn12S
	    or XpiPktTxEOPOffsetOctet0Psn12S
	    or XpiPktTxEOPOffsetOctet1Psn12S
	    or XpiPktTxEOPOffsetOctet2Psn12S
	    or XpiPktTxEOPOffsetOctet3Psn12S
	    or XpiPktTxEOPOffsetOctet4Psn12S
	    or XpiPktTxEOPOffsetOctet5Psn12S
	    or XpiPktTxEOPOffsetOctet6Psn12S
	    or XpiPktTxEOPOffsetOctet7Psn12S
	    or XpiPktTxIEOPOffsetPsn12S or XpiPktTxQ0ActivePsn12S
	    or XpiPktTxQ1ActivePsn12S or XpiPktTxQ2ActivePsn12S
	    or XpiPktTxQ3ActivePsn12S or XpiPktTxQ4ActivePsn12S
	    or XpiPktTxQ5ActivePsn12S or XpiPktTxQ6ActivePsn12S
	    or XpiPktTxQ7ActivePsn12S)
    begin
      
      if   ( ((XpiPktTxEOPOffsetOctet0Psn12S || XpiPktTxEOPOffsetOctet1Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0001))  ||
	     ((XpiPktTxEOPOffsetOctet2Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0010))  ||
	     ((XpiPktTxEOPOffsetOctet3Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0011))  ||
	     ((XpiPktTxEOPOffsetOctet4Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0100))  ||
	     ((XpiPktTxEOPOffsetOctet5Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0101))  ||
	     ((XpiPktTxEOPOffsetOctet6Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0110))  ||
	     ((XpiPktTxEOPOffsetOctet7Psn12S) &&
	      (XpiPktTxDataCntPsn11S==4'b0111)) )

	// ByteEnables are Set to different value than 0xff, during
	// the last 8B Packet Transfer based on EOPOffset value
	
	begin

	  if (XpiPktTxQ0ActivePsn12S || XpiPktTxQ1ActivePsn12S ||
	      XpiPktTxQ2ActivePsn12S || XpiPktTxQ3ActivePsn12S)

	    begin
	      case(XpiPktTxIEOPOffsetPsn12S[2:0])
		3'b000: 
		  XpiPktTxPciByteEnPsn12C = 8'h00;
		3'b001: 
		  XpiPktTxPciByteEnPsn12C = 8'hfe;
		3'b010: 
		  XpiPktTxPciByteEnPsn12C = 8'hfc;
		3'b011: 
		  XpiPktTxPciByteEnPsn12C = 8'hf8;
		3'b100: 
		  XpiPktTxPciByteEnPsn12C = 8'hf0;
		3'b101: 
		  XpiPktTxPciByteEnPsn12C = 8'he0;
		3'b110: 
		  XpiPktTxPciByteEnPsn12C = 8'hc0;
		3'b111: 
		  XpiPktTxPciByteEnPsn12C = 8'h80;
		default:
		  XpiPktTxPciByteEnPsn12C = 8'h00;
	      endcase // case(XpiPktTxIEOPOffsetPsn12S[2:0])
	    end // if (XpiPktTxQ0ActivePsn12S || XpiPktTxQ1ActivePsn12S ||...

	  else if (XpiPktTxQ4ActivePsn12S || XpiPktTxQ5ActivePsn12S ||
		   XpiPktTxQ6ActivePsn12S || XpiPktTxQ7ActivePsn12S)
	    
	    begin
	      case(XpiPktTxEEOPOffsetPsn12S[2:0])
		3'b000: 
		  XpiPktTxPciByteEnPsn12C = 8'h00;
		3'b001: 
		  XpiPktTxPciByteEnPsn12C = 8'hfe;
		3'b010: 
		  XpiPktTxPciByteEnPsn12C = 8'hfc;
		3'b011: 
		  XpiPktTxPciByteEnPsn12C = 8'hf8;
		3'b100: 
		  XpiPktTxPciByteEnPsn12C = 8'hf0;
		3'b101: 
		  XpiPktTxPciByteEnPsn12C = 8'he0;
		3'b110: 
		  XpiPktTxPciByteEnPsn12C = 8'hc0;
		3'b111: 
		  XpiPktTxPciByteEnPsn12C = 8'h80;
		default:
		  XpiPktTxPciByteEnPsn12C = 8'h00;
	      endcase // case(XpiPktTxEEOPOffsetPsn12S[2:0])
	    end // if (XpiPktTxQ4ActivePsn12S || XpiPktTxQ5ActivePsn12S ||...

	  else
	    XpiPktTxPciByteEnPsn12C = 8'h00;

	end // if ( ((XpiPktTxEOPOffsetOctet1Psn12S) &&...

      else
	begin
	  XpiPktTxPciByteEnPsn12C = 8'h00;
	end // else: !if( ((XpiPktTxEOPOffsetOctet1Psn12S) &&...
      
    end // always @ (...
  
  //----------------------------------------------
  //---- PKTTX -> PCI ARB Output Register Set ----
  //----------------------------------------------
  
DFFR #(1,1'b0) U218_dff (.q(XpiPktTxPciAddrIrdyPsn13S),.d(XpiPktTxPciAddrIrdyPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxPciAddrPsn13S = {{`CFG_WIDTH{1'b0}},XpiPktTxPciAddrPsn12S};

DFFR #(4,4'b0) U219_dff (.q(XpiPktTxPciCmdPsn13S),.d(XpiPktTxCmdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
DFFR #(12,12'b0) U220_dff (.q(XpiPktTxPciLengthPsn13S),.d(XpiPktTxPciLengthPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // ReCirculating the Data & ByteEn to account for Trdy Backpressure
  
  assign XpiPktTxPciDataPsn13C = XpiPciAppPktTxTrdyP10S ?
	 XpiPktTxPciDataPsn12C : XpiPktTxPciDataPsn13S;
  
DFFR #(64,64'b0) U221_dff (.q(XpiPktTxPciDataPsn13S),.d(XpiPktTxPciDataPsn13C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxPciByteEnPsn13C = XpiPciAppPktTxTrdyP10S ?
	 XpiPktTxPciByteEnPsn12C : XpiPktTxPciByteEnPsn13S;
  
DFFR #(8,8'b0) U222_dff (.q(XpiPktTxPciByteEnPsn13S),.d(XpiPktTxPciByteEnPsn13C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxPciTrdyPsn13S = 1'b1;

  assign XpiPktTxPciAttrPsn13S = {`PCI_ATTR_WIDTH{1'b0}};

  assign XpiPktTxPciTxnIDPsn13S = TXNID[2:0];

  //-------------------------------
  //---- Global Packet Counter ----
  //-------------------------------
  // Counter counting number of packets transmitted after Reset
  // It can be reset by Setting corresponding bit in the Command Register

  assign XpiPktTxQ0PktCntRstPns11C = 
	 (XpiPktTxQ0CmdRegWrValidPns12S && XpiPktTxQ0ValidPns10C &&
	  XpiPktTxQ0CommandRegPns10S[26]);
  
  // Ingress Queue 0 Packet Counter
  always @(/*AS*/XpiPktTxQ0FinalUpdatePsn11S or XpiPktTxQ0PktCntPsn11S
	   or XpiPktTxQ0PktCntRstPns11C)
    begin
      if (XpiPktTxQ0FinalUpdatePsn11S)
	XpiPktTxQ0PktCntPsn11C = {XpiPktTxQ0PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ0PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ0PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ0PktCntRstPns11C)
	XpiPktTxQ0PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ0PktCntPsn11C = XpiPktTxQ0PktCntPsn11S;
    end // always @ (...

DFFR #(21,21'b0) U223_dff (.q(XpiPktTxQ0PktCntPsn11S),.d(XpiPktTxQ0PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 1 Packet Counter
  assign XpiPktTxQ1PktCntRstPns11C = 
	 (XpiPktTxQ1CmdRegWrValidPns12S && XpiPktTxQ1ValidPns10C && XpiPktTxQ1CommandRegPns10S[26]);

  always @(/*AS*/XpiPktTxQ1FinalUpdatePsn11S or XpiPktTxQ1PktCntPsn11S
	   or XpiPktTxQ1PktCntRstPns11C)
    begin
      if (XpiPktTxQ1FinalUpdatePsn11S)
	XpiPktTxQ1PktCntPsn11C = {XpiPktTxQ1PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ1PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ1PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ1PktCntRstPns11C)
	XpiPktTxQ1PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ1PktCntPsn11C = XpiPktTxQ1PktCntPsn11S;
    end // always @ (...

DFFR #(21,21'b0) U224_dff (.q(XpiPktTxQ1PktCntPsn11S),.d(XpiPktTxQ1PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 2 Packet Counter
  assign XpiPktTxQ2PktCntRstPns11C = (XpiPktTxQ2CmdRegWrValidPns12S &&
				      XpiPktTxQ2ValidPns10C && 
				      XpiPktTxQ2CommandRegPns10S[26]);

  always @(/*AS*/XpiPktTxQ2FinalUpdatePsn11S or XpiPktTxQ2PktCntPsn11S
	   or XpiPktTxQ2PktCntRstPns11C)
    begin
      if (XpiPktTxQ2FinalUpdatePsn11S)
	XpiPktTxQ2PktCntPsn11C = {XpiPktTxQ2PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ2PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ2PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ2PktCntRstPns11C)
	XpiPktTxQ2PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ2PktCntPsn11C = XpiPktTxQ2PktCntPsn11S;
    end // always @ (...

DFFR #(21,21'b0) U225_dff (.q(XpiPktTxQ2PktCntPsn11S),.d(XpiPktTxQ2PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 3 Packet Counter
  assign XpiPktTxQ3PktCntRstPns11C = (XpiPktTxQ3CmdRegWrValidPns12S &&
				      XpiPktTxQ3ValidPns10C && 
				      XpiPktTxQ3CommandRegPns10S[26]);

  always @(/*AS*/XpiPktTxQ3FinalUpdatePsn11S or XpiPktTxQ3PktCntPsn11S
	   or XpiPktTxQ3PktCntRstPns11C)
    begin
      if (XpiPktTxQ3FinalUpdatePsn11S)
	XpiPktTxQ3PktCntPsn11C = {XpiPktTxQ3PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ3PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ3PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ3PktCntRstPns11C)
	XpiPktTxQ3PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ3PktCntPsn11C = XpiPktTxQ3PktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U226_dff (.q(XpiPktTxQ3PktCntPsn11S),.d(XpiPktTxQ3PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0 Packet Counter
  assign XpiPktTxQ4PktCntRstPns11C = (XpiPktTxQ4CmdRegWrValidPns12S &&
				      XpiPktTxQ4CommandRegPns10S[26]);

  always @(/*AS*/XpiPktTxQ4FinalUpdatePsn11S or XpiPktTxQ4PktCntPsn11S
	   or XpiPktTxQ4PktCntRstPns11C)
    begin
      if (XpiPktTxQ4FinalUpdatePsn11S)
	XpiPktTxQ4PktCntPsn11C = {XpiPktTxQ4PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ4PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ4PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ4PktCntRstPns11C)
	XpiPktTxQ4PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ4PktCntPsn11C = XpiPktTxQ4PktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U227_dff (.q(XpiPktTxQ4PktCntPsn11S),.d(XpiPktTxQ4PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1 Packet Counter
  assign XpiPktTxQ5PktCntRstPns11C = (XpiPktTxQ5CmdRegWrValidPns12S &&
				      XpiPktTxQ5ValidPns10C &&
				      XpiPktTxQ5CommandRegPns10S[26]);
  
  always @(/*AS*/XpiPktTxQ5FinalUpdatePsn11S or XpiPktTxQ5PktCntPsn11S
	   or XpiPktTxQ5PktCntRstPns11C)
    begin
      if (XpiPktTxQ5FinalUpdatePsn11S)
	XpiPktTxQ5PktCntPsn11C = {XpiPktTxQ5PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ5PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ5PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ5PktCntRstPns11C)
	XpiPktTxQ5PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ5PktCntPsn11C = XpiPktTxQ5PktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U228_dff (.q(XpiPktTxQ5PktCntPsn11S),.d(XpiPktTxQ5PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2 Packet Counter
  assign XpiPktTxQ6PktCntRstPns11C = (XpiPktTxQ6CmdRegWrValidPns12S &&
				      XpiPktTxQ6ValidPns10C && 
				      XpiPktTxQ6CommandRegPns10S[26]);

  always @(/*AS*/XpiPktTxQ6FinalUpdatePsn11S or XpiPktTxQ6PktCntPsn11S
	   or XpiPktTxQ6PktCntRstPns11C)
    begin
      if (XpiPktTxQ6FinalUpdatePsn11S)
	XpiPktTxQ6PktCntPsn11C = {XpiPktTxQ6PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ6PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ6PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ6PktCntRstPns11C)
	XpiPktTxQ6PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ6PktCntPsn11C = XpiPktTxQ6PktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U229_dff (.q(XpiPktTxQ6PktCntPsn11S),.d(XpiPktTxQ6PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3 Packet Counter
  assign XpiPktTxQ7PktCntRstPns11C = (XpiPktTxQ7CmdRegWrValidPns12S &&
				      XpiPktTxQ7ValidPns10C &&
				      XpiPktTxQ7CommandRegPns10S[26]);

  always @(/*AS*/XpiPktTxQ7FinalUpdatePsn11S or XpiPktTxQ7PktCntPsn11S
	   or XpiPktTxQ7PktCntRstPns11C)
    begin
      if (XpiPktTxQ7FinalUpdatePsn11S)
	XpiPktTxQ7PktCntPsn11C = {XpiPktTxQ7PktCntPsn11S + 1'b1};
      else if (XpiPktTxQ7PktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	XpiPktTxQ7PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ7PktCntRstPns11C)
	XpiPktTxQ7PktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ7PktCntPsn11C = XpiPktTxQ7PktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U230_dff (.q(XpiPktTxQ7PktCntPsn11S),.d(XpiPktTxQ7PktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //-----------------------------------
  //---- Interrupt Assertion Logic ----
  //-----------------------------------
  
  assign XpiPktTxQ0IntrEnPns11C = XpiPktTxQ0CommandRegPns10S[22];
  assign XpiPktTxQ1IntrEnPns11C = XpiPktTxQ1CommandRegPns10S[22];
  assign XpiPktTxQ2IntrEnPns11C = XpiPktTxQ2CommandRegPns10S[22];
  assign XpiPktTxQ3IntrEnPns11C = XpiPktTxQ3CommandRegPns10S[22];
  assign XpiPktTxQ4IntrEnPns11C = XpiPktTxQ4CommandRegPns10S[22];
  assign XpiPktTxQ5IntrEnPns11C = XpiPktTxQ5CommandRegPns10S[22];
  assign XpiPktTxQ6IntrEnPns11C = XpiPktTxQ6CommandRegPns10S[22];
  assign XpiPktTxQ7IntrEnPns11C = XpiPktTxQ7CommandRegPns10S[22];

  assign XpiPktTxQ0NoBufAvailIntrEnPns11C = XpiPktTxQ0CommandRegPns10S[23];
  assign XpiPktTxQ1NoBufAvailIntrEnPns11C = XpiPktTxQ1CommandRegPns10S[23];
  assign XpiPktTxQ2NoBufAvailIntrEnPns11C = XpiPktTxQ2CommandRegPns10S[23];
  assign XpiPktTxQ3NoBufAvailIntrEnPns11C = XpiPktTxQ3CommandRegPns10S[23];
  assign XpiPktTxQ4NoBufAvailIntrEnPns11C = XpiPktTxQ4CommandRegPns10S[23];
  assign XpiPktTxQ5NoBufAvailIntrEnPns11C = XpiPktTxQ5CommandRegPns10S[23];
  assign XpiPktTxQ6NoBufAvailIntrEnPns11C = XpiPktTxQ6CommandRegPns10S[23];
  assign XpiPktTxQ7NoBufAvailIntrEnPns11C = XpiPktTxQ7CommandRegPns10S[23];

  assign XpiPktTxQ0MaxNumPktsPns11C = XpiPktTxQ0CommandRegPns10S[21:1];
  assign XpiPktTxQ1MaxNumPktsPns11C = XpiPktTxQ1CommandRegPns10S[21:1];
  assign XpiPktTxQ2MaxNumPktsPns11C = XpiPktTxQ2CommandRegPns10S[21:1];
  assign XpiPktTxQ3MaxNumPktsPns11C = XpiPktTxQ3CommandRegPns10S[21:1];
  assign XpiPktTxQ4MaxNumPktsPns11C = XpiPktTxQ4CommandRegPns10S[21:1];
  assign XpiPktTxQ5MaxNumPktsPns11C = XpiPktTxQ5CommandRegPns10S[21:1];
  assign XpiPktTxQ6MaxNumPktsPns11C = XpiPktTxQ6CommandRegPns10S[21:1];
  assign XpiPktTxQ7MaxNumPktsPns11C = XpiPktTxQ7CommandRegPns10S[21:1];

  //----------------------------------
  //---- Interrupt Packet Counter ----
  //----------------------------------
  // Counts number of Packets between setting of Interrupt Enable bit 
  // and corresponding Interrupt Assertion.
  
  // Ingress Queue 0
  
  assign XpiPktTxQ0IntrCntEnPns11C = 
	 (XpiPktTxQ0CmdRegWrValidPns12S && XpiPktTxQ0ValidPns10C &&
	  XpiPktTxQ0IntrEnPns11C);
  
  assign XpiPktTxQ0IntrCntEnPns12C = (XpiPktTxQ0IntrCntEnPns11C || XpiPktTxQ0PktIntrPsn12C) ?
				       XpiPktTxQ0IntrCntEnPns11C : XpiPktTxQ0IntrCntEnPns12S;
  
DFFR #(1,1'b0) U231_dff (.q(XpiPktTxQ0IntrCntEnPns12S),.d(XpiPktTxQ0IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ0FinalUpdatePsn11S
	   or XpiPktTxQ0IntrCntEnPns12S or XpiPktTxQ0IntrPktCntPsn11S
	   or XpiPktTxQ0PktIntrPsn12C)
    begin
      if (XpiPktTxQ0IntrCntEnPns12S && XpiPktTxQ0FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ0IntrPktCntPsn11C = {XpiPktTxQ0IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ0IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ0IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ0PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ0IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ0IntrPktCntPsn11C = XpiPktTxQ0IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U232_dff (.q(XpiPktTxQ0IntrPktCntPsn11S),.d(XpiPktTxQ0IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 1
  
  assign XpiPktTxQ1IntrCntEnPns11C = 
	 (XpiPktTxQ1CmdRegWrValidPns12S && XpiPktTxQ1ValidPns10C && XpiPktTxQ1IntrEnPns11C);
  
  assign XpiPktTxQ1IntrCntEnPns12C = (XpiPktTxQ1IntrCntEnPns11C || XpiPktTxQ1PktIntrPsn12C) ?
				       XpiPktTxQ1IntrCntEnPns11C : XpiPktTxQ1IntrCntEnPns12S;
  
DFFR #(1,1'b0) U233_dff (.q(XpiPktTxQ1IntrCntEnPns12S),.d(XpiPktTxQ1IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ1FinalUpdatePsn11S
	   or XpiPktTxQ1IntrCntEnPns12S or XpiPktTxQ1IntrPktCntPsn11S
	   or XpiPktTxQ1PktIntrPsn12C)
    begin
      if (XpiPktTxQ1IntrCntEnPns12S && XpiPktTxQ1FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ1IntrPktCntPsn11C = {XpiPktTxQ1IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ1IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ1IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ1PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ1IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ1IntrPktCntPsn11C = XpiPktTxQ1IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U234_dff (.q(XpiPktTxQ1IntrPktCntPsn11S),.d(XpiPktTxQ1IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 2
  
  assign XpiPktTxQ2IntrCntEnPns11C = (XpiPktTxQ2CmdRegWrValidPns12S && 
				      XpiPktTxQ2ValidPns10C &&
				      XpiPktTxQ2IntrEnPns11C);
  
  assign XpiPktTxQ2IntrCntEnPns12C = (XpiPktTxQ2IntrCntEnPns11C || XpiPktTxQ2PktIntrPsn12C) ?
				       XpiPktTxQ2IntrCntEnPns11C : XpiPktTxQ2IntrCntEnPns12S;
  
DFFR #(1,1'b0) U235_dff (.q(XpiPktTxQ2IntrCntEnPns12S),.d(XpiPktTxQ2IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ2FinalUpdatePsn11S
	   or XpiPktTxQ2IntrCntEnPns12S or XpiPktTxQ2IntrPktCntPsn11S
	   or XpiPktTxQ2PktIntrPsn12C)
    begin
      if (XpiPktTxQ2IntrCntEnPns12S && XpiPktTxQ2FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ2IntrPktCntPsn11C = {XpiPktTxQ2IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ2IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ2IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ2PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ2IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ2IntrPktCntPsn11C = XpiPktTxQ2IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U236_dff (.q(XpiPktTxQ2IntrPktCntPsn11S),.d(XpiPktTxQ2IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 3
  
  assign XpiPktTxQ3IntrCntEnPns11C = (XpiPktTxQ3CmdRegWrValidPns12S && 
				      XpiPktTxQ3ValidPns10C && 
				      XpiPktTxQ3IntrEnPns11C);
  
  assign XpiPktTxQ3IntrCntEnPns12C = (XpiPktTxQ3IntrCntEnPns11C || XpiPktTxQ3PktIntrPsn12C) ?
				       XpiPktTxQ3IntrCntEnPns11C : XpiPktTxQ3IntrCntEnPns12S;
  
DFFR #(1,1'b0) U237_dff (.q(XpiPktTxQ3IntrCntEnPns12S),.d(XpiPktTxQ3IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ3FinalUpdatePsn11S
	   or XpiPktTxQ3IntrCntEnPns12S or XpiPktTxQ3IntrPktCntPsn11S
	   or XpiPktTxQ3PktIntrPsn12C)
    begin
      if (XpiPktTxQ3IntrCntEnPns12S && XpiPktTxQ3FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ3IntrPktCntPsn11C = {XpiPktTxQ3IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ3IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ3IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ3PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ3IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ3IntrPktCntPsn11C = XpiPktTxQ3IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U238_dff (.q(XpiPktTxQ3IntrPktCntPsn11S),.d(XpiPktTxQ3IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0
  
  assign XpiPktTxQ4IntrCntEnPns11C = (XpiPktTxQ4CmdRegWrValidPns12S && 
				      XpiPktTxQ4ValidPns10C &&
				      XpiPktTxQ4IntrEnPns11C);
  
  assign XpiPktTxQ4IntrCntEnPns12C = (XpiPktTxQ4IntrCntEnPns11C || XpiPktTxQ4PktIntrPsn12C) ?
				       XpiPktTxQ4IntrCntEnPns11C : XpiPktTxQ4IntrCntEnPns12S;
  
DFFR #(1,1'b0) U239_dff (.q(XpiPktTxQ4IntrCntEnPns12S),.d(XpiPktTxQ4IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ4FinalUpdatePsn11S
	   or XpiPktTxQ4IntrCntEnPns12S or XpiPktTxQ4IntrPktCntPsn11S
	   or XpiPktTxQ4PktIntrPsn12C)
    begin
      if (XpiPktTxQ4IntrCntEnPns12S && XpiPktTxQ4FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ4IntrPktCntPsn11C = {XpiPktTxQ4IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ4IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ4IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ4PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ4IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ4IntrPktCntPsn11C = XpiPktTxQ4IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U240_dff (.q(XpiPktTxQ4IntrPktCntPsn11S),.d(XpiPktTxQ4IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1
  
  assign XpiPktTxQ5IntrCntEnPns11C = (XpiPktTxQ5CmdRegWrValidPns12S && 
				      XpiPktTxQ5ValidPns10C &&
				      XpiPktTxQ5IntrEnPns11C);
  
  assign XpiPktTxQ5IntrCntEnPns12C = (XpiPktTxQ5IntrCntEnPns11C || XpiPktTxQ5PktIntrPsn12C) ?
				       XpiPktTxQ5IntrCntEnPns11C : XpiPktTxQ5IntrCntEnPns12S;
  
DFFR #(1,1'b0) U241_dff (.q(XpiPktTxQ5IntrCntEnPns12S),.d(XpiPktTxQ5IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ5FinalUpdatePsn11S
	   or XpiPktTxQ5IntrCntEnPns12S or XpiPktTxQ5IntrPktCntPsn11S
	   or XpiPktTxQ5PktIntrPsn12C)
    begin
      if (XpiPktTxQ5IntrCntEnPns12S && XpiPktTxQ5FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ5IntrPktCntPsn11C = {XpiPktTxQ5IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ5IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ5IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ5PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ5IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ5IntrPktCntPsn11C = XpiPktTxQ5IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U242_dff (.q(XpiPktTxQ5IntrPktCntPsn11S),.d(XpiPktTxQ5IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2
  
  assign XpiPktTxQ6IntrCntEnPns11C = (XpiPktTxQ6CmdRegWrValidPns12S && 
				      XpiPktTxQ6ValidPns10C &&
				      XpiPktTxQ6IntrEnPns11C);
  
  assign XpiPktTxQ6IntrCntEnPns12C = (XpiPktTxQ6IntrCntEnPns11C || XpiPktTxQ6PktIntrPsn12C) ?
				       XpiPktTxQ6IntrCntEnPns11C : XpiPktTxQ6IntrCntEnPns12S;
  
DFFR #(1,1'b0) U243_dff (.q(XpiPktTxQ6IntrCntEnPns12S),.d(XpiPktTxQ6IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ6FinalUpdatePsn11S
	   or XpiPktTxQ6IntrCntEnPns12S or XpiPktTxQ6IntrPktCntPsn11S
	   or XpiPktTxQ6PktIntrPsn12C)
    begin
      if (XpiPktTxQ6IntrCntEnPns12S && XpiPktTxQ6FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ6IntrPktCntPsn11C = {XpiPktTxQ6IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ6IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ6IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ6PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ6IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ6IntrPktCntPsn11C = XpiPktTxQ6IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U244_dff (.q(XpiPktTxQ6IntrPktCntPsn11S),.d(XpiPktTxQ6IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3
  
  assign XpiPktTxQ7IntrCntEnPns11C = (XpiPktTxQ7CmdRegWrValidPns12S && 
				      XpiPktTxQ7ValidPns10C &&
				      XpiPktTxQ7IntrEnPns11C);
  
  assign XpiPktTxQ7IntrCntEnPns12C = (XpiPktTxQ7IntrCntEnPns11C || XpiPktTxQ7PktIntrPsn12C) ?
				       XpiPktTxQ7IntrCntEnPns11C : XpiPktTxQ7IntrCntEnPns12S;
  
DFFR #(1,1'b0) U245_dff (.q(XpiPktTxQ7IntrCntEnPns12S),.d(XpiPktTxQ7IntrCntEnPns12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  always @(/*AS*/XpiPktTxQ7FinalUpdatePsn11S
	   or XpiPktTxQ7IntrCntEnPns12S or XpiPktTxQ7IntrPktCntPsn11S
	   or XpiPktTxQ7PktIntrPsn12C)
    begin
      if (XpiPktTxQ7IntrCntEnPns12S && XpiPktTxQ7FinalUpdatePsn11S)
	// Interrupt Enable Set and Packet Transfer complete, increment Pkt Cnt
	XpiPktTxQ7IntrPktCntPsn11C = {XpiPktTxQ7IntrPktCntPsn11S + 1'b1};
      else if (XpiPktTxQ7IntrPktCntPsn11S == `XPI_MAX_NUM_PKTS'hfffff)
	// Counter RollOver
	XpiPktTxQ7IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else if (XpiPktTxQ7PktIntrPsn12C)
	// Reset Counter after Interrupt Assertion
	XpiPktTxQ7IntrPktCntPsn11C = {`XPI_MAX_NUM_PKTS{1'b0}};
      else
	XpiPktTxQ7IntrPktCntPsn11C = XpiPktTxQ7IntrPktCntPsn11S;
    end // always @ (...
  
DFFR #(21,21'b0) U246_dff (.q(XpiPktTxQ7IntrPktCntPsn11S),.d(XpiPktTxQ7IntrPktCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //--------------------------------------------
  //---- Packet Trasmit Interrupt Qualifier ----
  //--------------------------------------------
  
  assign XpiPktTxQ0PktIntrPsn12C = {XpiPktTxQ0IntrPktCntPsn11S == XpiPktTxQ0MaxNumPktsPns11C};
  assign XpiPktTxQ1PktIntrPsn12C = {XpiPktTxQ1IntrPktCntPsn11S == XpiPktTxQ1MaxNumPktsPns11C};
  assign XpiPktTxQ2PktIntrPsn12C = {XpiPktTxQ2IntrPktCntPsn11S == XpiPktTxQ2MaxNumPktsPns11C};
  assign XpiPktTxQ3PktIntrPsn12C = {XpiPktTxQ3IntrPktCntPsn11S == XpiPktTxQ3MaxNumPktsPns11C};
  assign XpiPktTxQ4PktIntrPsn12C = {XpiPktTxQ4IntrPktCntPsn11S == XpiPktTxQ4MaxNumPktsPns11C};
  assign XpiPktTxQ5PktIntrPsn12C = {XpiPktTxQ5IntrPktCntPsn11S == XpiPktTxQ5MaxNumPktsPns11C};
  assign XpiPktTxQ6PktIntrPsn12C = {XpiPktTxQ6IntrPktCntPsn11S == XpiPktTxQ6MaxNumPktsPns11C};
  assign XpiPktTxQ7PktIntrPsn12C = {XpiPktTxQ7IntrPktCntPsn11S == XpiPktTxQ7MaxNumPktsPns11C};

  //---------------------------------------
  //---- No Buffer Available Interrupt ----
  //---------------------------------------
  
  assign XpiPktTxQ0NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ0DescWrPns11S && (~XpiPktTxQ0DescASICOwnerPns11C) && XpiPktTxQ0CPUOwnerIntrPns11C);

  assign XpiPktTxQ1NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ1DescWrPns11S && (~XpiPktTxQ1DescASICOwnerPns11C) && XpiPktTxQ1CPUOwnerIntrPns11C);

  assign XpiPktTxQ2NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ2DescWrPns11S && (~XpiPktTxQ2DescASICOwnerPns11C) && XpiPktTxQ2CPUOwnerIntrPns11C);

  assign XpiPktTxQ3NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ3DescWrPns11S && (~XpiPktTxQ3DescASICOwnerPns11C) && XpiPktTxQ3CPUOwnerIntrPns11C);

  assign XpiPktTxQ4NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ4DescWrPns11S && (~XpiPktTxQ4DescASICOwnerPns11C) && XpiPktTxQ4CPUOwnerIntrPns11C);

  assign XpiPktTxQ5NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ5DescWrPns11S && (~XpiPktTxQ5DescASICOwnerPns11C) && XpiPktTxQ5CPUOwnerIntrPns11C);

  assign XpiPktTxQ6NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ6DescWrPns11S && (~XpiPktTxQ6DescASICOwnerPns11C) && XpiPktTxQ6CPUOwnerIntrPns11C);

  assign XpiPktTxQ7NoBufAvailIntrPsn12C = 
	 (XpiPktTxQ7DescWrPns11S && (~XpiPktTxQ7DescASICOwnerPns11C) && XpiPktTxQ7CPUOwnerIntrPns11C);


  //-----------------------------------
  //----- Interrupt Vector Setting ----
  //-----------------------------------

  // Interrupt Bit Selection based upon different Interrupting Events
  
  always @(/*AS*/XpiPktTxQ0IntrEnPns11C
	   or XpiPktTxQ0NoBufAvailIntrEnPns11C
	   or XpiPktTxQ0NoBufAvailIntrPsn12C
	   or XpiPktTxQ0PktIntrPsn12C or XpiPktTxQ1IntrEnPns11C
	   or XpiPktTxQ1NoBufAvailIntrEnPns11C
	   or XpiPktTxQ1NoBufAvailIntrPsn12C
	   or XpiPktTxQ1PktIntrPsn12C or XpiPktTxQ2IntrEnPns11C
	   or XpiPktTxQ2NoBufAvailIntrEnPns11C
	   or XpiPktTxQ2NoBufAvailIntrPsn12C
	   or XpiPktTxQ2PktIntrPsn12C or XpiPktTxQ3IntrEnPns11C
	   or XpiPktTxQ3NoBufAvailIntrEnPns11C
	   or XpiPktTxQ3NoBufAvailIntrPsn12C
	   or XpiPktTxQ3PktIntrPsn12C or XpiPktTxQ4IntrEnPns11C
	   or XpiPktTxQ4NoBufAvailIntrEnPns11C
	   or XpiPktTxQ4NoBufAvailIntrPsn12C
	   or XpiPktTxQ4PktIntrPsn12C or XpiPktTxQ5IntrEnPns11C
	   or XpiPktTxQ5NoBufAvailIntrEnPns11C
	   or XpiPktTxQ5NoBufAvailIntrPsn12C
	   or XpiPktTxQ5PktIntrPsn12C or XpiPktTxQ6IntrEnPns11C
	   or XpiPktTxQ6NoBufAvailIntrEnPns11C
	   or XpiPktTxQ6NoBufAvailIntrPsn12C
	   or XpiPktTxQ6PktIntrPsn12C or XpiPktTxQ7IntrEnPns11C
	   or XpiPktTxQ7NoBufAvailIntrEnPns11C
	   or XpiPktTxQ7NoBufAvailIntrPsn12C
	   or XpiPktTxQ7PktIntrPsn12C)
    begin
      if (XpiPktTxQ0IntrEnPns11C && XpiPktTxQ0PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0001;
      else if (XpiPktTxQ1IntrEnPns11C && XpiPktTxQ1PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0002;
      else if (XpiPktTxQ2IntrEnPns11C && XpiPktTxQ2PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0004;
      else if (XpiPktTxQ3IntrEnPns11C && XpiPktTxQ3PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0008;
      else if (XpiPktTxQ4IntrEnPns11C && XpiPktTxQ4PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0010;
      else if (XpiPktTxQ5IntrEnPns11C && XpiPktTxQ5PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0020;
      else if (XpiPktTxQ6IntrEnPns11C && XpiPktTxQ6PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0040;
      else if (XpiPktTxQ7IntrEnPns11C && XpiPktTxQ7PktIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0080;
      else if (XpiPktTxQ0NoBufAvailIntrEnPns11C && XpiPktTxQ0NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0100;
      else if (XpiPktTxQ1NoBufAvailIntrEnPns11C && XpiPktTxQ1NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0200;
      else if (XpiPktTxQ2NoBufAvailIntrEnPns11C && XpiPktTxQ2NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0400;
      else if (XpiPktTxQ3NoBufAvailIntrEnPns11C && XpiPktTxQ3NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h0800;
      else if (XpiPktTxQ4NoBufAvailIntrEnPns11C && XpiPktTxQ4NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h1000;
      else if (XpiPktTxQ5NoBufAvailIntrEnPns11C && XpiPktTxQ5NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h2000;
      else if (XpiPktTxQ6NoBufAvailIntrEnPns11C && XpiPktTxQ6NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h4000;
      else if (XpiPktTxQ7NoBufAvailIntrEnPns11C && XpiPktTxQ7NoBufAvailIntrPsn12C)
	XpiPktTxPciIntrPsn13C = `PKTTX_INTR_EVENTS'h8000;
      else 
	XpiPktTxPciIntrPsn13C = {`PKTTX_INTR_EVENTS{1'b0}};
    end      
  
DFFR #(16,16'b0) U247_dff (.q(XpiPktTxPciIntrPsn13S),.d(XpiPktTxPciIntrPsn13C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //===================================
  //======== CORE CLOCK DOMAIN ========
  //===================================
  
  //mpp <clock=XpiCoreClk, reset=GlCoreResetR00C>

  //-----------------------------------------
  //---- TRD -> XPI Input Register Stage ----
  //-----------------------------------------
  
DFFR #(1,1'b0) U248_dff (.q(XpiPktTxWrEnPsn10S),.d(TrdXpiVldP10S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
DFFR #(11,11'b0) U249_dff (.q(XpiPktTxCtrlPsn10S),.d(TrdXpiCtrlP10S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
DFFR #(64,64'b0) U250_dff (.q(XpiPktTxDataPsn10S),.d(TrdXpiDataP10S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  assign XpiPktTxDataN0Psn11C = XpiPktTxDataPsn10S[3:0];
  assign XpiPktTxDataN1Psn11C = XpiPktTxDataPsn10S[7:4];
  assign XpiPktTxDataN2Psn11C = XpiPktTxDataPsn10S[11:8];
  assign XpiPktTxDataN3Psn11C = XpiPktTxDataPsn10S[15:12];
  assign XpiPktTxDataN4Psn11C = XpiPktTxDataPsn10S[19:16];
  assign XpiPktTxDataN5Psn11C = XpiPktTxDataPsn10S[23:20];
  assign XpiPktTxDataN6Psn11C = XpiPktTxDataPsn10S[27:24];
  assign XpiPktTxDataN7Psn11C = XpiPktTxDataPsn10S[31:28];
  assign XpiPktTxDataN8Psn11C = XpiPktTxDataPsn10S[35:32];
  assign XpiPktTxDataN9Psn11C = XpiPktTxDataPsn10S[39:36];
  assign XpiPktTxDataN10Psn11C = XpiPktTxDataPsn10S[43:40];
  assign XpiPktTxDataN11Psn11C = XpiPktTxDataPsn10S[47:44];
  assign XpiPktTxDataN12Psn11C = XpiPktTxDataPsn10S[51:48];
  assign XpiPktTxDataN13Psn11C = XpiPktTxDataPsn10S[55:52];
  assign XpiPktTxDataN14Psn11C = XpiPktTxDataPsn10S[59:56];
  assign XpiPktTxDataN15Psn11C = XpiPktTxDataPsn10S[63:60];

  assign XpiPktTxDataPsn11C =
	 {XpiPktTxDataN0Psn11C,XpiPktTxDataN1Psn11C,XpiPktTxDataN2Psn11C,XpiPktTxDataN3Psn11C,
	  XpiPktTxDataN4Psn11C,XpiPktTxDataN5Psn11C,XpiPktTxDataN6Psn11C,XpiPktTxDataN7Psn11C,
	  XpiPktTxDataN8Psn11C,XpiPktTxDataN9Psn11C,XpiPktTxDataN10Psn11C,XpiPktTxDataN11Psn11C,
	  XpiPktTxDataN12Psn11C,XpiPktTxDataN13Psn11C,XpiPktTxDataN14Psn11C,XpiPktTxDataN15Psn11C};
			               
  assign XpiPktTxIFifoWrDataPsn10C = {XpiPktTxCtrlPsn10S,XpiPktTxDataPsn11C};
  assign XpiPktTxEFifoWrDataPsn10C = {XpiPktTxCtrlPsn10S,XpiPktTxDataPsn11C};
  
DFFR #(75,75'b0) U251_dff (.q(XpiPktTxIFifoWrDataPsn10S),.d(XpiPktTxIFifoWrDataPsn10C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
DFFR #(75,75'b0) U252_dff (.q(XpiPktTxEFifoWrDataPsn10S),.d(XpiPktTxEFifoWrDataPsn10C),.clk(XpiCoreClk),.reset(GlCoreResetR00C));
  
  //---- Ingress & Egress Fifo Data Write Control State Machine ----
  
`define XPIPKTTXWRCTLIDLE 2'b00
`define XPIPKTTXIFIFOWR   2'b01
`define XPIPKTTXEFIFOWR   2'b11
  
  // State Variables
  wire [1:0] xpipkttxwrctlstate;
  reg [1:0]  next_xpipkttxwrctlstate;

  // State Change

DFFR #(2,2'b0) U253_dff (.q(xpipkttxwrctlstate),.d(next_xpipkttxwrctlstate),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  // State Assignment

  always @(/*AS*/xpipkttxwrctlstate)
    begin

      XpiPktTxIFifoWrEnPsn10C = 1'b0;
      XpiPktTxEFifoWrEnPsn10C = 1'b0;

      case (xpipkttxwrctlstate)
	
	`XPIPKTTXWRCTLIDLE: 
	  begin
	    XpiPktTxIFifoWrEnPsn10C = 1'b0;
	    XpiPktTxEFifoWrEnPsn10C = 1'b0;
	  end
	
	
	`XPIPKTTXIFIFOWR: XpiPktTxIFifoWrEnPsn10C = 1'b1;
	
	`XPIPKTTXEFIFOWR: XpiPktTxEFifoWrEnPsn10C = 1'b1;
	
	default: 
	  begin
	    XpiPktTxIFifoWrEnPsn10C = 1'b0;
	    XpiPktTxEFifoWrEnPsn10C = 1'b0;
	  end

      endcase // case(xpipkttxwrctlstate)
    end // always @ (...
    
  // State Transition

  always @(/*AS*/XpiPktTxCtrlPsn10S or XpiPktTxWrEnPsn10S
	   or xpipkttxwrctlstate)
    begin

      case (xpipkttxwrctlstate)

	`XPIPKTTXWRCTLIDLE:
	  begin
	    if (XpiPktTxWrEnPsn10S && (~XpiPktTxCtrlPsn10S[4]))
	      // Store Ingress Queue Packet Chunks in Ingress Fifo
	      next_xpipkttxwrctlstate = `XPIPKTTXIFIFOWR;
	    else if (XpiPktTxWrEnPsn10S && XpiPktTxCtrlPsn10S[4])
	      // Store Egress Queue Packet Chunks in Ingress Fifo
	      next_xpipkttxwrctlstate = `XPIPKTTXEFIFOWR;
	    else
	      next_xpipkttxwrctlstate = `XPIPKTTXWRCTLIDLE;
	  end
	
	`XPIPKTTXIFIFOWR:
	  begin
	    if (~XpiPktTxWrEnPsn10S)
	      next_xpipkttxwrctlstate = `XPIPKTTXWRCTLIDLE;
	    else
	      next_xpipkttxwrctlstate = `XPIPKTTXIFIFOWR;
	  end

	`XPIPKTTXEFIFOWR:
	  begin
	    if (~XpiPktTxWrEnPsn10S)
	      next_xpipkttxwrctlstate = `XPIPKTTXWRCTLIDLE;
	    else
	      next_xpipkttxwrctlstate = `XPIPKTTXEFIFOWR;
	  end

	default: next_xpipkttxwrctlstate = `XPIPKTTXWRCTLIDLE;

      endcase // case(xpipkttxwrctlstate)
    end // always @ (...
  

  //---------------------------------------------
  //---- PCI CLK -> CORE CLK SYNCHRONIZATION ----
  //---------------------------------------------

  assign XpiPktTxChunkSendPsn11S = {XpiPktTxEChunkSendPsn11S,XpiPktTxIChunkSendPsn11S};
    
  // First Core Clk Sync Flop
DFFR #(2,2'b0) U254_dff (.q(XpiPktTxChunkSendPsn12S),.d(XpiPktTxChunkSendPsn11S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  // Second Core Clk Sync Flop
DFFR #(2,2'b0) U255_dff (.q(XpiPktTxChunkSendPsn13S),.d(XpiPktTxChunkSendPsn12S),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  //----------------------------------------
  //---- Pulse Generating State Machine ----
  //----------------------------------------
  // Core Clk Pulse indicating a Chunk (64B) transfer complete in PCI Domain

`define XPIPKTTXPULSEIDLE       2'b00
`define XPIPKTTXPULSEICHUNKSEND 2'b01
`define XPIPKTTXPULSEECHUNKSEND 2'b10
`define XPIPKTTXPULSEHOLD       2'b11

  // Internal State Variable
  wire [1:0] xpipkttxpulsestate;
  reg [1:0]  next_xpipkttxpulsestate;
  
  // State Change

DFFR #(2,2'b0) U256_dff (.q(xpipkttxpulsestate),.d(next_xpipkttxpulsestate),.clk(XpiCoreClk),.reset(GlCoreResetR00C));

  // State Assignment

  always @(/*AS*/xpipkttxpulsestate)
    begin

      XpiTrdChunkSendP11S = 2'b00;

      case (xpipkttxpulsestate)
	
	`XPIPKTTXPULSEIDLE: XpiTrdChunkSendP11S = 2'b00;
	
	`XPIPKTTXPULSEICHUNKSEND: XpiTrdChunkSendP11S = 2'b01;
	
	`XPIPKTTXPULSEECHUNKSEND: XpiTrdChunkSendP11S = 2'b10;
	
	`XPIPKTTXPULSEHOLD: XpiTrdChunkSendP11S = 2'b00;
	
	default: XpiTrdChunkSendP11S = 2'b00;
	
      endcase // case(xpipkttxpulsestate)
    end // always @ (...
  
  // State Transition

  always @(/*AS*/XpiPktTxChunkSendPsn13S or xpipkttxpulsestate)
    begin

      case(xpipkttxpulsestate)

	`XPIPKTTXPULSEIDLE:
	  begin
	    if (XpiPktTxChunkSendPsn13S[0])
	      next_xpipkttxpulsestate = `XPIPKTTXPULSEICHUNKSEND;
	    else if (XpiPktTxChunkSendPsn13S[1])
	      next_xpipkttxpulsestate = `XPIPKTTXPULSEECHUNKSEND;
	    else
	      next_xpipkttxpulsestate = `XPIPKTTXPULSEIDLE;
	  end
	
	`XPIPKTTXPULSEICHUNKSEND: next_xpipkttxpulsestate = `XPIPKTTXPULSEHOLD;

	`XPIPKTTXPULSEECHUNKSEND: next_xpipkttxpulsestate = `XPIPKTTXPULSEHOLD;
	
	`XPIPKTTXPULSEHOLD:
	  begin
	    if (XpiPktTxChunkSendPsn13S == 2'b00)
	      next_xpipkttxpulsestate = `XPIPKTTXPULSEIDLE;
	    else
	      next_xpipkttxpulsestate = `XPIPKTTXPULSEHOLD;
	  end

	default: next_xpipkttxpulsestate = `XPIPKTTXPULSEIDLE;
	
      endcase // case(xpipkttxpulsestate)
    end // always @ (...
    
  //------------------------
  //---- 0in Assertions ----
  //------------------------

  // 0in known_driven -var XpiPciAppPktTxAddrIrdyP11S  -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxAddrP11S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxCmdP11S       -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxAttrP11S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxByteEnP11S    -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxLengthP11S    -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxDataIrdyP11S  -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxDataP11S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxTrdyP10S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxTrdyP11S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciAppPktTxValidTxnP11S  -clock XpiPciClk -reset GlCoreResetR00C
  						       
  // 0in known_driven -var XpiPciArbPktTxStopP11S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciArbPktTxBusyP11S      -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPciArbPktTxSrvP11S       -clock XpiPciClk -reset GlCoreResetR00C
  
  // 0in known_driven -var XpiPktTxPciAddrIrdyPsn13S   -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciAddrPsn13S       -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciDataIrdyPsn13S   -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciDataPsn13S       -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciCmdPsn13S	       -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciAttrPsn13S       -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciByteEnPsn13S     -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciLengthPsn13S     -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciTrdyPsn13S       -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciArbReqPsn13S     -clock XpiPciClk -reset GlCoreResetR00C
  // 0in known_driven -var XpiPktTxPciIntrPsn13S       -clock XpiPciClk -reset GlCoreResetR00C
  
  // 0in known_driven -var TrdXpiVldP10S               -clock XpiCoreClk -reset GlCoreResetR00C
  // 0in known_driven -var TrdXpiCtrlP10S	       -clock XpiCoreClk -reset GlCoreResetR00C -active TrdXpiVldP10S
  // 0in known_driven -var TrdXpiDataP10S	       -clock XpiCoreClk -reset GlCoreResetR00C -active TrdXpiVldP10S
  // 0in known_driven -var XpiTrdChunkSendP11S	       -clock XpiCoreClk -reset GlCoreResetR00C

  /* 0in multi_clock_fifo -enq XpiPktTxIFifoWrEnPsn10C[-enq_clock XpiCoreClk]
   -deq XpiPktTxIFifoRdEnPsn11C[-deq_clock XpiPciClk] -depth `PKTTXFIFO_DEPTH
   -enq_data XpiPktTxIFifoWrDataPsn10S -deq_data XpiPktTxIFifoRdDataPsn11C[-latency 0]
   -enq_reset GlCoreResetR00C -deq_reset GlCoreResetR00C
   */
  
endmodule // xpipkttxs

