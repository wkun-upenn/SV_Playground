    end // always @ (...

DFFR #(32,32'b0) U15_dff (.q(XpiPktTxQ3AddressRegPns10S),.d(XpiPktTxQ3AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Status Register Update

  always @(/*AS*/XpiPktTxQ3FinalUpdatePsn11S or XpiPktTxQ3PktCntPsn11S
	   or XpiPktTxQ3RunSetPns10C or XpiPktTxQ3StatusRegPns10S)
    begin
      if (XpiPktTxQ3RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ3StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ3FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ3StatusRegPns10C = {{10{1'b0}},XpiPktTxQ3PktCntPsn11S,1'b1};
      else
	XpiPktTxQ3StatusRegPns10C = XpiPktTxQ3StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U16_dff (.q(XpiPktTxQ3StatusRegPns10S),.d(XpiPktTxQ3StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Egress CPU Queue 0 Control Registers ----
  //-----------------------------------------------

  // Command
  assign XpiPktTxQ4CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'hb0));
  
  assign XpiPktTxQ4CommandRegPns10C = XpiPktTxQ4CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ4CommandRegPns10S;
DFFR #(32,32'b0) U17_dff (.q(XpiPktTxQ4CommandRegPns10S),.d(XpiPktTxQ4CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Address

  assign XpiPktTxQ4AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'hb4));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ4AddrRegWrValidPns10C
	   or XpiPktTxQ4AddressRegPns10S or XpiPktTxQ4DescPtrRegPns11S
	   or XpiPktTxQ4DescWrBackPsn12C)
    begin
      if (XpiPktTxQ4AddrRegWrValidPns10C)
	XpiPktTxQ4AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ4DescWrBackPsn12C)
	XpiPktTxQ4AddressRegPns10C = XpiPktTxQ4DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ4AddressRegPns10C = XpiPktTxQ4AddressRegPns10S;
    end
  
DFFR #(32,32'b0) U18_dff (.q(XpiPktTxQ4AddressRegPns10S),.d(XpiPktTxQ4AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Status Register Update

  always @(/*AS*/XpiPktTxQ4FinalUpdatePsn11S or XpiPktTxQ4PktCntPsn11S
	   or XpiPktTxQ4RunSetPns10C or XpiPktTxQ4StatusRegPns10S)
    begin
      if (XpiPktTxQ4RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ4StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ4FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ4StatusRegPns10C = {{10{1'b0}},XpiPktTxQ4PktCntPsn11S,1'b1};
      else
	XpiPktTxQ4StatusRegPns10C = XpiPktTxQ4StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U19_dff (.q(XpiPktTxQ4StatusRegPns10S),.d(XpiPktTxQ4StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Egress CPU Queue 1 Control Registers ----
  //-----------------------------------------------
  
  // Command
  assign XpiPktTxQ5CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'hc0));
  
  assign XpiPktTxQ5CommandRegPns10C = XpiPktTxQ5CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ5CommandRegPns10S;
DFFR #(32,32'b0) U20_dff (.q(XpiPktTxQ5CommandRegPns10S),.d(XpiPktTxQ5CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Address
  assign XpiPktTxQ5AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'hc4));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ5AddrRegWrValidPns10C
	   or XpiPktTxQ5AddressRegPns10S or XpiPktTxQ5DescPtrRegPns11S
	   or XpiPktTxQ5DescWrBackPsn12C)
    begin
      if (XpiPktTxQ5AddrRegWrValidPns10C)
	XpiPktTxQ5AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ5DescWrBackPsn12C)
	XpiPktTxQ5AddressRegPns10C = XpiPktTxQ5DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ5AddressRegPns10C = XpiPktTxQ5AddressRegPns10S;
    end

DFFR #(32,32'b0) U21_dff (.q(XpiPktTxQ5AddressRegPns10S),.d(XpiPktTxQ5AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Status Register Update

  always @(/*AS*/XpiPktTxQ5FinalUpdatePsn11S or XpiPktTxQ5PktCntPsn11S
	   or XpiPktTxQ5RunSetPns10C or XpiPktTxQ5StatusRegPns10S)
    begin
      if (XpiPktTxQ5RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ5StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ5FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ5StatusRegPns10C = {{10{1'b0}},XpiPktTxQ5PktCntPsn11S,1'b1};
      else
	XpiPktTxQ5StatusRegPns10C = XpiPktTxQ5StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U22_dff (.q(XpiPktTxQ5StatusRegPns10S),.d(XpiPktTxQ5StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Egress CPU Queue 2 Control Registers ----
  //-----------------------------------------------
  
  // Command
  assign XpiPktTxQ6CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'hd0));
  
  assign XpiPktTxQ6CommandRegPns10C = XpiPktTxQ6CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ6CommandRegPns10S;
DFFR #(32,32'b0) U23_dff (.q(XpiPktTxQ6CommandRegPns10S),.d(XpiPktTxQ6CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Address
  assign XpiPktTxQ6AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'hd4));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ6AddrRegWrValidPns10C
	   or XpiPktTxQ6AddressRegPns10S or XpiPktTxQ6DescPtrRegPns11S
	   or XpiPktTxQ6DescWrBackPsn12C)
    begin
      if (XpiPktTxQ6AddrRegWrValidPns10C)
	XpiPktTxQ6AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ6DescWrBackPsn12C)
	XpiPktTxQ6AddressRegPns10C = XpiPktTxQ6DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ6AddressRegPns10C = XpiPktTxQ6AddressRegPns10S;
    end

DFFR #(32,32'b0) U24_dff (.q(XpiPktTxQ6AddressRegPns10S),.d(XpiPktTxQ6AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Status Register Update

  always @(/*AS*/XpiPktTxQ6FinalUpdatePsn11S or XpiPktTxQ6PktCntPsn11S
	   or XpiPktTxQ6RunSetPns10C or XpiPktTxQ6StatusRegPns10S)
    begin
      if (XpiPktTxQ6RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ6StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ6FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ6StatusRegPns10C = {{10{1'b0}},XpiPktTxQ6PktCntPsn11S,1'b1};
      else
	XpiPktTxQ6StatusRegPns10C = XpiPktTxQ6StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U25_dff (.q(XpiPktTxQ6StatusRegPns10S),.d(XpiPktTxQ6StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //-----------------------------------------------
  //---- Egress CPU Queue 3 Control Registers ----
  //-----------------------------------------------
  
  // Command
  assign XpiPktTxQ7CmdRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					  (XpiPktTxAddrPns10S[7:0]==8'he0));
  
  assign XpiPktTxQ7CommandRegPns10C = XpiPktTxQ7CmdRegWrValidPns10C ?
	 XpiPktTxCfgDataPns10S : XpiPktTxQ7CommandRegPns10S;
DFFR #(32,32'b0) U26_dff (.q(XpiPktTxQ7CommandRegPns10S),.d(XpiPktTxQ7CommandRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Address
  assign XpiPktTxQ7AddrRegWrValidPns10C = (XpiPktTxSrvCfgWrPns10S &&
					   (XpiPktTxAddrPns10S[7:0]==8'he4));
  
  always @(/*AS*/XpiPktTxCfgDataPns10S or XpiPktTxDescWrBackEn1Psn10C
	   or XpiPktTxQ7AddrRegWrValidPns10C
	   or XpiPktTxQ7AddressRegPns10S or XpiPktTxQ7DescPtrRegPns11S
	   or XpiPktTxQ7DescWrBackPsn12C)
    begin
      if (XpiPktTxQ7AddrRegWrValidPns10C)
	XpiPktTxQ7AddressRegPns10C = XpiPktTxCfgDataPns10S;
      else if (XpiPktTxDescWrBackEn1Psn10C && XpiPktTxQ7DescWrBackPsn12C)
	XpiPktTxQ7AddressRegPns10C = XpiPktTxQ7DescPtrRegPns11S[95:64];
      else
	XpiPktTxQ7AddressRegPns10C = XpiPktTxQ7AddressRegPns10S;
    end

DFFR #(32,32'b0) U27_dff (.q(XpiPktTxQ7AddressRegPns10S),.d(XpiPktTxQ7AddressRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Status Register Update

  always @(/*AS*/XpiPktTxQ7FinalUpdatePsn11S or XpiPktTxQ7PktCntPsn11S
	   or XpiPktTxQ7RunSetPns10C or XpiPktTxQ7StatusRegPns10S)
    begin
      if (XpiPktTxQ7RunSetPns10C)
	// Set Busy Bit
	XpiPktTxQ7StatusRegPns10C = {{31{1'b0}},1'b1};
      else if (XpiPktTxQ7FinalUpdatePsn11S)
	// Incrementing Number of packets send after Packet Transfer
	XpiPktTxQ7StatusRegPns10C = {{10{1'b0}},XpiPktTxQ7PktCntPsn11S,1'b1};
      else
	XpiPktTxQ7StatusRegPns10C = XpiPktTxQ7StatusRegPns10S;
    end
  
DFFR #(32,32'b0) U28_dff (.q(XpiPktTxQ7StatusRegPns10S),.d(XpiPktTxQ7StatusRegPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //---------------------------------------
  //---- PKT TX Control Register Read  ----
  //---------------------------------------

  //---- Muxing Cmd, Addr & Status Register Data ----
  
  //---- Ingress Queue 0 ----
MUX4S2 #(32) U29_mux4 (.mo(XpiPktTxQ0CfgDataPsn12C),.in0(XpiPktTxQ0CommandRegPns10S),.in1(XpiPktTxQ0AddressRegPns10S),.in2(XpiPktTxQ0StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Ingress Queue 1 ----  
MUX4S2 #(32) U30_mux4 (.mo(XpiPktTxQ1CfgDataPsn12C),.in0(XpiPktTxQ1CommandRegPns10S),.in1(XpiPktTxQ1AddressRegPns10S),.in2(XpiPktTxQ1StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Ingress Queue 2 ----
MUX4S2 #(32) U31_mux4 (.mo(XpiPktTxQ2CfgDataPsn12C),.in0(XpiPktTxQ2CommandRegPns10S),.in1(XpiPktTxQ2AddressRegPns10S),.in2(XpiPktTxQ2StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Ingress Queue 3 ----
MUX4S2 #(32) U32_mux4 (.mo(XpiPktTxQ3CfgDataPsn12C),.in0(XpiPktTxQ3CommandRegPns10S),.in1(XpiPktTxQ3AddressRegPns10S),.in2(XpiPktTxQ3StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Egress Queue 0 ----
MUX4S2 #(32) U33_mux4 (.mo(XpiPktTxQ4CfgDataPsn12C),.in0(XpiPktTxQ4CommandRegPns10S),.in1(XpiPktTxQ4AddressRegPns10S),.in2(XpiPktTxQ4StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Egress Queue 1 ----  
MUX4S2 #(32) U34_mux4 (.mo(XpiPktTxQ5CfgDataPsn12C),.in0(XpiPktTxQ5CommandRegPns10S),.in1(XpiPktTxQ5AddressRegPns10S),.in2(XpiPktTxQ5StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Egress Queue 2 ----
MUX4S2 #(32) U35_mux4 (.mo(XpiPktTxQ6CfgDataPsn12C),.in0(XpiPktTxQ6CommandRegPns10S),.in1(XpiPktTxQ6AddressRegPns10S),.in2(XpiPktTxQ6StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //---- Egress Queue 3 ----
MUX4S2 #(32) U36_mux4 (.mo(XpiPktTxQ7CfgDataPsn12C),.in0(XpiPktTxQ7CommandRegPns10S),.in1(XpiPktTxQ7AddressRegPns10S),.in2(XpiPktTxQ7StatusRegPns10S),.in3({`CFG_WIDTH{1'b0}}),.sel(XpiPktTxAddrPns10S[3:2]));



  //------------------------------------------------------------------
  //---- Muxing between CPU Queues for Control Register Read Data ----
  //------------------------------------------------------------------
  
  always @(/*AS*/XpiPktTxAddrPns10S or XpiPktTxQ0CfgDataPsn12C
	   or XpiPktTxQ1CfgDataPsn12C or XpiPktTxQ2CfgDataPsn12C
	   or XpiPktTxQ3CfgDataPsn12C or XpiPktTxQ4CfgDataPsn12C
	   or XpiPktTxQ5CfgDataPsn12C or XpiPktTxQ6CfgDataPsn12C
	   or XpiPktTxQ7CfgDataPsn12C)
    begin
      
      case (XpiPktTxAddrPns10S[7:4])

	4'h7: XpiPktTxCfgDataPsn12C = XpiPktTxQ0CfgDataPsn12C;

	4'h8: XpiPktTxCfgDataPsn12C = XpiPktTxQ1CfgDataPsn12C;

	4'h9: XpiPktTxCfgDataPsn12C = XpiPktTxQ2CfgDataPsn12C;

	4'ha: XpiPktTxCfgDataPsn12C = XpiPktTxQ3CfgDataPsn12C;
	
	4'hb: XpiPktTxCfgDataPsn12C = XpiPktTxQ4CfgDataPsn12C;
	
	4'hc: XpiPktTxCfgDataPsn12C = XpiPktTxQ5CfgDataPsn12C;
	
	4'hd: XpiPktTxCfgDataPsn12C = XpiPktTxQ6CfgDataPsn12C;
	
	4'he: XpiPktTxCfgDataPsn12C = XpiPktTxQ7CfgDataPsn12C;

	default: XpiPktTxCfgDataPsn12C = {`CFG_WIDTH{1'b0}};
	
      endcase // case(XpiPktTxAddrPns10S[7:4])
    end // always @ (...
  

  //================================================================
  //==== Command & Status Register Update Control State Machine ====
  //================================================================

  //-------------------------
  //---- Ingress Queue 0 ----
  //-------------------------
  
`define XPIPKTTXQ0CMDIDLE  2'b00
`define XPIPKTTXQ0CMDVALID 2'b01
`define XPIPKTTXQ0CMDHALT  2'b11
`define XPIPKTTXQ0CMDSET   2'b10
  
  // State Variables
  wire [1:0] xpipkttxQ0cmdstate;
  reg [1:0]  next_xpipkttxQ0cmdstate;
  
    // State Change
DFFR #(2,2'b0) U37_dff (.q(xpipkttxQ0cmdstate),.d(next_xpipkttxQ0cmdstate),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Output Assignment

  always @(/*AS*/xpipkttxQ0cmdstate)
    begin
      
      XpiPktTxQ0ValidPns10C = 1'b0;
      
      case(xpipkttxQ0cmdstate)
	
	`XPIPKTTXQ0CMDIDLE: 
	  begin
	    XpiPktTxQ0ValidPns10C = 1'b0;
	  end	  

	`XPIPKTTXQ0CMDVALID: XpiPktTxQ0ValidPns10C = 1'b1;

	`XPIPKTTXQ0CMDHALT: ;
	
	`XPIPKTTXQ0CMDSET:
	  begin
	    XpiPktTxQ0ValidPns10C = 1'b0;
	  end	  

	default:
	  begin
	    XpiPktTxQ0ValidPns10C = 1'b0;
	  end	  

      endcase // case(xpipkttxQ0cmdstate)
    end // always @ (...
  
  // State Transitions

  always @(/*AS*/XpiPktTxQ0CPUOwnerPns11C
	   or XpiPktTxQ0CmdRegWrValidPns11S or XpiPktTxQ0RunPns11C
	   or xpipkttxQ0cmdstate)
    begin

      case (xpipkttxQ0cmdstate)
	
	`XPIPKTTXQ0CMDIDLE:
	  begin
	    if (XpiPktTxQ0CmdRegWrValidPns11S && XpiPktTxQ0RunPns11C)
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDVALID;
	    else
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDIDLE;
	  end
	
	`XPIPKTTXQ0CMDVALID:
	  begin
	    if (XpiPktTxQ0CPUOwnerPns11C)
	      // No Buffer Available condition, which requires a reprogramming
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDIDLE;
	    else if (XpiPktTxQ0CmdRegWrValidPns11S && (~XpiPktTxQ0RunPns11C))
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDHALT;
	    else
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDVALID;
	  end
	
	`XPIPKTTXQ0CMDHALT:
	  begin
	    if (XpiPktTxQ0CmdRegWrValidPns11S && XpiPktTxQ0RunPns11C)
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDSET;
	    else
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDHALT;
	  end
	
	`XPIPKTTXQ0CMDSET:
	  begin
	    if (XpiPktTxQ0CPUOwnerPns11C)
	      // No Buffer Available condition, which requires a reprogramming
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDIDLE;
	    else if (XpiPktTxQ0CmdRegWrValidPns11S && (~XpiPktTxQ0RunPns11C))
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDHALT;
	    else
	      next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDSET;
	  end
	
	default: next_xpipkttxQ0cmdstate = `XPIPKTTXQ0CMDIDLE;
	
      endcase // case(xpipkttxQ0cmdstate)
    end // always @ (...

  //-------------------------
  //---- Ingress Queue 1 ----
  //-------------------------
  
`define XPIPKTTXQ1CMDIDLE  2'b00
`define XPIPKTTXQ1CMDVALID 2'b01
`define XPIPKTTXQ1CMDHALT  2'b11
`define XPIPKTTXQ1CMDSET   2'b10
  
