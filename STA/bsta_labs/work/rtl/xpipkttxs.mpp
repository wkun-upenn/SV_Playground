

`include "xpiuc.vh"

module xpipkttxs (/*AUTOARG*/
   // Outputs
   XpiPktTxPciTxnIDPsn13S, XpiPktTxPciAddrIrdyPsn13S, 
   XpiPktTxPciAddrPsn13S, XpiPktTxPciDataIrdyPsn13S, 
   XpiPktTxPciDataPsn13S, XpiPktTxPciCmdPsn13S, 
   XpiPktTxPciAttrPsn13S, XpiPktTxPciByteEnPsn13S, 
   XpiPktTxPciLengthPsn13S, XpiPktTxPciTrdyPsn13S, 
   XpiPktTxPciArbReqPsn13S, XpiPktTxPciIntrPsn13S, 
   XpiTrdChunkSendP11S, 
   // Inputs
   XpiPciClk, XpiCoreClk, GlCoreResetR00C, 
   XpiPciAppPktTxAddrIrdyP11S, XpiPciAppPktTxAddrP11S, 
   XpiPciAppPktTxCmdP11S, XpiPciAppPktTxAttrP11S, 
   XpiPciAppPktTxByteEnP11S, XpiPciAppPktTxLengthP11S, 
   XpiPciAppPktTxDataIrdyP11S, XpiPciAppPktTxDataP11S, 
   XpiPciAppPktTxTrdyP10S, XpiPciAppPktTxTrdyP11S, 
   XpiPciAppPktTxValidTxnP11S, XpiPciAppPktTxRdStopP11S, 
   XpiPciArbPktTxStopP11S, XpiPciArbPktTxBusyP11S, 
   XpiPciArbPktTxSrvP11S, XpiPciArbPktTxReqAbortP11S, 
   XpiPciArbPktTxSplitAbortP11S, TrdXpiVldP10S, TrdXpiCtrlP10S, 
   TrdXpiDataP10S
   );

  parameter [2:0] TXNID = 3'b101;

  //-------------------------------------
  //--------  Interface Signals  --------
  //-------------------------------------
  
  //---- Global Signals ----

  input                               XpiPciClk;
  input 			      XpiCoreClk;
  input 			      GlCoreResetR00C;
  
  //---- PktTx - PCI-X Interface Signals ----
  input 			      XpiPciAppPktTxAddrIrdyP11S;
  input [`PCI_ADDR_WIDTH-1:0] 	      XpiPciAppPktTxAddrP11S;
  input [3:0] 			      XpiPciAppPktTxCmdP11S;
  input [`PCI_ATTR_WIDTH-1:0] 	      XpiPciAppPktTxAttrP11S;
  input [`CMD_BE_WIDTH-1:0] 	      XpiPciAppPktTxByteEnP11S;
  input [`RQ_BYTECNT_WIDTH-1:0]       XpiPciAppPktTxLengthP11S;
  input 			      XpiPciAppPktTxDataIrdyP11S;
  input [`PCI_DATA_WIDTH-1:0] 	      XpiPciAppPktTxDataP11S;
  input 			      XpiPciAppPktTxTrdyP10S;
  input 			      XpiPciAppPktTxTrdyP11S;
  input 			      XpiPciAppPktTxValidTxnP11S;
  input 			      XpiPciAppPktTxRdStopP11S;
  
  input 			      XpiPciArbPktTxStopP11S;
  input 			      XpiPciArbPktTxBusyP11S;
  input 			      XpiPciArbPktTxSrvP11S;
  input 			      XpiPciArbPktTxReqAbortP11S;
  input 			      XpiPciArbPktTxSplitAbortP11S;
  
  output [2:0] 			      XpiPktTxPciTxnIDPsn13S;
  output 			      XpiPktTxPciAddrIrdyPsn13S;
  output [`PCI_ADDR_WIDTH-1:0] 	      XpiPktTxPciAddrPsn13S;
  output 			      XpiPktTxPciDataIrdyPsn13S;
  output [`PCI_DATA_WIDTH-1:0] 	      XpiPktTxPciDataPsn13S;
  output [3:0] 			      XpiPktTxPciCmdPsn13S;
  output [`PCI_ATTR_WIDTH-1:0] 	      XpiPktTxPciAttrPsn13S;
  output [`CMD_BE_WIDTH-1:0] 	      XpiPktTxPciByteEnPsn13S;
  output [`BYTECNT_WIDTH-1:0] 	      XpiPktTxPciLengthPsn13S;
  output 			      XpiPktTxPciTrdyPsn13S;
  output 			      XpiPktTxPciArbReqPsn13S;
  output [`PKTTX_INTR_EVENTS-1:0]     XpiPktTxPciIntrPsn13S;
  
  //---- TRD -> PKTTX Interface Signals ----
  input 			      TrdXpiVldP10S;
  input [`TRDXPI_CTRL_WIDTH-1:0]      TrdXpiCtrlP10S;
  input [`TRDXPI_DATA_WIDTH-1:0]      TrdXpiDataP10S;
  
  output [1:0] 			      XpiTrdChunkSendP11S;
  
