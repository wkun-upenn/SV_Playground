	    if (XpiPktTxQ7CmdRegWrValidPns11S && XpiPktTxQ7RunPns11C)
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDVALID;
	    else
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDIDLE;
	  end
	
	`XPIPKTTXQ7CMDVALID:
	  begin
	    if (XpiPktTxQ7CPUOwnerPns11C)
	      // No Buffer Available condition, which requires a reprogramming
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDIDLE;
	    else if (XpiPktTxQ7CmdRegWrValidPns11S && (~XpiPktTxQ7RunPns11C))
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDHALT;
	    else
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDVALID;
	  end
	
	`XPIPKTTXQ7CMDHALT:
	  begin
	    if (XpiPktTxQ7CmdRegWrValidPns11S && XpiPktTxQ7RunPns11C)
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDSET;
	    else
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDHALT;
	  end
	
	`XPIPKTTXQ7CMDSET:
	  begin
	    if (XpiPktTxQ7CPUOwnerPns11C)
	      // No Buffer Available condition, which requires a reprogramming
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDIDLE;
	    else if (XpiPktTxQ7CmdRegWrValidPns11S && (~XpiPktTxQ7RunPns11C))
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDHALT;
	    else
	      next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDSET;
	  end
	
	default: next_xpipkttxQ7cmdstate = `XPIPKTTXQ7CMDIDLE;
	
      endcase // case(xpipkttxQ7cmdstate)
    end // always @ (...
  
  //--------------------------------------------------
  //---- Extracting & Parsing Control Information ----
  //--------------------------------------------------
  
  assign XpiPktTxICtrlPsn11C = XpiPktTxIFifoRdDataPsn11C[`PKTTXFIFO_DATA_WIDTH-1:`PCI_DATA_WIDTH];
  assign XpiPktTxECtrlPsn11C = XpiPktTxEFifoRdDataPsn11C[`PKTTXFIFO_DATA_WIDTH-1:`PCI_DATA_WIDTH];
  
  //---- Parsing Control Info ----

  // Ingress 

  assign XpiPktTxIEOPPsn11C = 
	 (XpiPktTxIDataIrdyPsn11C && (~XpiPktTxIFifoEFPsn11C)) ? 
	   XpiPktTxICtrlPsn11C[1] : 1'b0;

  assign XpiPktTxICPUQueueIdPsn11C = 
	 (XpiPktTxIDataIrdyPsn11C && (~XpiPktTxIFifoEFPsn11C)) ? 
	   XpiPktTxICtrlPsn11C[4:2] : 3'b000;

  // TM Models EOPOffset = size - 1, hence adding 1.
  assign XpiPktTxIEOPOffsetPsn10C = {XpiPktTxICtrlPsn11C[10:5] + 1'b1};
  
  assign XpiPktTxIEOPOffsetPsn11C  = 
	 (XpiPktTxIDataIrdyPsn11C && (~XpiPktTxIFifoEFPsn11C)) ?
	   XpiPktTxIEOPOffsetPsn10C : {`PKTTX_EOPOFFSET_WIDTH{1'b0}};
  
  // Egress

  assign XpiPktTxEEOPPsn11C = 
	 (XpiPktTxEDataIrdyPsn11C && (~XpiPktTxEFifoEFPsn11C)) ? 
	   XpiPktTxECtrlPsn11C[1] : 1'b0;

  assign XpiPktTxECPUQueueIdPsn11C = 
	 (XpiPktTxEDataIrdyPsn11C && (~XpiPktTxEFifoEFPsn11C)) ? 
	   XpiPktTxECtrlPsn11C[4:2] : 3'b000;

  // TM Models EOPOffset = size - 1, hence adding 1.
  assign XpiPktTxEEOPOffsetPsn10C = {XpiPktTxECtrlPsn11C[10:5] + 1'b1};
  
  assign XpiPktTxEEOPOffsetPsn11C  = 
	 (XpiPktTxEDataIrdyPsn11C && (~XpiPktTxEFifoEFPsn11C)) ?
	   XpiPktTxEEOPOffsetPsn10C : {`PKTTX_EOPOFFSET_WIDTH{1'b0}};
  
  // Active Queue Indication
  
  assign XpiPktTxQ0ActivePsn11C = (XpiPktTxIFifoRdEnPsn11C && XpiPktTxQ0RunPns11C &&
				   XpiPktTxICPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b000);
  assign XpiPktTxQ1ActivePsn11C = (XpiPktTxIFifoRdEnPsn11C && XpiPktTxQ1RunPns11C &&
				   XpiPktTxICPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b001);
  assign XpiPktTxQ2ActivePsn11C = (XpiPktTxIFifoRdEnPsn11C && XpiPktTxQ2RunPns11C &&
				   XpiPktTxICPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b010);
  assign XpiPktTxQ3ActivePsn11C = (XpiPktTxIFifoRdEnPsn11C && XpiPktTxQ3RunPns11C &&
				   XpiPktTxICPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b011);

  assign XpiPktTxQ4ActivePsn11C = (XpiPktTxEFifoRdEnPsn11C && XpiPktTxQ4RunPns11C &&
				   XpiPktTxECPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b100);
  assign XpiPktTxQ5ActivePsn11C = (XpiPktTxEFifoRdEnPsn11C && XpiPktTxQ5RunPns11C &&
				   XpiPktTxECPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b101);
  assign XpiPktTxQ6ActivePsn11C = (XpiPktTxEFifoRdEnPsn11C && XpiPktTxQ6RunPns11C &&
				   XpiPktTxECPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b110);
  assign XpiPktTxQ7ActivePsn11C = (XpiPktTxEFifoRdEnPsn11C && XpiPktTxQ7RunPns11C &&
				   XpiPktTxECPUQueueIdPsn11C == `PKTTX_CPUQID_WIDTH'b111);

  // Recirculating Queue Active indication until Chunk Send

  assign XpiPktTxQ0ActivePsn12C = (XpiPktTxQ0ActivePsn11C || XpiPktTxIChunkSendPsn11C) ?
				    XpiPktTxQ0ActivePsn11C : XpiPktTxQ0ActivePsn12S;
DFFR #(1,1'b0) U45_dff (.q(XpiPktTxQ0ActivePsn12S),.d(XpiPktTxQ0ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxQ1ActivePsn12C = (XpiPktTxQ1ActivePsn11C || XpiPktTxIChunkSendPsn11C) ?
				    XpiPktTxQ1ActivePsn11C : XpiPktTxQ1ActivePsn12S;
DFFR #(1,1'b0) U46_dff (.q(XpiPktTxQ1ActivePsn12S),.d(XpiPktTxQ1ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxQ2ActivePsn12C = (XpiPktTxQ2ActivePsn11C || XpiPktTxIChunkSendPsn11C) ?
				    XpiPktTxQ2ActivePsn11C : XpiPktTxQ2ActivePsn12S;
DFFR #(1,1'b0) U47_dff (.q(XpiPktTxQ2ActivePsn12S),.d(XpiPktTxQ2ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxQ3ActivePsn12C = (XpiPktTxQ3ActivePsn11C || XpiPktTxIChunkSendPsn11C) ?
				    XpiPktTxQ3ActivePsn11C : XpiPktTxQ3ActivePsn12S;
DFFR #(1,1'b0) U48_dff (.q(XpiPktTxQ3ActivePsn12S),.d(XpiPktTxQ3ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));


  assign XpiPktTxQ4ActivePsn12C = (XpiPktTxQ4ActivePsn11C || XpiPktTxEChunkSendPsn11C) ?
				    XpiPktTxQ4ActivePsn11C : XpiPktTxQ4ActivePsn12S;
DFFR #(1,1'b0) U49_dff (.q(XpiPktTxQ4ActivePsn12S),.d(XpiPktTxQ4ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxQ5ActivePsn12C = (XpiPktTxQ5ActivePsn11C || XpiPktTxEChunkSendPsn11C) ?
				    XpiPktTxQ5ActivePsn11C : XpiPktTxQ5ActivePsn12S;
DFFR #(1,1'b0) U50_dff (.q(XpiPktTxQ5ActivePsn12S),.d(XpiPktTxQ5ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxQ6ActivePsn12C = (XpiPktTxQ6ActivePsn11C || XpiPktTxEChunkSendPsn11C) ?
				    XpiPktTxQ6ActivePsn11C : XpiPktTxQ6ActivePsn12S;
DFFR #(1,1'b0) U51_dff (.q(XpiPktTxQ6ActivePsn12S),.d(XpiPktTxQ6ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxQ7ActivePsn12C = (XpiPktTxQ7ActivePsn11C || XpiPktTxEChunkSendPsn11C) ?
				    XpiPktTxQ7ActivePsn11C : XpiPktTxQ7ActivePsn12S;
DFFR #(1,1'b0) U52_dff (.q(XpiPktTxQ7ActivePsn12S),.d(XpiPktTxQ7ActivePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
    
  //----------------------------------------------------------------------------
  //---- ReCirculating Queue ID & EOPOffset Info until Entire Chunk is Send ----
  //----------------------------------------------------------------------------
  // EOP & EOP Offset Information can be used across multiple Queue ID
  // since only one queue data chunk is read out of the Fifo at a given time

  // Ingress
  assign XpiPktTxIEOPOffsetPsn12C = (XpiPktTxIEOPPsn11C || XpiPktTxIChunkSendPsn11C) ?
				      XpiPktTxIEOPOffsetPsn11C : XpiPktTxIEOPOffsetPsn12S;
  
DFFR #(6,6'b0) U53_dff (.q(XpiPktTxIEOPOffsetPsn12S),.d(XpiPktTxIEOPOffsetPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Egress
  assign XpiPktTxEEOPOffsetPsn12C = (XpiPktTxEEOPPsn11C || XpiPktTxEChunkSendPsn11C) ?
				      XpiPktTxEEOPOffsetPsn11C : XpiPktTxEEOPOffsetPsn12S;
  
DFFR #(6,6'b0) U54_dff (.q(XpiPktTxEEOPOffsetPsn12S),.d(XpiPktTxEEOPOffsetPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  assign XpiPktTxEOPOffsetPsn11C = XpiPktTxEDataIrdyPsn11C ?
	 XpiPktTxEEOPOffsetPsn11C : XpiPktTxIEOPOffsetPsn11C;
  
  //---------------------------------------------------------------------
  //---- Determining Number of Fifo Entries in the Last Packet Chunk ----
  //---------------------------------------------------------------------
  // Based upon EOP Offset, number of Fifo Entries to be read for last
  // chunk transfer are determined

  // Since packet data from either Ingress or Egress traffic is trasnfered
  // at a particular instant, overloading the last packet chunk data count logic
    
  assign XpiPktTxEOPOffsetOctet0Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C > 6'b000000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b001000));
  
  assign XpiPktTxEOPOffsetOctet1Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C >  6'b001000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b010000));
  
  assign XpiPktTxEOPOffsetOctet2Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C >  6'b010000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b011000));
  
  assign XpiPktTxEOPOffsetOctet3Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C >  6'b011000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b100000));
  
  assign XpiPktTxEOPOffsetOctet4Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C >  6'b100000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b101000));
  
  assign XpiPktTxEOPOffsetOctet5Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C >  6'b101000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b110000));
  
  assign XpiPktTxEOPOffsetOctet6Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  (XpiPktTxEOPOffsetPsn11C >  6'b110000) &&
					  (XpiPktTxEOPOffsetPsn11C <= 6'b111000));
    
  assign XpiPktTxEOPOffsetOctet7Psn11C = ((XpiPktTxIEOPPsn11C || XpiPktTxEEOPPsn11C) &&
					  ((XpiPktTxEOPOffsetPsn11C >  6'b111000) ||
					   (XpiPktTxEOPOffsetPsn11C == 6'b000000)));
  
  //--------------------------------------------------------------
  //---- ReCirculating Offset Enable until Last Chunk is Read ----
  //--------------------------------------------------------------
  
  assign XpiPktTxChunkSendPsn12C = (XpiPktTxIChunkSendPsn11C || 
				    XpiPktTxEChunkSendPsn11C);
  
  assign XpiPktTxEOPOffsetOctet0Psn12C =
         (XpiPktTxEOPOffsetOctet0Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet0Psn11C : XpiPktTxEOPOffsetOctet0Psn12S;
  
DFFR #(1,1'b0) U55_dff (.q(XpiPktTxEOPOffsetOctet0Psn12S),.d(XpiPktTxEOPOffsetOctet0Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet1Psn12C =
         (XpiPktTxEOPOffsetOctet1Psn11C ||  XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet1Psn11C : XpiPktTxEOPOffsetOctet1Psn12S;
  
DFFR #(1,1'b0) U56_dff (.q(XpiPktTxEOPOffsetOctet1Psn12S),.d(XpiPktTxEOPOffsetOctet1Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet2Psn12C =
         (XpiPktTxEOPOffsetOctet2Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet2Psn11C : XpiPktTxEOPOffsetOctet2Psn12S;
  
DFFR #(1,1'b0) U57_dff (.q(XpiPktTxEOPOffsetOctet2Psn12S),.d(XpiPktTxEOPOffsetOctet2Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet3Psn12C =
         (XpiPktTxEOPOffsetOctet3Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet3Psn11C : XpiPktTxEOPOffsetOctet3Psn12S;
  
DFFR #(1,1'b0) U58_dff (.q(XpiPktTxEOPOffsetOctet3Psn12S),.d(XpiPktTxEOPOffsetOctet3Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet4Psn12C =
         (XpiPktTxEOPOffsetOctet4Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet4Psn11C : XpiPktTxEOPOffsetOctet4Psn12S;
  
DFFR #(1,1'b0) U59_dff (.q(XpiPktTxEOPOffsetOctet4Psn12S),.d(XpiPktTxEOPOffsetOctet4Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet5Psn12C =
         (XpiPktTxEOPOffsetOctet5Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet5Psn11C : XpiPktTxEOPOffsetOctet5Psn12S;
  
DFFR #(1,1'b0) U60_dff (.q(XpiPktTxEOPOffsetOctet5Psn12S),.d(XpiPktTxEOPOffsetOctet5Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet6Psn12C =
         (XpiPktTxEOPOffsetOctet6Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet6Psn11C : XpiPktTxEOPOffsetOctet6Psn12S;
  
DFFR #(1,1'b0) U61_dff (.q(XpiPktTxEOPOffsetOctet6Psn12S),.d(XpiPktTxEOPOffsetOctet6Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEOPOffsetOctet7Psn12C =
         (XpiPktTxEOPOffsetOctet7Psn11C || XpiPktTxChunkSendPsn12C) ?
           XpiPktTxEOPOffsetOctet7Psn11C : XpiPktTxEOPOffsetOctet7Psn12S;
  
DFFR #(1,1'b0) U62_dff (.q(XpiPktTxEOPOffsetOctet7Psn12S),.d(XpiPktTxEOPOffsetOctet7Psn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------
  //---- Checking for Setting of Run Bit ----
  //-----------------------------------------
  
  // Ingress Queue 0
DFFR #(1,1'b0) U63_dff (.q(XpiPktTxQ0CmdRegWrValidPns11S),.d(XpiPktTxQ0CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U64_dff (.q(XpiPktTxQ0CmdRegWrValidPns12S),.d(XpiPktTxQ0CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ0RunPns11C = XpiPktTxQ0CommandRegPns10S[0];
  
  assign XpiPktTxQ0RunSetPns10C = 
	 (XpiPktTxQ0CmdRegWrValidPns12S && XpiPktTxQ0RunPns11C && XpiPktTxQ0ValidPns10C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ0RunSetPns11C = (XpiPktTxQ0RunSetPns10C || XpiPktTxQ0DescRdPsn10C) ?
				    XpiPktTxQ0RunSetPns10C : XpiPktTxQ0RunSetPns11S;
DFFR #(1,1'b0) U65_dff (.q(XpiPktTxQ0RunSetPns11S),.d(XpiPktTxQ0RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 1
DFFR #(1,1'b0) U66_dff (.q(XpiPktTxQ1CmdRegWrValidPns11S),.d(XpiPktTxQ1CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U67_dff (.q(XpiPktTxQ1CmdRegWrValidPns12S),.d(XpiPktTxQ1CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ1RunPns11C = XpiPktTxQ1CommandRegPns10S[0];
  
  assign XpiPktTxQ1RunSetPns10C = 
	 (XpiPktTxQ1CmdRegWrValidPns12S && XpiPktTxQ1RunPns11C && XpiPktTxQ1ValidPns10C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ1RunSetPns11C = (XpiPktTxQ1RunSetPns10C || XpiPktTxQ1DescRdPsn10C) ?
				    XpiPktTxQ1RunSetPns10C : XpiPktTxQ1RunSetPns11S;
DFFR #(1,1'b0) U68_dff (.q(XpiPktTxQ1RunSetPns11S),.d(XpiPktTxQ1RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 2
DFFR #(1,1'b0) U69_dff (.q(XpiPktTxQ2CmdRegWrValidPns11S),.d(XpiPktTxQ2CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U70_dff (.q(XpiPktTxQ2CmdRegWrValidPns12S),.d(XpiPktTxQ2CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ2RunPns11C = XpiPktTxQ2CommandRegPns10S[0];
  
  assign XpiPktTxQ2RunSetPns10C = 
	 (XpiPktTxQ2CmdRegWrValidPns12S && XpiPktTxQ2ValidPns10C && XpiPktTxQ2RunPns11C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ2RunSetPns11C = (XpiPktTxQ2RunSetPns10C || XpiPktTxQ2DescRdPsn10C) ?
				    XpiPktTxQ2RunSetPns10C : XpiPktTxQ2RunSetPns11S;
DFFR #(1,1'b0) U71_dff (.q(XpiPktTxQ2RunSetPns11S),.d(XpiPktTxQ2RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Ingress Queue 3
DFFR #(1,1'b0) U72_dff (.q(XpiPktTxQ3CmdRegWrValidPns11S),.d(XpiPktTxQ3CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U73_dff (.q(XpiPktTxQ3CmdRegWrValidPns12S),.d(XpiPktTxQ3CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ3RunPns11C = XpiPktTxQ3CommandRegPns10S[0];
  
  assign XpiPktTxQ3RunSetPns10C = 
	 (XpiPktTxQ3CmdRegWrValidPns12S && XpiPktTxQ3ValidPns10C && XpiPktTxQ3RunPns11C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ3RunSetPns11C = (XpiPktTxQ3RunSetPns10C || XpiPktTxQ3DescRdPsn10C) ?
				    XpiPktTxQ3RunSetPns10C : XpiPktTxQ3RunSetPns11S;
DFFR #(1,1'b0) U74_dff (.q(XpiPktTxQ3RunSetPns11S),.d(XpiPktTxQ3RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0
DFFR #(1,1'b0) U75_dff (.q(XpiPktTxQ4CmdRegWrValidPns11S),.d(XpiPktTxQ4CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U76_dff (.q(XpiPktTxQ4CmdRegWrValidPns12S),.d(XpiPktTxQ4CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ4RunPns11C = XpiPktTxQ4CommandRegPns10S[0];
  
  assign XpiPktTxQ4RunSetPns10C = 
	 (XpiPktTxQ4CmdRegWrValidPns12S && XpiPktTxQ4ValidPns10C && XpiPktTxQ4RunPns11C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ4RunSetPns11C = (XpiPktTxQ4RunSetPns10C || XpiPktTxQ4DescRdPsn10C) ?
				    XpiPktTxQ4RunSetPns10C : XpiPktTxQ4RunSetPns11S;
DFFR #(1,1'b0) U77_dff (.q(XpiPktTxQ4RunSetPns11S),.d(XpiPktTxQ4RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1
DFFR #(1,1'b0) U78_dff (.q(XpiPktTxQ5CmdRegWrValidPns11S),.d(XpiPktTxQ5CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U79_dff (.q(XpiPktTxQ5CmdRegWrValidPns12S),.d(XpiPktTxQ5CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ5RunPns11C = XpiPktTxQ5CommandRegPns10S[0];
  
  assign XpiPktTxQ5RunSetPns10C = 
	 (XpiPktTxQ5CmdRegWrValidPns12S && XpiPktTxQ5ValidPns10C && XpiPktTxQ5RunPns11C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ5RunSetPns11C = (XpiPktTxQ5RunSetPns10C || XpiPktTxQ5DescRdPsn10C) ?
				    XpiPktTxQ5RunSetPns10C : XpiPktTxQ5RunSetPns11S;
DFFR #(1,1'b0) U80_dff (.q(XpiPktTxQ5RunSetPns11S),.d(XpiPktTxQ5RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2
DFFR #(1,1'b0) U81_dff (.q(XpiPktTxQ6CmdRegWrValidPns11S),.d(XpiPktTxQ6CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U82_dff (.q(XpiPktTxQ6CmdRegWrValidPns12S),.d(XpiPktTxQ6CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ6RunPns11C = XpiPktTxQ6CommandRegPns10S[0];
  
  assign XpiPktTxQ6RunSetPns10C = 
	 (XpiPktTxQ6CmdRegWrValidPns12S && XpiPktTxQ6ValidPns10C && XpiPktTxQ6RunPns11C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ6RunSetPns11C = (XpiPktTxQ6RunSetPns10C || XpiPktTxQ6DescRdPsn10C) ?
				    XpiPktTxQ6RunSetPns10C : XpiPktTxQ6RunSetPns11S;
DFFR #(1,1'b0) U83_dff (.q(XpiPktTxQ6RunSetPns11S),.d(XpiPktTxQ6RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3
DFFR #(1,1'b0) U84_dff (.q(XpiPktTxQ7CmdRegWrValidPns11S),.d(XpiPktTxQ7CmdRegWrValidPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U85_dff (.q(XpiPktTxQ7CmdRegWrValidPns12S),.d(XpiPktTxQ7CmdRegWrValidPns11S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ7RunPns11C = XpiPktTxQ7CommandRegPns10S[0];
  
  assign XpiPktTxQ7RunSetPns10C = 
	 (XpiPktTxQ7CmdRegWrValidPns12S && XpiPktTxQ7ValidPns10C && XpiPktTxQ7RunPns11C);
  
  // ReCirculating First Descriptor Read Enable until the Descriptor is Read
  assign XpiPktTxQ7RunSetPns11C = (XpiPktTxQ7RunSetPns10C || XpiPktTxQ7DescRdPsn10C) ?
				    XpiPktTxQ7RunSetPns10C : XpiPktTxQ7RunSetPns11S;
DFFR #(1,1'b0) U86_dff (.q(XpiPktTxQ7RunSetPns11S),.d(XpiPktTxQ7RunSetPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //---- Start Packet Transmit Operation Indicator ----
  // Since single Fifo is shared amongst 8 CPU queues, wait for
  // Run bit for all Queues to be Set
  assign XpiPktTxIStartOpPns11C = (XpiPktTxQ0RunPns11C && XpiPktTxQ1RunPns11C &&
				   XpiPktTxQ2RunPns11C && XpiPktTxQ3RunPns11C);
  
  assign XpiPktTxEStartOpPns11C = (XpiPktTxQ4RunPns11C && XpiPktTxQ5RunPns11C &&
				   XpiPktTxQ6RunPns11C && XpiPktTxQ7RunPns11C);

  //==============================================
  //==== PKT TX PACKET TRANSFER STATE MACHINE ====
  //==============================================
  // A set of 3 State Machines are the heart of Packet Transmit Operation
  // There is one independent SM for Ingress & Egress traffic that handles
  // Descriptor Read, Write Back and Packet Write operations
  // The Arbitration State Machine handles arbitration between Ingress
  // and Egress Queues and provides fairness to both streams
  
    
  //------------------------------------------------
  //---- Ingress State Transition Control Logic ----
  //------------------------------------------------

  // Control Read Enable
  assign XpiPktTxCtlRdTxnPns10C = ( (XpiPciAppPktTxAddrIrdyP11S) && 
				    (XpiPciAppPktTxCmdP11S == `CTRLRD) && 
				    (XpiPciAppPktTxValidTxnP11S) );
  
  //---- Valid Descriptor Read Indication ----

  assign XpiPktTxIReadHeadDescPns11C = 
	 ((XpiPktTxQ0RunSetPns11S || XpiPktTxQ1RunSetPns11S  ||
	   XpiPktTxQ2RunSetPns11S || XpiPktTxQ3RunSetPns11S) &&
	  (~XpiPciAppPktTxRdStopP11S));
  
  assign XpiPktTxIReadDescPns11C = 
	 ((XpiPktTxQ0NextDescRdPsn14S || XpiPktTxQ1NextDescRdPsn14S  ||
	   XpiPktTxQ2NextDescRdPsn14S || XpiPktTxQ3NextDescRdPsn14S) &&
	  (~XpiPciAppPktTxRdStopP11S));

  // ReCirculating Read Enable till Control Read Completion is Send
  assign XpiPktTxCtlRdTxnPns11C = (XpiPktTxCtlRdTxnPns10C || XpiPktTxSrvCfgRdPns10C) ?
				    XpiPktTxCtlRdTxnPns10C : XpiPktTxCtlRdTxnPns11S;
DFFR #(1,1'b0) U87_dff (.q(XpiPktTxCtlRdTxnPns11S),.d(XpiPktTxCtlRdTxnPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Complete 64B Chunk Read Indication
  assign XpiPktTxIChunkRdPsn11C     = ((~XpiPktTxIEOPPsn11C) && (~XpiPktTxIFifoEFPsn11S));
  
  // Last Fifo Entry of Last Chunk Read Indication
  assign XpiPktTxIFinalDataRdPsn11C = (XpiPktTxIEOPPsn11C && (~XpiPktTxIFifoEFPsn11S) &&
				       XpiPktTxEOPOffsetOctet0Psn11C);

DFFR #(1,1'b0) U88_dff (.q(XpiPktTxIFinalDataRdPsn11S),.d(XpiPktTxIFinalDataRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Last Chunk extending to more than one Fifo Entry Read Indication
  assign XpiPktTxILastChunkRdPsn11C = (XpiPktTxIEOPPsn11C && (~XpiPktTxIFifoEFPsn11S) &&
				       (~XpiPktTxEOPOffsetOctet0Psn12S));
  
  // ReCirculating Data Read Indication
  assign XpiPktTxIDataRdStatePsn12C = 
	 (XpiPktTxIDataRdStatePsn11C || XpiPktTxIChunkSendPsn11C) ?
	   XpiPktTxIDataRdStatePsn11C : XpiPktTxIDataRdStatePsn12S;
  
DFFR #(1,1'b0) U89_dff (.q(XpiPktTxIDataRdStatePsn12S),.d(XpiPktTxIDataRdStatePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // ReCirculating Last Chunk Indication
  assign XpiPktTxILastChunkPsn12C = 
	 (XpiPktTxILastChunkPsn11C || XpiPktTxIChunkSendPsn11C) ?
	   XpiPktTxILastChunkPsn11C : XpiPktTxILastChunkPsn12S;
  
DFFR #(1,1'b0) U90_dff (.q(XpiPktTxILastChunkPsn12S),.d(XpiPktTxILastChunkPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // ReCirculating Pending Read Indication
  assign XpiPktTxIDescRdPendingPsn11C = 
	 (XpiPktTxIDescRdPendingPsn10C || XpiPktTxIDescPh1WrEnPsn10C) ?
	   XpiPktTxIDescRdPendingPsn10C : XpiPktTxIDescRdPendingPsn11S;
  
DFFR #(1,1'b0) U91_dff (.q(XpiPktTxIDescRdPendingPsn11S),.d(XpiPktTxIDescRdPendingPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //----------------------------------------
  //---- No Buffer Available Indication ----
  //----------------------------------------
  // This indication is used to Determine No CPU buffer available condition
  // on per Queue basis, hence once Buffers are available and reprogramming
  // of Registers corresponding to that Queue occurs, normal operation resumes
  
  // Ingress Queue 0
  
  assign XpiPktTxQ0CPUOwnerPns11C = (XpiPktTxQ0DescWrPns11S && (~XpiPktTxQ0DescASICOwnerPns11C));
  
  assign XpiPktTxQ0NoBufAvailPns11C = 
	 (XpiPktTxQ0CPUOwnerPns11C || XpiPktTxQ0DescRdPsn10C) ?
	   XpiPktTxQ0CPUOwnerPns11C : XpiPktTxQ0NoBufAvailPns11S;
  
DFFR #(1,1'b0) U92_dff (.q(XpiPktTxQ0NoBufAvailPns11S),.d(XpiPktTxQ0NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 1
  
  assign XpiPktTxQ1CPUOwnerPns11C = (XpiPktTxQ1DescWrPns11S && (~XpiPktTxQ1DescASICOwnerPns11C));
  
  assign XpiPktTxQ1NoBufAvailPns11C = 
	 (XpiPktTxQ1CPUOwnerPns11C || XpiPktTxQ1DescRdPsn10C) ?
	   XpiPktTxQ1CPUOwnerPns11C : XpiPktTxQ1NoBufAvailPns11S;
  
DFFR #(1,1'b0) U93_dff (.q(XpiPktTxQ1NoBufAvailPns11S),.d(XpiPktTxQ1NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 2
  
  assign XpiPktTxQ2CPUOwnerPns11C = (XpiPktTxQ2DescWrPns11S && (~XpiPktTxQ2DescASICOwnerPns11C));
  
  assign XpiPktTxQ2NoBufAvailPns11C = 
	 (XpiPktTxQ2CPUOwnerPns11C || XpiPktTxQ2DescRdPsn10C) ?
	   XpiPktTxQ2CPUOwnerPns11C : XpiPktTxQ2NoBufAvailPns11S;
  
DFFR #(1,1'b0) U94_dff (.q(XpiPktTxQ2NoBufAvailPns11S),.d(XpiPktTxQ2NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 3
  
  assign XpiPktTxQ3CPUOwnerPns11C = (XpiPktTxQ3DescWrPns11S && (~XpiPktTxQ3DescASICOwnerPns11C));
  
  assign XpiPktTxQ3NoBufAvailPns11C = 
	 (XpiPktTxQ3CPUOwnerPns11C || XpiPktTxQ3DescRdPsn10C) ?
	   XpiPktTxQ3CPUOwnerPns11C : XpiPktTxQ3NoBufAvailPns11S;
  
DFFR #(1,1'b0) U95_dff (.q(XpiPktTxQ3NoBufAvailPns11S),.d(XpiPktTxQ3NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //------------------------------------------------------
  //---- Mapping EOP Offset to Number of Fifo Entries ----
  //------------------------------------------------------

  // Qualifier indicating completion of reading out Last Chunk data from the Fifo

  assign XpiPktTxNumFifoLocPsn11C =   
	 (((XpiPktTxEOPOffsetOctet1Psn12S) && (XpiPktTxDataCntPsn11S==4'h1))  ||
	  ((XpiPktTxEOPOffsetOctet2Psn12S) && (XpiPktTxDataCntPsn11S==4'h2))  ||
	  ((XpiPktTxEOPOffsetOctet3Psn12S) && (XpiPktTxDataCntPsn11S==4'h3))  ||
	  ((XpiPktTxEOPOffsetOctet4Psn12S) && (XpiPktTxDataCntPsn11S==4'h4))  ||
	  ((XpiPktTxEOPOffsetOctet5Psn12S) && (XpiPktTxDataCntPsn11S==4'h5))  ||
	  ((XpiPktTxEOPOffsetOctet6Psn12S) && (XpiPktTxDataCntPsn11S==4'h6))  ||
	  ((XpiPktTxEOPOffsetOctet7Psn12S) && (XpiPktTxDataCntPsn11S==4'h7)));

DFFR #(1,1'b0) U96_dff (.q(XpiPktTxIChunkSendPsn11S),.d(XpiPktTxIChunkSendPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U97_dff (.q(XpiPktTxEChunkSendPsn11S),.d(XpiPktTxEChunkSendPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxNumFifoLocPsn12C = 
	 (XpiPktTxNumFifoLocPsn11C || XpiPktTxIChunkSendPsn11S || 
	  XpiPktTxIChunkSendPsn11S) ?
	   XpiPktTxNumFifoLocPsn11C : XpiPktTxNumFifoLocPsn12S;

DFFR #(1,1'b0) U98_dff (.q(XpiPktTxNumFifoLocPsn12S),.d(XpiPktTxNumFifoLocPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-----------------------------------------------
  //---- Ingress Packet Transfer State Machine ----
  //-----------------------------------------------
  // This SM performs following functions for 4 Ingress Queues
  // (i) Descriptor Read from CPU Memory and writing to local copy
  // (ii) Descriptor Write Back to CPU memory after Packet Send is complete
  // (iii) Write Packet Data to Allocated Buffer Memory in CPU

  //---- State Definitions ----
  
`define XPIPKTTXIGIDLE           5'b00000
`define XPIPKTTXIGWAIT4GNT       5'b00001
`define XPIPKTTXIGPCIARBREQ      5'b00010
`define XPIPKTTXCTLRD            5'b00011
`define XPIPKTTXQ0DESCRD         5'b00100
`define XPIPKTTXQ1DESCRD         5'b01000
`define XPIPKTTXQ2DESCRD         5'b10000
`define XPIPKTTXQ3DESCRD         5'b00101
`define XPIPKTTXIGDESCRDCMPWAIT  5'b11100
`define XPIPKTTXIGDESCWRPHASE1   5'b01100
`define XPIPKTTXIGDESCWRPHASE2   5'b01101
`define XPIPKTTXIGDESCOWNERCHECK 5'b01001
`define XPIPKTTXIGNOBUFAVAIL     5'b01011
`define XPIPKTTXIGDESCWRBACK1    5'b11010
`define XPIPKTTXIGDESCWRSTALL    5'b01110
`define XPIPKTTXIGDESCWRBACK2    5'b11000
`define XPIPKTTXIGFIRSTCHUNK     5'b10010
`define XPIPKTTXIGFIFODATARD     5'b00110
`define XPIPKTTXIGLASTCHUNK      5'b00111
`define XPIPKTTXIGDATASTALL      5'b01111
`define XPIPKTTXIGDATAWAIT1      5'b10111
`define XPIPKTTXIGDATAWAIT2      5'b10101
`define XPIPKTTXIGCHUNKSEND      5'b10011
`define XPIPKTTXIGABORT          5'b11111
  
  // State Variables
  wire [4:0] xpipkttxigstate;
  reg [4:0]  next_xpipkttxigstate;
  
  // State Change
DFFR #(5,5'b0) U99_dff (.q(xpipkttxigstate),.d(next_xpipkttxigstate),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //---- Output Assignments ----

  always @ (/*AS*/xpipkttxigstate)
    begin
      
      XpiPktTxIngressReqPsn11C     = 1'b0;
      XpiPktTxIPciArbReqPsn12C     = 1'b0;
      XpiPktTxSrvCfgRdPns10C       = 1'b0;
      XpiPktTxQ0DescRdPsn10C       = 1'b0;
      XpiPktTxQ1DescRdPsn10C       = 1'b0;
      XpiPktTxQ2DescRdPsn10C       = 1'b0;
      XpiPktTxQ3DescRdPsn10C       = 1'b0;
      XpiPktTxIDescRdPendingPsn10C = 1'b0;
      XpiPktTxIDescPh1WrEnPsn10C   = 1'b0;
      XpiPktTxIDescPh2WrEnPsn10C   = 1'b0;
      XpiPktTxIDescWrIrdyPsn11C    = 1'b0;
      XpiPktTxIDescWrBackEn1Psn10C = 1'b0;
      XpiPktTxIDescWrBackEn2Psn10C = 1'b0;
      XpiPktTxIAddrIrdyPsn11C      = 1'b0;
      XpiPktTxIDataIrdyPsn11C      = 1'b0;
      XpiPktTxIFifoRdEnPsn10C      = 1'b0;
      XpiPktTxIDataRdStatePsn11C   = 1'b0;
      XpiPktTxIDataStallPsn11C     = 1'b0;
      XpiPktTxILastChunkPsn11C     = 1'b0;
      XpiPktTxIChunkSendPsn11C     = 1'b0;
      XpiPktTxIKillPsn11C          = 1'b0;
      
      case(xpipkttxigstate)
	
	`XPIPKTTXIGIDLE:
	  begin
	    XpiPktTxIngressReqPsn11C     = 1'b0;
	    XpiPktTxIPciArbReqPsn12C     = 1'b0;
	    XpiPktTxSrvCfgRdPns10C       = 1'b0;
	    XpiPktTxQ0DescRdPsn10C       = 1'b0;
	    XpiPktTxQ1DescRdPsn10C       = 1'b0;
	    XpiPktTxQ2DescRdPsn10C       = 1'b0;
	    XpiPktTxQ3DescRdPsn10C       = 1'b0;
	    XpiPktTxIDescRdPendingPsn10C = 1'b0;
	    XpiPktTxIDescPh1WrEnPsn10C   = 1'b0;
	    XpiPktTxIDescPh2WrEnPsn10C   = 1'b0;
	    XpiPktTxIDescWrIrdyPsn11C    = 1'b0;
	    XpiPktTxIDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxIDescWrBackEn2Psn10C = 1'b0;
	    XpiPktTxIAddrIrdyPsn11C      = 1'b0;
	    XpiPktTxIDataIrdyPsn11C      = 1'b0;
	    XpiPktTxIFifoRdEnPsn10C      = 1'b0;
	    XpiPktTxIDataRdStatePsn11C   = 1'b0;
	    XpiPktTxIDataStallPsn11C     = 1'b0;
	    XpiPktTxILastChunkPsn11C     = 1'b0;
	    XpiPktTxIChunkSendPsn11C     = 1'b0;
	    XpiPktTxIKillPsn11C          = 1'b0;
	  end
	
	`XPIPKTTXIGWAIT4GNT: XpiPktTxIngressReqPsn11C = 1'b1;
	
	`XPIPKTTXIGPCIARBREQ: XpiPktTxIPciArbReqPsn12C   = 1'b1;
	
	`XPIPKTTXCTLRD: XpiPktTxSrvCfgRdPns10C = 1'b1;
	
	`XPIPKTTXQ0DESCRD:
	  begin
	    XpiPktTxQ0DescRdPsn10C       = 1'b1;
	    XpiPktTxIDescRdPendingPsn10C = 1'b1;
	  end

	`XPIPKTTXQ1DESCRD:
	  begin
	    XpiPktTxQ1DescRdPsn10C       = 1'b1;
	    XpiPktTxIDescRdPendingPsn10C = 1'b1;
	  end

	`XPIPKTTXQ2DESCRD:
	  begin
	    XpiPktTxQ2DescRdPsn10C       = 1'b1;
	    XpiPktTxIDescRdPendingPsn10C = 1'b1;
	  end

	`XPIPKTTXQ3DESCRD:
	  begin
	    XpiPktTxQ3DescRdPsn10C       = 1'b1;
	    XpiPktTxIDescRdPendingPsn10C = 1'b1;
	  end
	
	`XPIPKTTXIGDESCRDCMPWAIT: XpiPktTxIDescRdPendingPsn10C = 1'b1;
	
	`XPIPKTTXIGDESCWRPHASE1: 
	  begin
	    XpiPktTxIDescPh1WrEnPsn10C   = 1'b1;
	    XpiPktTxIDescRdPendingPsn10C = 1'b0;
	  end
		  
	`XPIPKTTXIGDESCWRPHASE2:
	  begin
	    XpiPktTxIDescPh1WrEnPsn10C  = 1'b0;
	    XpiPktTxIDescPh2WrEnPsn10C  = 1'b1;
	    XpiPktTxIDescWrIrdyPsn11C   = 1'b1;
	  end
	    
	`XPIPKTTXIGDESCOWNERCHECK: XpiPktTxIDescPh2WrEnPsn10C  = 1'b0;

	`XPIPKTTXIGNOBUFAVAIL: ;
	
	`XPIPKTTXIGDESCWRBACK1:
	  begin
	    XpiPktTxIDescWrIrdyPsn11C    = 1'b1;
	    XpiPktTxIDescWrBackEn1Psn10C = 1'b1;
	    XpiPktTxIDescWrBackEn2Psn10C = 1'b0;
	  end
		    
	`XPIPKTTXIGDESCWRSTALL:
	  begin
	    XpiPktTxIDescWrIrdyPsn11C    = 1'b1;
	    XpiPktTxIDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxIDescWrBackEn2Psn10C = 1'b0;
	  end

	`XPIPKTTXIGDESCWRBACK2:
	  begin
	    XpiPktTxIDescWrIrdyPsn11C    = 1'b1;
	    XpiPktTxIDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxIDescWrBackEn2Psn10C = 1'b1;
	  end

	`XPIPKTTXIGFIRSTCHUNK: 
	  begin
	    XpiPktTxIAddrIrdyPsn11C  = 1'b1;
	    XpiPktTxIDataIrdyPsn11C  = 1'b1;
	    XpiPktTxIFifoRdEnPsn10C  = 1'b1;
	  end
	
	`XPIPKTTXIGFIFODATARD: 
	  begin
	    XpiPktTxIAddrIrdyPsn11C    = 1'b0;
	    XpiPktTxIDataIrdyPsn11C    = 1'b1;
	    XpiPktTxIFifoRdEnPsn10C    = 1'b1;
	    XpiPktTxIDataRdStatePsn11C = 1'b1;
	    XpiPktTxIDataStallPsn11C   = 1'b0;
	  end
	
	`XPIPKTTXIGLASTCHUNK:
	  begin
	    XpiPktTxIAddrIrdyPsn11C   = 1'b0;
	    XpiPktTxIDataIrdyPsn11C   = 1'b1;
	    XpiPktTxIFifoRdEnPsn10C   = 1'b1;
	    XpiPktTxILastChunkPsn11C  = 1'b1;
	    XpiPktTxIDataStallPsn11C  = 1'b0;
	  end
       
	`XPIPKTTXIGDATAWAIT1:
	  begin
	    XpiPktTxIDataIrdyPsn11C    = 1'b1;
	    XpiPktTxIFifoRdEnPsn10C    = 1'b0;
	  end

	`XPIPKTTXIGDATAWAIT2:
	  begin
	    XpiPktTxIDataIrdyPsn11C    = 1'b1;
	    XpiPktTxIFifoRdEnPsn10C    = 1'b0;
	  end
	    
	`XPIPKTTXIGDATASTALL: 
	  begin
	    XpiPktTxIAddrIrdyPsn11C    = 1'b0;
	    XpiPktTxIDataIrdyPsn11C    = 1'b1;
	    XpiPktTxIFifoRdEnPsn10C    = 1'b0;
	    XpiPktTxIDataRdStatePsn11C = 1'b0;
	    XpiPktTxILastChunkPsn11C   = 1'b0;
	    XpiPktTxIDataStallPsn11C   = 1'b1;
	  end
	
	`XPIPKTTXIGCHUNKSEND: XpiPktTxIChunkSendPsn11C   = 1'b1;

	`XPIPKTTXIGABORT: XpiPktTxIKillPsn11C = 1'b1;
	
	default:
	  begin
	    XpiPktTxIngressReqPsn11C     = 1'b0;
	    XpiPktTxIPciArbReqPsn12C     = 1'b0;
	    XpiPktTxSrvCfgRdPns10C       = 1'b0;
	    XpiPktTxQ0DescRdPsn10C       = 1'b0;
	    XpiPktTxQ1DescRdPsn10C       = 1'b0;
	    XpiPktTxQ2DescRdPsn10C       = 1'b0;
	    XpiPktTxQ3DescRdPsn10C       = 1'b0;
	    XpiPktTxIDescRdPendingPsn10C = 1'b0;
	    XpiPktTxIDescPh1WrEnPsn10C   = 1'b0;
	    XpiPktTxIDescPh2WrEnPsn10C   = 1'b0;
	    XpiPktTxIDescWrIrdyPsn11C    = 1'b0;
	    XpiPktTxIDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxIDescWrBackEn2Psn10C = 1'b0;
	    XpiPktTxIAddrIrdyPsn11C      = 1'b0;
	    XpiPktTxIDataIrdyPsn11C      = 1'b0;
	    XpiPktTxIFifoRdEnPsn10C      = 1'b0;
	    XpiPktTxIDataRdStatePsn11C   = 1'b0;
	    XpiPktTxIDataStallPsn11C     = 1'b0;
	    XpiPktTxILastChunkPsn11C     = 1'b0;
	    XpiPktTxIChunkSendPsn11C     = 1'b0;
	    XpiPktTxIKillPsn11C          = 1'b0;
	  end
	
      endcase // case(xpipkttxigstate)
    end // always @ (...
  
  //---- State Transitions ----

  always @(/*AS*/XpiPciAppPktTxDataIrdyP11S or XpiPciAppPktTxTrdyP10S
	   or XpiPciAppPktTxTrdyP11S or XpiPciAppPktTxValidTxnP11S
	   or XpiPciArbPktTxBusyP11S or XpiPciArbPktTxReqAbortP11S
	   or XpiPciArbPktTxSplitAbortP11S or XpiPciArbPktTxSrvP11S
	   or XpiPciArbPktTxStopP11S or XpiPktTxCtlRdTxnPns11S
	   or XpiPktTxDataCntPsn11S or XpiPktTxIChunkRdPsn11C
	   or XpiPktTxIDataRdStatePsn12S
	   or XpiPktTxIDescRdPendingPsn11S or XpiPktTxIFifoEFPsn11S
	   or XpiPktTxIFinalDataRdPsn11C or XpiPktTxILastChunkPsn12S
	   or XpiPktTxILastChunkRdPsn11C or XpiPktTxIPktCmpltPsn12C
	   or XpiPktTxIReadDescPns11C or XpiPktTxIReadHeadDescPns11C
	   or XpiPktTxIStartOpPns11C or XpiPktTxIngressGoPsn11C
	   or XpiPktTxNumFifoLocPsn11C or XpiPktTxNumFifoLocPsn12S
	   or XpiPktTxQ0CPUOwnerPns11C
	   or XpiPktTxQ0DescASICOwnerPns11C or XpiPktTxQ0DescWrPns11S
	   or XpiPktTxQ0NextDescRdPsn14S or XpiPktTxQ0NoBufAvailPns11S
	   or XpiPktTxQ0RunSetPns11S or XpiPktTxQ1CPUOwnerPns11C
	   or XpiPktTxQ1DescASICOwnerPns11C or XpiPktTxQ1DescWrPns11S
	   or XpiPktTxQ1NextDescRdPsn14S or XpiPktTxQ1NoBufAvailPns11S
	   or XpiPktTxQ1RunSetPns11S or XpiPktTxQ2CPUOwnerPns11C
	   or XpiPktTxQ2DescASICOwnerPns11C or XpiPktTxQ2DescWrPns11S
	   or XpiPktTxQ2NextDescRdPsn14S or XpiPktTxQ2NoBufAvailPns11S
	   or XpiPktTxQ2RunSetPns11S or XpiPktTxQ3CPUOwnerPns11C
	   or XpiPktTxQ3DescASICOwnerPns11C or XpiPktTxQ3DescWrPns11S
	   or XpiPktTxQ3NextDescRdPsn14S or XpiPktTxQ3NoBufAvailPns11S
	   or XpiPktTxQ3RunSetPns11S or XpiPktTxSrvCfgWrPns10C
	   or xpipkttxigstate)
    begin
      
      case(xpipkttxigstate)
	
	`XPIPKTTXIGIDLE: 	           
	  begin
	    // Read the First Descriptor if Run Bit is Set
	    // If Fifo is Non-Empty, Read the Packet Chunk
	    // and Issue PCI Write for CPU Memory,
	    // Packet transmit complete, write back the Descriptor to CPU memory
	    if ((XpiPktTxIReadHeadDescPns11C || XpiPktTxIReadDescPns11C   || 
		 XpiPktTxCtlRdTxnPns11S      || XpiPktTxIPktCmpltPsn12C   ||
		 ((~XpiPktTxIFifoEFPsn11S)   && XpiPktTxIStartOpPns11C))  &&
		((~XpiPciArbPktTxBusyP11S)   && (~XpiPciArbPktTxStopP11S) &&
		 (~XpiPciArbPktTxSrvP11S)))
	      next_xpipkttxigstate = `XPIPKTTXIGWAIT4GNT;
	    else 
	      next_xpipkttxigstate = `XPIPKTTXIGIDLE;
	  end

	`XPIPKTTXIGWAIT4GNT:
	  begin
	    if (XpiPktTxIngressGoPsn11C)
	      // Ingress Traffic given a Green signal to proceed,
	      // arbitrate for PCI Bus
	      next_xpipkttxigstate = `XPIPKTTXIGPCIARBREQ;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGWAIT4GNT;
	  end
	
	`XPIPKTTXIGPCIARBREQ: // Issue Request for Time Slice to the Arbiter
	  begin
	    if (XpiPktTxCtlRdTxnPns11S && XpiPciArbPktTxSrvP11S &&
		(~XpiPciArbPktTxBusyP11S))
	      // Control register Read is given first priority
	      next_xpipkttxigstate = `XPIPKTTXCTLRD;
	    else if (XpiPktTxIPktCmpltPsn12C && XpiPciArbPktTxSrvP11S &&
		     (~XpiPciArbPktTxBusyP11S))
	      // Packet transmission complete, transition to Descriptor Write
	      // State, to write back the descriptor to CPU memory
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRBACK1;
	    else if ((XpiPktTxQ0RunSetPns11S || XpiPktTxQ0NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S   && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxigstate = `XPIPKTTXQ0DESCRD;
	    else if ((XpiPktTxQ1RunSetPns11S || XpiPktTxQ1NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S   && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxigstate = `XPIPKTTXQ1DESCRD;
	    else if ((XpiPktTxQ2RunSetPns11S || XpiPktTxQ2NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S   && (~XpiPciArbPktTxBusyP11S)) 
	      next_xpipkttxigstate = `XPIPKTTXQ2DESCRD;
	    else if ((XpiPktTxQ3RunSetPns11S || XpiPktTxQ3NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S   && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxigstate = `XPIPKTTXQ3DESCRD;
	    else if ((~XpiPktTxIFifoEFPsn11S) && XpiPktTxIStartOpPns11C && 
		     XpiPciArbPktTxSrvP11S && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxigstate = `XPIPKTTXIGFIRSTCHUNK;	    
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGPCIARBREQ;
	  end
	
	`XPIPKTTXCTLRD: // Control Register Read Operation
	  begin
	    if (XpiPktTxIDescRdPendingPsn11S)
	      // Pending Descriptor Read
	      next_xpipkttxigstate = `XPIPKTTXIGDESCRDCMPWAIT;
	    else if (XpiPktTxQ0NoBufAvailPns11S || XpiPktTxQ1NoBufAvailPns11S ||
		     XpiPktTxQ2NoBufAvailPns11S || XpiPktTxQ3NoBufAvailPns11S)
	      next_xpipkttxigstate = `XPIPKTTXIGNOBUFAVAIL;
	    else	      
	      next_xpipkttxigstate = `XPIPKTTXIGIDLE;
	  end
	
	`XPIPKTTXQ0DESCRD: // Ingress Queue 0 Descriptor Read
	  next_xpipkttxigstate = `XPIPKTTXIGDESCRDCMPWAIT;
	
	`XPIPKTTXQ1DESCRD: // Ingress Queue 1 Descriptor Read
	  next_xpipkttxigstate = `XPIPKTTXIGDESCRDCMPWAIT;
	
	`XPIPKTTXQ2DESCRD: // Ingress Queue 2 Descriptor Read
	  next_xpipkttxigstate = `XPIPKTTXIGDESCRDCMPWAIT;
	
	`XPIPKTTXQ3DESCRD: // Ingress Queue 3 Descriptor Read
	  next_xpipkttxigstate = `XPIPKTTXIGDESCRDCMPWAIT;
	
	`XPIPKTTXIGDESCRDCMPWAIT: // Receive Descriptor Read Completion Data
	  begin
	    if (XpiPciAppPktTxDataIrdyP11S && XpiPciAppPktTxValidTxnP11S && 
		(~XpiPktTxSrvCfgWrPns10C))
	      // Descriptor Read completion data received,
	      // transition to Descriptor Write phase
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRPHASE1;
	    else if (XpiPktTxCtlRdTxnPns11S && (~XpiPciArbPktTxSrvP11S) &&
		     (~XpiPciArbPktTxBusyP11S))
	      // While waiting for Read completion,
	      // control register read received
	      next_xpipkttxigstate = `XPIPKTTXIGWAIT4GNT;
	    else if (XpiPciArbPktTxReqAbortP11S || XpiPciArbPktTxSplitAbortP11S)
	      // Abort Completion received for Read request or
	      // Error occured during split completion
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDESCRDCMPWAIT;
	  end
	
	`XPIPKTTXIGDESCWRPHASE1: next_xpipkttxigstate = `XPIPKTTXIGDESCWRPHASE2;
	
	`XPIPKTTXIGDESCWRPHASE2: 
	  begin
	    if (~(XpiPciAppPktTxDataIrdyP11S && XpiPciAppPktTxValidTxnP11S))
	      next_xpipkttxigstate = `XPIPKTTXIGDESCOWNERCHECK;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRPHASE2;
	  end

	`XPIPKTTXIGDESCOWNERCHECK:
	  begin
	    // If CPU Ownership Set, no Buffer Available condition, wait for reprogramming
	    // else ASIC Ownership Set, continue Packet Send operation
	    if (XpiPktTxQ0CPUOwnerPns11C || XpiPktTxQ1CPUOwnerPns11C ||
		XpiPktTxQ2CPUOwnerPns11C || XpiPktTxQ3CPUOwnerPns11C)
	      next_xpipkttxigstate = `XPIPKTTXIGNOBUFAVAIL;
	    else if ((XpiPktTxQ0DescWrPns11S &&
		      XpiPktTxQ0DescASICOwnerPns11C) ||
		     (XpiPktTxQ1DescWrPns11S &&
		      XpiPktTxQ1DescASICOwnerPns11C) ||
		     (XpiPktTxQ2DescWrPns11S &&
		      XpiPktTxQ2DescASICOwnerPns11C) ||
		     (XpiPktTxQ3DescWrPns11S &&
		      XpiPktTxQ3DescASICOwnerPns11C))
	      // ASIC Ownership set, tranisition to Idle
	      next_xpipkttxigstate = `XPIPKTTXIGIDLE;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDESCOWNERCHECK;
	  end	  
	
	`XPIPKTTXIGNOBUFAVAIL:
	  begin
	    if ((XpiPktTxQ0NoBufAvailPns11S && XpiPktTxQ0RunSetPns11S) ||
		(XpiPktTxQ1NoBufAvailPns11S && XpiPktTxQ1RunSetPns11S) ||
		(XpiPktTxQ2NoBufAvailPns11S && XpiPktTxQ2RunSetPns11S) ||
		(XpiPktTxQ3NoBufAvailPns11S && XpiPktTxQ3RunSetPns11S) ||
		XpiPktTxCtlRdTxnPns11S && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxigstate = `XPIPKTTXIGWAIT4GNT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGNOBUFAVAIL;
	  end
	
	`XPIPKTTXIGDESCWRBACK1:
	  begin
	    if (~XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRSTALL;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRBACK2;
	  end
	
	`XPIPKTTXIGDESCWRSTALL:
	  begin
	    if (XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRBACK2;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDESCWRSTALL;
	  end
	
	`XPIPKTTXIGDESCWRBACK2: 
	  begin
	    if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGIDLE;
	  end
	
	`XPIPKTTXIGFIRSTCHUNK:
	  begin
	    if (XpiPktTxIChunkRdPsn11C && XpiPciAppPktTxTrdyP11S)
	      // All Chunks except Last Chunk
	      next_xpipkttxigstate = `XPIPKTTXIGFIFODATARD;
	    else if (XpiPktTxIFinalDataRdPsn11C && XpiPciAppPktTxTrdyP11S)
	      // Last 64B Chunk, but <8B Data Valid 
	      next_xpipkttxigstate = `XPIPKTTXIGCHUNKSEND;
	    else if (XpiPktTxILastChunkRdPsn11C && XpiPciAppPktTxTrdyP11S)
	      // Last 64B Chunk, but >8B Data Valid 
	      next_xpipkttxigstate = `XPIPKTTXIGLASTCHUNK;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGFIRSTCHUNK;
	  end
	
	`XPIPKTTXIGFIFODATARD:
	  begin
	    if ( (~XpiPciAppPktTxTrdyP10S) && (~(XpiPktTxDataCntPsn11S == 4'h7)) )
	      // Backpressue asserted, Data Xfr incomplete
	      next_xpipkttxigstate = `XPIPKTTXIGDATASTALL;
	    else if ((~XpiPktTxIFifoEFPsn11S) && (XpiPktTxDataCntPsn11S == 4'h7))
	      // 64B Chunk Transfer complete
	      next_xpipkttxigstate = `XPIPKTTXIGCHUNKSEND;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGFIFODATARD;
	  end
	
	`XPIPKTTXIGLASTCHUNK:
	  begin
	    if ( (~XpiPciAppPktTxTrdyP10S) && (~XpiPktTxIFifoEFPsn11S) )
	      // Back pressure occuring before completion of Data Xfr
	      next_xpipkttxigstate = `XPIPKTTXIGDATASTALL;
	    else if (XpiPktTxNumFifoLocPsn11C)
	      // Mapping EOP offset to Number of Fifo Entries to read,
	      // once all required Data is read, transition to Chunk Send state
	      // Note: Backpressure could occur during the final data phase
	      // transfer wherein data is read out of the Fifo but not issued
	      // onto PCI bus, transition to WAIT state and then to
	      // CHUNKSEND once no backpressure exists
	      next_xpipkttxigstate = `XPIPKTTXIGDATAWAIT1;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGLASTCHUNK;
	  end

	`XPIPKTTXIGDATAWAIT1:
	  begin
	    if (XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxigstate = `XPIPKTTXIGDATAWAIT2;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDATAWAIT1;
	  end

	`XPIPKTTXIGDATAWAIT2:
	  begin
	    if (XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxigstate = `XPIPKTTXIGCHUNKSEND;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDATAWAIT2;
	  end
	      
	`XPIPKTTXIGDATASTALL:
	  begin
	    if (XpiPktTxIDataRdStatePsn12S && (XpiPktTxDataCntPsn11S==4'h7) &&
		XpiPciAppPktTxTrdyP10S && (~XpiPciArbPktTxStopP11S))
	      // Stall occured during the Last 8B Data Transfer of a Full 64B chunk
	      // Once stall is cleared tranition to Chunk Send state
	      next_xpipkttxigstate = `XPIPKTTXIGCHUNKSEND;
	    else if (XpiPktTxIDataRdStatePsn12S && XpiPciAppPktTxTrdyP10S && 
		     (~XpiPciArbPktTxStopP11S))
	      // Stall in the middle of Data Transfer is cleared
	      next_xpipkttxigstate = `XPIPKTTXIGFIFODATARD;
	    else if (XpiPktTxILastChunkPsn12S && XpiPciAppPktTxTrdyP10S &&
		     (XpiPktTxNumFifoLocPsn12S || XpiPktTxIFifoEFPsn11S) &&
		     (~XpiPciArbPktTxStopP11S))
	      // Last Chunk Transfer and Stall occuring during Last 8B Data Xfr
	      //next_xpipkttxigstate = `XPIPKTTXIGCHUNKSEND;
	      next_xpipkttxigstate = `XPIPKTTXIGDATAWAIT1;
	    else if (XpiPktTxILastChunkPsn12S && XpiPciAppPktTxTrdyP10S && 
		     (~XpiPktTxIFifoEFPsn11S) && (~XpiPciArbPktTxStopP11S) )
	      // Last Chunk Transfer and Stall occuring before the Last 8B Data Xfr
	      next_xpipkttxigstate = `XPIPKTTXIGLASTCHUNK;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxigstate = `XPIPKTTXIGABORT;
	    else
	      next_xpipkttxigstate = `XPIPKTTXIGDATASTALL;
	  end
	
	`XPIPKTTXIGCHUNKSEND: next_xpipkttxigstate = `XPIPKTTXIGIDLE;

	`XPIPKTTXIGABORT: next_xpipkttxigstate = `XPIPKTTXIGIDLE;
	
	default: next_xpipkttxigstate = `XPIPKTTXIGIDLE;

      endcase // case(xpipkttxigstate)
    end // always @ (...
  

  //-----------------------------------------------
  //---- Egress State Transition Control Logic ----
  //-----------------------------------------------
  
  //---- Valid Descriptor Read Indication ----

  assign XpiPktTxEReadHeadDescPns11C = 
  	 ((XpiPktTxQ4RunSetPns11S || XpiPktTxQ5RunSetPns11S  ||
	   XpiPktTxQ6RunSetPns11S || XpiPktTxQ7RunSetPns11S) &&
	  (~XpiPciAppPktTxRdStopP11S));
  
  assign XpiPktTxEReadDescPns11C = 
  	 ((XpiPktTxQ4NextDescRdPsn14S || XpiPktTxQ5NextDescRdPsn14S  ||
	   XpiPktTxQ6NextDescRdPsn14S || XpiPktTxQ7NextDescRdPsn14S) &&
	  (~XpiPciAppPktTxRdStopP11S));

  // Complete 64B Chunk Read Indication
  assign XpiPktTxEChunkRdPsn11C     = ((~XpiPktTxEEOPPsn11C) && (~XpiPktTxEFifoEFPsn11S));
  
  // Last Fifo Entry of Last Chunk Read Indication
  assign XpiPktTxEFinalDataRdPsn11C = (XpiPktTxEEOPPsn11C && (~XpiPktTxEFifoEFPsn11S) &&
				       XpiPktTxEOPOffsetOctet0Psn11C);

DFFR #(1,1'b0) U100_dff (.q(XpiPktTxEFinalDataRdPsn11S),.d(XpiPktTxEFinalDataRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Last Chunk extending to more than one Fifo Entry Read Indication
  assign XpiPktTxELastChunkRdPsn11C = (XpiPktTxEEOPPsn11C && (~XpiPktTxEFifoEFPsn11S) &&
				       (~XpiPktTxEOPOffsetOctet0Psn12S));
  
  // ReCirculating Data Read Indication
  assign XpiPktTxEDataRdStatePsn12C = 
	 (XpiPktTxEDataRdStatePsn11C || XpiPktTxEChunkSendPsn11C) ?
	   XpiPktTxEDataRdStatePsn11C : XpiPktTxEDataRdStatePsn12S;
  
DFFR #(1,1'b0) U101_dff (.q(XpiPktTxEDataRdStatePsn12S),.d(XpiPktTxEDataRdStatePsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // ReCirculating Last Chunk Indication
  assign XpiPktTxELastChunkPsn12C = 
	 (XpiPktTxELastChunkPsn11C || XpiPktTxEChunkSendPsn11C) ?
	   XpiPktTxELastChunkPsn11C : XpiPktTxELastChunkPsn12S;
  
DFFR #(1,1'b0) U102_dff (.q(XpiPktTxELastChunkPsn12S),.d(XpiPktTxELastChunkPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
    
  //----------------------------------------
  //---- No Buffer Available Indication ----
  //----------------------------------------
  // This indication is used to Determine No CPU buffer available condition
  // on per Queue basis, hence once Buffers are available and reprogramming
  // of Registers corresponding to that Queue occurs, normal operation resumes

  // Egress Queue 0
  
  assign XpiPktTxQ4CPUOwnerPns11C = (XpiPktTxQ4DescWrPns11S && (~XpiPktTxQ4DescASICOwnerPns11C));
  
  assign XpiPktTxQ4NoBufAvailPns11C = 
	 (XpiPktTxQ4CPUOwnerPns11C || XpiPktTxQ4DescRdPsn10C) ?
	   XpiPktTxQ4CPUOwnerPns11C : XpiPktTxQ4NoBufAvailPns11S;
	
DFFR #(1,1'b0) U103_dff (.q(XpiPktTxQ4NoBufAvailPns11S),.d(XpiPktTxQ4NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1
  
  assign XpiPktTxQ5CPUOwnerPns11C = (XpiPktTxQ5DescWrPns11S && (~XpiPktTxQ5DescASICOwnerPns11C));
  
  assign XpiPktTxQ5NoBufAvailPns11C = 
	 (XpiPktTxQ5CPUOwnerPns11C || XpiPktTxQ5DescRdPsn10C) ?
	   XpiPktTxQ5CPUOwnerPns11C : XpiPktTxQ5NoBufAvailPns11S;
	
DFFR #(1,1'b0) U104_dff (.q(XpiPktTxQ5NoBufAvailPns11S),.d(XpiPktTxQ5NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2
  
  assign XpiPktTxQ6CPUOwnerPns11C = (XpiPktTxQ6DescWrPns11S && (~XpiPktTxQ6DescASICOwnerPns11C));
  
  assign XpiPktTxQ6NoBufAvailPns11C = 
	 (XpiPktTxQ6CPUOwnerPns11C || XpiPktTxQ6DescRdPsn10C) ?
	   XpiPktTxQ6CPUOwnerPns11C : XpiPktTxQ6NoBufAvailPns11S;
  
DFFR #(1,1'b0) U105_dff (.q(XpiPktTxQ6NoBufAvailPns11S),.d(XpiPktTxQ6NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3
  
  assign XpiPktTxQ7CPUOwnerPns11C = (XpiPktTxQ7DescWrPns11S && (~XpiPktTxQ7DescASICOwnerPns11C));
  
  assign XpiPktTxQ7NoBufAvailPns11C = 
	 (XpiPktTxQ7CPUOwnerPns11C || XpiPktTxQ7DescRdPsn10C) ?
	   XpiPktTxQ7CPUOwnerPns11C : XpiPktTxQ7NoBufAvailPns11S;
  
DFFR #(1,1'b0) U106_dff (.q(XpiPktTxQ7NoBufAvailPns11S),.d(XpiPktTxQ7NoBufAvailPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //-----------------------------------------------
  //---- Egress Packet Transfer State Machine ----
  //-----------------------------------------------
  // This SM performs following functions for 4 Egress Queues
  // (i) Descriptor Read from CPU Memory and writing to local copy
  // (ii) Descriptor Write Back to CPU memory after Packet Send is complete
  // (iii) Write Packet Data to Allocated Buffer Memory in CPU

  //---- State Definitions ----
  
`define XPIPKTTXEGIDLE           5'b00000
`define XPIPKTTXEGWAIT4GNT       5'b00001
`define XPIPKTTXEGPCIARBREQ      5'b00010
`define XPIPKTTXQ4DESCRD         5'b00100
`define XPIPKTTXQ5DESCRD         5'b01000
`define XPIPKTTXQ6DESCRD         5'b10000
`define XPIPKTTXQ7DESCRD         5'b00101
`define XPIPKTTXEGDESCRDCMPWAIT  5'b11100
`define XPIPKTTXEGDESCWRPHASE1   5'b01100
`define XPIPKTTXEGDESCWRPHASE2   5'b01101
`define XPIPKTTXEGDESCOWNERCHECK 5'b01001
`define XPIPKTTXEGNOBUFAVAIL     5'b01011
`define XPIPKTTXEGDESCWRBACK1    5'b11010
`define XPIPKTTXEGDESCWRSTALL    5'b01110
`define XPIPKTTXEGDESCWRBACK2    5'b11000
`define XPIPKTTXEGFIRSTCHUNK     5'b10010
`define XPIPKTTXEGFIFODATARD     5'b00110
`define XPIPKTTXEGLASTCHUNK      5'b00111
`define XPIPKTTXEGDATASTALL      5'b01111
`define XPIPKTTXEGDATAWAIT1      5'b10111
`define XPIPKTTXEGDATAWAIT2      5'b10101
`define XPIPKTTXEGCHUNKSEND      5'b10011
`define XPIPKTTXEGABORT          5'b11111

  // State Variables
  wire [4:0] xpipkttxegstate;
  reg [4:0]  next_xpipkttxegstate;
  
  // State Change
DFFR #(5,5'b0) U107_dff (.q(xpipkttxegstate),.d(next_xpipkttxegstate),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //---- Output Assignments ----

  always @ (/*AS*/xpipkttxegstate)
    begin
      
      XpiPktTxEgressReqPsn11C      = 1'b0;
      XpiPktTxEPciArbReqPsn12C     = 1'b0;
      XpiPktTxQ4DescRdPsn10C       = 1'b0;
      XpiPktTxQ5DescRdPsn10C       = 1'b0;
      XpiPktTxQ6DescRdPsn10C       = 1'b0;
      XpiPktTxQ7DescRdPsn10C       = 1'b0;
      XpiPktTxEDescPh1WrEnPsn10C   = 1'b0;
      XpiPktTxEDescPh2WrEnPsn10C   = 1'b0;
      XpiPktTxEDescWrIrdyPsn11C    = 1'b0;
      XpiPktTxEDescWrBackEn1Psn10C = 1'b0;
      XpiPktTxEDescWrBackEn2Psn10C = 1'b0;
      XpiPktTxEAddrIrdyPsn11C      = 1'b0;
      XpiPktTxEDataIrdyPsn11C      = 1'b0;
      XpiPktTxEFifoRdEnPsn10C      = 1'b0;
      XpiPktTxEDataRdStatePsn11C   = 1'b0;
      XpiPktTxEDataStallPsn11C     = 1'b0;
      XpiPktTxELastChunkPsn11C     = 1'b0;
      XpiPktTxEChunkSendPsn11C     = 1'b0;
      XpiPktTxEKillPsn11C          = 1'b0;
      
      case(xpipkttxegstate)
	
	`XPIPKTTXEGIDLE:
	  begin
	    XpiPktTxEgressReqPsn11C      = 1'b0;
	    XpiPktTxEPciArbReqPsn12C     = 1'b0;
	    XpiPktTxQ4DescRdPsn10C       = 1'b0;
	    XpiPktTxQ5DescRdPsn10C       = 1'b0;
	    XpiPktTxQ6DescRdPsn10C       = 1'b0;
	    XpiPktTxQ7DescRdPsn10C       = 1'b0;
	    XpiPktTxEDescPh1WrEnPsn10C   = 1'b0;
	    XpiPktTxEDescPh2WrEnPsn10C   = 1'b0;
	    XpiPktTxEDescWrIrdyPsn11C    = 1'b0;
	    XpiPktTxEDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxEDescWrBackEn2Psn10C = 1'b0;
	    XpiPktTxEAddrIrdyPsn11C      = 1'b0;
	    XpiPktTxEDataIrdyPsn11C      = 1'b0;
	    XpiPktTxEFifoRdEnPsn10C      = 1'b0;
	    XpiPktTxEDataRdStatePsn11C   = 1'b0;
	    XpiPktTxEDataStallPsn11C     = 1'b0;
	    XpiPktTxELastChunkPsn11C     = 1'b0;
	    XpiPktTxEChunkSendPsn11C     = 1'b0;
	    XpiPktTxEKillPsn11C          = 1'b0;
	  end
	
	`XPIPKTTXEGWAIT4GNT: XpiPktTxEgressReqPsn11C  = 1'b1;
	
	`XPIPKTTXEGPCIARBREQ: XpiPktTxEPciArbReqPsn12C   = 1'b1;
	
	`XPIPKTTXQ4DESCRD: XpiPktTxQ4DescRdPsn10C       = 1'b1;

	`XPIPKTTXQ5DESCRD: XpiPktTxQ5DescRdPsn10C       = 1'b1;

	`XPIPKTTXQ6DESCRD: XpiPktTxQ6DescRdPsn10C       = 1'b1;

	`XPIPKTTXQ7DESCRD: XpiPktTxQ7DescRdPsn10C       = 1'b1;
	
	`XPIPKTTXEGDESCRDCMPWAIT: ;
	
	`XPIPKTTXEGDESCWRPHASE1: 
	  begin
	    XpiPktTxEDescPh1WrEnPsn10C   = 1'b1;
	  end
	
	`XPIPKTTXEGDESCWRPHASE2:
	  begin
	    XpiPktTxEDescPh1WrEnPsn10C  = 1'b0;
	    XpiPktTxEDescPh2WrEnPsn10C  = 1'b1;
	  end
	
	`XPIPKTTXEGDESCOWNERCHECK: XpiPktTxEDescPh2WrEnPsn10C  = 1'b0;
	
	`XPIPKTTXEGNOBUFAVAIL: ;
	
	`XPIPKTTXEGDESCWRBACK1:
	  begin
	    XpiPktTxEDescWrIrdyPsn11C    = 1'b1;
	    XpiPktTxEDescWrBackEn1Psn10C = 1'b1;
	    XpiPktTxEDescWrBackEn2Psn10C = 1'b0;
	  end
		    
	`XPIPKTTXEGDESCWRSTALL:
	  begin
	    XpiPktTxEDescWrIrdyPsn11C    = 1'b1;
	    XpiPktTxEDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxEDescWrBackEn2Psn10C = 1'b0;
	  end

	`XPIPKTTXEGDESCWRBACK2:
	  begin
	    XpiPktTxEDescWrIrdyPsn11C    = 1'b1;
	    XpiPktTxEDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxEDescWrBackEn2Psn10C = 1'b1;
	  end

	`XPIPKTTXEGFIRSTCHUNK: 
	  begin
	    XpiPktTxEAddrIrdyPsn11C  = 1'b1;
	    XpiPktTxEDataIrdyPsn11C  = 1'b1;
	    XpiPktTxEFifoRdEnPsn10C  = 1'b1;
	  end
	
	`XPIPKTTXEGFIFODATARD: 
	  begin
	    XpiPktTxEAddrIrdyPsn11C    = 1'b0;
	    XpiPktTxEDataIrdyPsn11C    = 1'b1;
	    XpiPktTxEFifoRdEnPsn10C    = 1'b1;
	    XpiPktTxEDataRdStatePsn11C = 1'b1;
	    XpiPktTxEDataStallPsn11C   = 1'b0;
	  end
	
	`XPIPKTTXEGLASTCHUNK:
	  begin
	    XpiPktTxEAddrIrdyPsn11C   = 1'b0;
	    XpiPktTxEDataIrdyPsn11C   = 1'b1;
	    XpiPktTxEFifoRdEnPsn10C   = 1'b1;
	    XpiPktTxELastChunkPsn11C  = 1'b1;
	    XpiPktTxEDataStallPsn11C  = 1'b0;
	  end
       
	`XPIPKTTXEGDATAWAIT1:
	  begin
	    XpiPktTxEDataIrdyPsn11C    = 1'b1;
	    XpiPktTxEFifoRdEnPsn10C    = 1'b0;
	  end

	`XPIPKTTXEGDATAWAIT2:
	  begin
	    XpiPktTxEDataIrdyPsn11C    = 1'b1;
	    XpiPktTxEFifoRdEnPsn10C    = 1'b0;
	  end
	    
	`XPIPKTTXEGDATASTALL: 
	  begin
	    XpiPktTxEAddrIrdyPsn11C    = 1'b0;
	    XpiPktTxEDataIrdyPsn11C    = 1'b1;
	    XpiPktTxEFifoRdEnPsn10C    = 1'b0;
	    XpiPktTxEDataRdStatePsn11C = 1'b0;
	    XpiPktTxELastChunkPsn11C   = 1'b0;
	    XpiPktTxEDataStallPsn11C   = 1'b1;
	  end
	
	`XPIPKTTXEGCHUNKSEND: XpiPktTxEChunkSendPsn11C   = 1'b1;

	`XPIPKTTXEGABORT: XpiPktTxEKillPsn11C = 1'b1;
	
	default:
	  begin
	    XpiPktTxEgressReqPsn11C      = 1'b0;
	    XpiPktTxEPciArbReqPsn12C     = 1'b0;
	    XpiPktTxQ4DescRdPsn10C       = 1'b0;
	    XpiPktTxQ5DescRdPsn10C       = 1'b0;
	    XpiPktTxQ6DescRdPsn10C       = 1'b0;
	    XpiPktTxQ7DescRdPsn10C       = 1'b0;
	    XpiPktTxEDescPh1WrEnPsn10C   = 1'b0;
	    XpiPktTxEDescPh2WrEnPsn10C   = 1'b0;
	    XpiPktTxEDescWrIrdyPsn11C    = 1'b0;
	    XpiPktTxEDescWrBackEn1Psn10C = 1'b0;
	    XpiPktTxEDescWrBackEn2Psn10C = 1'b0;
	    XpiPktTxEAddrIrdyPsn11C      = 1'b0;
	    XpiPktTxEDataIrdyPsn11C      = 1'b0;
	    XpiPktTxEFifoRdEnPsn10C      = 1'b0;
	    XpiPktTxEDataRdStatePsn11C   = 1'b0;
	    XpiPktTxEDataStallPsn11C     = 1'b0;
	    XpiPktTxELastChunkPsn11C     = 1'b0;
	    XpiPktTxEChunkSendPsn11C     = 1'b0;
	    XpiPktTxEKillPsn11C          = 1'b0;
	  end
	
      endcase // case(xpipkttxegstate)
    end // always @ (...
  
  //---- State Transitions ----

  always @(/*AS*/XpiPciAppPktTxDataIrdyP11S or XpiPciAppPktTxTrdyP10S
	   or XpiPciAppPktTxTrdyP11S or XpiPciAppPktTxValidTxnP11S
	   or XpiPciArbPktTxBusyP11S or XpiPciArbPktTxReqAbortP11S
	   or XpiPciArbPktTxSplitAbortP11S or XpiPciArbPktTxSrvP11S
	   or XpiPciArbPktTxStopP11S or XpiPktTxDataCntPsn11S
	   or XpiPktTxEChunkRdPsn11C or XpiPktTxEDataRdStatePsn12S
	   or XpiPktTxEFifoEFPsn11S or XpiPktTxEFinalDataRdPsn11C
	   or XpiPktTxELastChunkPsn12S or XpiPktTxELastChunkRdPsn11C
	   or XpiPktTxEPktCmpltPsn12C or XpiPktTxEReadDescPns11C
	   or XpiPktTxEReadHeadDescPns11C or XpiPktTxEStartOpPns11C
	   or XpiPktTxEgressGoPsn11C or XpiPktTxNumFifoLocPsn11C
	   or XpiPktTxNumFifoLocPsn12S or XpiPktTxQ4CPUOwnerPns11C
	   or XpiPktTxQ4DescASICOwnerPns11C or XpiPktTxQ4DescWrPns11S
	   or XpiPktTxQ4NextDescRdPsn14S or XpiPktTxQ4NoBufAvailPns11S
	   or XpiPktTxQ4RunSetPns11S or XpiPktTxQ5CPUOwnerPns11C
	   or XpiPktTxQ5DescASICOwnerPns11C or XpiPktTxQ5DescWrPns11S
	   or XpiPktTxQ5NextDescRdPsn14S or XpiPktTxQ5NoBufAvailPns11S
	   or XpiPktTxQ5RunSetPns11S or XpiPktTxQ6CPUOwnerPns11C
	   or XpiPktTxQ6DescASICOwnerPns11C or XpiPktTxQ6DescWrPns11S
	   or XpiPktTxQ6NextDescRdPsn14S or XpiPktTxQ6NoBufAvailPns11S
	   or XpiPktTxQ6RunSetPns11S or XpiPktTxQ7CPUOwnerPns11C
	   or XpiPktTxQ7DescASICOwnerPns11C or XpiPktTxQ7DescWrPns11S
	   or XpiPktTxQ7NextDescRdPsn14S or XpiPktTxQ7NoBufAvailPns11S
	   or XpiPktTxQ7RunSetPns11S or XpiPktTxSrvCfgWrPns10C
	   or xpipkttxegstate)
    begin
      
      case(xpipkttxegstate)
	
	`XPIPKTTXEGIDLE: 	           
	  begin
	    // Read the First Descriptor if Run Bit is Set
	    // If Fifo is Non-Empty, Read the Packet Chunk
	    // and Issue PCI Write for CPU Memory,
	    // Packet transmit complete, write back the Descriptor to CPU memory
	    if ((XpiPktTxEReadHeadDescPns11C || 
		 XpiPktTxEReadDescPns11C     || 
		 XpiPktTxEPktCmpltPsn12C     ||
		 ((~XpiPktTxEFifoEFPsn11S)   && XpiPktTxEStartOpPns11C))  &&
		((~XpiPciArbPktTxBusyP11S)   && (~XpiPciArbPktTxStopP11S) &&
		 (~XpiPciArbPktTxSrvP11S)))
	      next_xpipkttxegstate = `XPIPKTTXEGWAIT4GNT;
	    else 
	      next_xpipkttxegstate = `XPIPKTTXEGIDLE;
	  end

	`XPIPKTTXEGWAIT4GNT:
	  begin
	    if (XpiPktTxEgressGoPsn11C)
	      // Egress Traffic given a Green signal to proceed,
	      // arbitrate for PCI Bus
	      next_xpipkttxegstate = `XPIPKTTXEGPCIARBREQ;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGWAIT4GNT;
	  end
	
	`XPIPKTTXEGPCIARBREQ: // Issue Request for Time Slice to the Arbiter
	  begin
	    if (XpiPktTxEPktCmpltPsn12C && XpiPciArbPktTxSrvP11S &&
		(~XpiPciArbPktTxBusyP11S))
	      // Packet transmission complete, transition to Descriptor Write
	      // State, to write back the descriptor to CPU memory
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRBACK1;
	    else if ((XpiPktTxQ4RunSetPns11S || XpiPktTxQ4NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxegstate = `XPIPKTTXQ4DESCRD;
	    else if ((XpiPktTxQ5RunSetPns11S || XpiPktTxQ5NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxegstate = `XPIPKTTXQ5DESCRD;
	    else if ((XpiPktTxQ6RunSetPns11S || XpiPktTxQ6NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S && (~XpiPciArbPktTxBusyP11S)) 
	      next_xpipkttxegstate = `XPIPKTTXQ6DESCRD;
	    else if ((XpiPktTxQ7RunSetPns11S || XpiPktTxQ7NextDescRdPsn14S) && 
		     XpiPciArbPktTxSrvP11S && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxegstate = `XPIPKTTXQ7DESCRD;
	    else if ((~XpiPktTxEFifoEFPsn11S) && XpiPktTxEStartOpPns11C && 
		     XpiPciArbPktTxSrvP11S && (~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxegstate = `XPIPKTTXIGFIRSTCHUNK;	    
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGPCIARBREQ;
	  end
	
	`XPIPKTTXQ4DESCRD: // Ingress Queue 0 Descriptor Read
	  next_xpipkttxegstate = `XPIPKTTXEGDESCRDCMPWAIT;
	
	`XPIPKTTXQ5DESCRD: // Ingress Queue 1 Descriptor Read
	  next_xpipkttxegstate = `XPIPKTTXEGDESCRDCMPWAIT;
	
	`XPIPKTTXQ6DESCRD: // Ingress Queue 2 Descriptor Read
	  next_xpipkttxegstate = `XPIPKTTXEGDESCRDCMPWAIT;
	
	`XPIPKTTXQ7DESCRD: // Ingress Queue 3 Descriptor Read
	  next_xpipkttxegstate = `XPIPKTTXEGDESCRDCMPWAIT;
	
	`XPIPKTTXEGDESCRDCMPWAIT: // Receive Descriptor Read Completion Data
	  begin
	    if (XpiPciAppPktTxDataIrdyP11S && XpiPciAppPktTxValidTxnP11S && 
		(~XpiPktTxSrvCfgWrPns10C))
	      // Descriptor Read completion data received,
	      // transition to Descriptor Write phase
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRPHASE1;
	    else if (XpiPciArbPktTxReqAbortP11S || XpiPciArbPktTxSplitAbortP11S)
	      // Abort Completion received for Read request or
	      // Error occured during split completion
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDESCRDCMPWAIT;
	  end
	
	`XPIPKTTXEGDESCWRPHASE1: next_xpipkttxegstate = `XPIPKTTXEGDESCWRPHASE2;
	
	`XPIPKTTXEGDESCWRPHASE2: 
	  begin
	    if (~(XpiPciAppPktTxDataIrdyP11S && XpiPciAppPktTxValidTxnP11S))
	      next_xpipkttxegstate = `XPIPKTTXEGDESCOWNERCHECK;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRPHASE2;
	  end
	
	`XPIPKTTXEGDESCOWNERCHECK:
	  begin
	    // If CPU Ownership Set, no Buffer Available condition, wait for reprogramming
	    // else ASIC Ownership Set, continue Packet Send operation
	    if (XpiPktTxQ4CPUOwnerPns11C || XpiPktTxQ5CPUOwnerPns11C ||
		XpiPktTxQ6CPUOwnerPns11C || XpiPktTxQ7CPUOwnerPns11C)
	      next_xpipkttxegstate = `XPIPKTTXEGNOBUFAVAIL;
	    else if ((XpiPktTxQ4DescWrPns11S &&
		      XpiPktTxQ4DescASICOwnerPns11C) ||
		     (XpiPktTxQ5DescWrPns11S &&
		      XpiPktTxQ5DescASICOwnerPns11C) ||
		     (XpiPktTxQ6DescWrPns11S &&
		      XpiPktTxQ6DescASICOwnerPns11C) ||
		     (XpiPktTxQ7DescWrPns11S &&
		      XpiPktTxQ7DescASICOwnerPns11C))
	      // ASIC Ownership set, tranisition to Idle
	      next_xpipkttxegstate = `XPIPKTTXEGIDLE;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDESCOWNERCHECK;
	  end	  
	
	`XPIPKTTXEGNOBUFAVAIL:
	  begin
	    if ((XpiPktTxQ4NoBufAvailPns11S && XpiPktTxQ4RunSetPns11S) ||
		(XpiPktTxQ5NoBufAvailPns11S && XpiPktTxQ5RunSetPns11S) ||
		(XpiPktTxQ6NoBufAvailPns11S && XpiPktTxQ6RunSetPns11S) ||
		(XpiPktTxQ7NoBufAvailPns11S && XpiPktTxQ7RunSetPns11S) &&
		(~XpiPciArbPktTxBusyP11S))
	      next_xpipkttxegstate = `XPIPKTTXEGWAIT4GNT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGNOBUFAVAIL;
	  end
	
	`XPIPKTTXEGDESCWRBACK1:
	  begin
	    if (~XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRSTALL;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRBACK2;
	  end
	
	`XPIPKTTXEGDESCWRSTALL:
	  begin
	    if (XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRBACK2;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDESCWRSTALL;
	  end
	
	`XPIPKTTXEGDESCWRBACK2: 
	  begin
	    if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGIDLE;
	  end
	
	`XPIPKTTXEGFIRSTCHUNK:
	  begin
	    if (XpiPktTxEChunkRdPsn11C && XpiPciAppPktTxTrdyP11S)
	      // All Chunks except Last Chunk
	      next_xpipkttxegstate = `XPIPKTTXEGFIFODATARD;
	    else if (XpiPktTxEFinalDataRdPsn11C && XpiPciAppPktTxTrdyP11S)
	      // Last 64B Chunk, but <8B Data Valid 
	      next_xpipkttxegstate = `XPIPKTTXEGCHUNKSEND;
	    else if (XpiPktTxELastChunkRdPsn11C && XpiPciAppPktTxTrdyP11S)
	      // Last 64B Chunk, but >8B Data Valid 
	      next_xpipkttxegstate = `XPIPKTTXEGLASTCHUNK;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGFIRSTCHUNK;
	  end
	
	`XPIPKTTXEGFIFODATARD:
	  begin
	    if ((~XpiPciAppPktTxTrdyP10S) && (~(XpiPktTxDataCntPsn11S == 4'h7)))
	      // Backpressue asserted, Data Xfr incomplete
	      next_xpipkttxegstate = `XPIPKTTXEGDATASTALL;
	    else if ((~XpiPktTxEFifoEFPsn11S) && (XpiPktTxDataCntPsn11S == 4'h7))
	      // 64B Chunk Transfer complete
	      next_xpipkttxegstate = `XPIPKTTXEGCHUNKSEND;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGFIFODATARD;
	  end
	
	`XPIPKTTXEGLASTCHUNK:
	  begin
	    if ( (~XpiPciAppPktTxTrdyP10S) && (~XpiPktTxEFifoEFPsn11S) )
	      // Back pressure occuring before completion of Data Xfr
	      next_xpipkttxegstate = `XPIPKTTXEGDATASTALL;
	    else if (XpiPktTxNumFifoLocPsn11C)
	      // Mapping EOP offset to Number of Fifo Entries to read,
	      // once all required Data is read, transition to Chunk Send state
	      // Note: Backpressure could occur during the final data phase
	      // transfer wherein data is read out of the Fifo but not issued
	      // onto PCI bus, transition to WAIT state and then to
	      // CHUNKSEND once no backpressure exists
	      next_xpipkttxegstate = `XPIPKTTXEGDATAWAIT1;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGLASTCHUNK;
	  end

	`XPIPKTTXEGDATAWAIT1:
	  begin
	    if (XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxegstate = `XPIPKTTXEGDATAWAIT2;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDATAWAIT1;
	  end

	`XPIPKTTXEGDATAWAIT2:
	  begin
	    if (XpiPciAppPktTxTrdyP10S)
	      next_xpipkttxegstate = `XPIPKTTXEGCHUNKSEND;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDATAWAIT2;
	  end
	
	`XPIPKTTXEGDATASTALL:
	  begin
	    if (XpiPktTxEDataRdStatePsn12S && (XpiPktTxDataCntPsn11S==4'h7) &&
		XpiPciAppPktTxTrdyP10S && (~XpiPciArbPktTxStopP11S))
	      // Stall occured during the Last 8B Data Transfer of a Full 64B chunk
	      // Once stall is cleared tranition to Chunk Send state
	      next_xpipkttxegstate = `XPIPKTTXEGCHUNKSEND;
	    else if (XpiPktTxEDataRdStatePsn12S && XpiPciAppPktTxTrdyP10S && 
		     (~XpiPciArbPktTxStopP11S))
	      // Stall in the middle of Data Transfer is cleared
	      next_xpipkttxegstate = `XPIPKTTXEGFIFODATARD;
	    else if (XpiPktTxELastChunkPsn12S && XpiPciAppPktTxTrdyP10S &&
		     (XpiPktTxNumFifoLocPsn12S || XpiPktTxEFifoEFPsn11S) &&
		     (~XpiPciArbPktTxStopP11S))
	      // Last Chunk Transfer and Stall occuring during Last 8B Data Xfr
	      //next_xpipkttxegstate = `XPIPKTTXEGCHUNKSEND;
	      next_xpipkttxegstate = `XPIPKTTXEGDATAWAIT1;
	    else if (XpiPktTxELastChunkPsn12S && XpiPciAppPktTxTrdyP10S && 
		     (~XpiPktTxEFifoEFPsn11S) && (~XpiPciArbPktTxStopP11S) )
	      // Last Chunk Transfer and Stall occuring before the Last 8B Data Xfr
	      next_xpipkttxegstate = `XPIPKTTXEGLASTCHUNK;
	    else if (XpiPciArbPktTxReqAbortP11S)
	      // Abort Completion received for Write request
	      next_xpipkttxegstate = `XPIPKTTXEGABORT;
	    else
	      next_xpipkttxegstate = `XPIPKTTXEGDATASTALL;
	  end
	
	`XPIPKTTXEGCHUNKSEND: next_xpipkttxegstate = `XPIPKTTXEGIDLE;

	`XPIPKTTXEGABORT: next_xpipkttxegstate = `XPIPKTTXEGIDLE;
	
	default: next_xpipkttxegstate = `XPIPKTTXEGIDLE;

      endcase // case(xpipkttxegstate)
    end // always @ (...
  

  //------------------------------------------
  //---- Ingress & Egress Traffic Arbiter ----
  //------------------------------------------
  // Fairly arbitrates between Ingress & Egress Traffic.

  assign XpiPktTxIngressDonePns11C = (XpiPktTxIDescPh2WrEnPsn10C || 
				      XpiPktTxIChunkSendPsn11C   ||
				      XpiPktTxIDescWrBackEn2Psn10C);

DFFR #(1,1'b0) U108_dff (.q(XpiPktTxIngressDonePns11S),.d(XpiPktTxIngressDonePns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxEgressDonePns11C = (XpiPktTxEDescPh2WrEnPsn10C || 
				     XpiPktTxEChunkSendPsn11C   ||
				     XpiPktTxEDescWrBackEn2Psn10C);

DFFR #(1,1'b0) U109_dff (.q(XpiPktTxEgressDonePns11S),.d(XpiPktTxEgressDonePns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
				    
  //---- State Definitions ----

`define XPIPKTTXARBIDLE     2'b00
`define XPIPKTTXGNTINGRESS  2'b01
`define XPIPKTTXGNTEGRESS   2'b10
  
  // State Variables
  wire [1:0] xpipkttxarbstate;
  reg [1:0]  next_xpipkttxarbstate;
  
  // State Change
DFFR #(2,2'b0) U110_dff (.q(xpipkttxarbstate),.d(next_xpipkttxarbstate),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //---- Output Assignments ----

  always @(/*AS*/xpipkttxarbstate)
    begin
      
      XpiPktTxIngressGoPsn11C = 1'b0;
      XpiPktTxEgressGoPsn11C  = 1'b0;
      
      case(xpipkttxarbstate)

	`XPIPKTTXARBIDLE:
	  begin
	    XpiPktTxIngressGoPsn11C = 1'b0;
	    XpiPktTxEgressGoPsn11C  = 1'b0;
	  end

	`XPIPKTTXGNTINGRESS: XpiPktTxIngressGoPsn11C = 1'b1;

	`XPIPKTTXGNTEGRESS:  XpiPktTxEgressGoPsn11C = 1'b1;

	default:
	  begin
	    XpiPktTxIngressGoPsn11C = 1'b0;
	    XpiPktTxEgressGoPsn11C  = 1'b0;
	  end
	
      endcase // case(xpipkttxarbstate)
    end // always @ (...
  	
  //---- State Transitions ----

  always @(/*AS*/XpiPktTxEgressDonePns11S or XpiPktTxEgressReqPsn11C
	   or XpiPktTxIngressDonePns11S or XpiPktTxIngressReqPsn11C
	   or xpipkttxarbstate)
    begin

      case(xpipkttxarbstate)

	`XPIPKTTXARBIDLE:
	  begin
	    if (XpiPktTxIngressReqPsn11C)
	      next_xpipkttxarbstate = `XPIPKTTXGNTINGRESS;
	    else if (XpiPktTxEgressReqPsn11C)
	      next_xpipkttxarbstate = `XPIPKTTXGNTEGRESS;
	    else
	      next_xpipkttxarbstate = `XPIPKTTXARBIDLE;
	  end

	`XPIPKTTXGNTINGRESS:
	  begin
	    if (XpiPktTxIngressDonePns11S && XpiPktTxEgressReqPsn11C)
	      next_xpipkttxarbstate = `XPIPKTTXGNTEGRESS;
	    else if (XpiPktTxIngressDonePns11S && (~XpiPktTxEgressReqPsn11C))
	      next_xpipkttxarbstate = `XPIPKTTXARBIDLE;
	    else 
	      next_xpipkttxarbstate = `XPIPKTTXGNTINGRESS;
	  end

	`XPIPKTTXGNTEGRESS:
	  begin
	    if (XpiPktTxEgressDonePns11S && XpiPktTxIngressReqPsn11C)
	      next_xpipkttxarbstate = `XPIPKTTXGNTINGRESS;
	    else if (XpiPktTxEgressDonePns11S && (~XpiPktTxIngressReqPsn11C))
	      next_xpipkttxarbstate = `XPIPKTTXARBIDLE;
	    else
	      next_xpipkttxarbstate = `XPIPKTTXGNTEGRESS;
	  end

	default: next_xpipkttxarbstate = `XPIPKTTXARBIDLE;
	
      endcase // case(xpipkttxarbstate)
    end // always @ (...
    

  //-----------------------------------------------
  //---- Combining Ingress & Egress Qualifiers ----
  //-----------------------------------------------
  
  assign XpiPktTxPciArbReqPsn13S   = (XpiPktTxIPciArbReqPsn12C || XpiPktTxEPciArbReqPsn12C);
  
  assign XpiPktTxDescPh1WrEnPsn10C = (XpiPktTxIDescPh1WrEnPsn10C || XpiPktTxEDescPh1WrEnPsn10C);
  
  assign XpiPktTxDescWrBackEn1Psn10C = (XpiPktTxIDescWrBackEn1Psn10C ||
					XpiPktTxEDescWrBackEn1Psn10C);
  
  assign XpiPktTxDescPh2WrEnPsn10C = (XpiPktTxIDescPh2WrEnPsn10C || XpiPktTxEDescPh2WrEnPsn10C);
  
  assign XpiPktTxDescWrBackEn2Psn10C = (XpiPktTxIDescWrBackEn2Psn10C ||
					XpiPktTxEDescWrBackEn2Psn10C);
  
  assign XpiPktTxAddrIrdyPsn11C    = (XpiPktTxIAddrIrdyPsn11C || XpiPktTxEAddrIrdyPsn11C);
  
  assign XpiPktTxDataIrdyPsn11C    = (XpiPktTxIDataIrdyPsn11C || XpiPktTxEDataIrdyPsn11C);
  
  assign XpiPktTxDescWrIrdyPsn11C  = (XpiPktTxIDescWrIrdyPsn11C || XpiPktTxEDescWrIrdyPsn11C);
 
  //-----------------------
  //---- Data Counters ----
  //-----------------------
  // Counts total number of Fifo Entries, since Ingress and Egress Fifo Pop 
  // occurs at different time slice, single counter counts number of 8B data
  // chunks for ingress or egress traffic
  
  always @(/*AS*/XpiPktTxDataCntPsn11S or XpiPktTxEChunkSendPsn11C
	   or XpiPktTxEFifoRdEnPsn11C or XpiPktTxIChunkSendPsn11C
	   or XpiPktTxIFifoRdEnPsn11C)
    begin
      if (XpiPktTxIFifoRdEnPsn11C || XpiPktTxEFifoRdEnPsn11C)  
	XpiPktTxDataCntPsn11C = {XpiPktTxDataCntPsn11S + 4'h1};
      else if (XpiPktTxIChunkSendPsn11C || XpiPktTxEChunkSendPsn11C)
	XpiPktTxDataCntPsn11C = {4{1'b0}};
      else if (XpiPktTxDataCntPsn11S == 4'hf)
	XpiPktTxDataCntPsn11C = {4{1'b0}};
      else
	XpiPktTxDataCntPsn11C = XpiPktTxDataCntPsn11S;
    end // always @ (...
  
DFFR #(4,4'b0) U111_dff (.q(XpiPktTxDataCntPsn11S),.d(XpiPktTxDataCntPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //----------------------------------------------------
  //---- Descriptor Read Indication per Queue Basis ----
  //----------------------------------------------------
  // ReCirculating Descriptor Read Enable until 
  // Descriptor Read completion is received and contents
  // are written to proper Queue Descriptors

  // Ingress Queue 0
  assign XpiPktTxQ0DescRdPsn11C = 
	 (XpiPktTxQ0DescRdPsn10C || XpiPktTxQ0DescWrPns11C) ?
	   XpiPktTxQ0DescRdPsn10C : XpiPktTxQ0DescRdPsn11S;
  
DFFR #(1,1'b0) U112_dff (.q(XpiPktTxQ0DescRdPsn11S),.d(XpiPktTxQ0DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 1
  assign XpiPktTxQ1DescRdPsn11C = 
	 (XpiPktTxQ1DescRdPsn10C || XpiPktTxQ1DescWrPns11C) ?
	   XpiPktTxQ1DescRdPsn10C : XpiPktTxQ1DescRdPsn11S;
  
DFFR #(1,1'b0) U113_dff (.q(XpiPktTxQ1DescRdPsn11S),.d(XpiPktTxQ1DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 2
  assign XpiPktTxQ2DescRdPsn11C = 
	 (XpiPktTxQ2DescRdPsn10C || XpiPktTxQ2DescWrPns11C) ?
	   XpiPktTxQ2DescRdPsn10C : XpiPktTxQ2DescRdPsn11S;
  
DFFR #(1,1'b0) U114_dff (.q(XpiPktTxQ2DescRdPsn11S),.d(XpiPktTxQ2DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 3
  assign XpiPktTxQ3DescRdPsn11C = 
	 (XpiPktTxQ3DescRdPsn10C || XpiPktTxQ3DescWrPns11C) ?
	   XpiPktTxQ3DescRdPsn10C : XpiPktTxQ3DescRdPsn11S;
  
DFFR #(1,1'b0) U115_dff (.q(XpiPktTxQ3DescRdPsn11S),.d(XpiPktTxQ3DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0
  assign XpiPktTxQ4DescRdPsn11C = 
	 (XpiPktTxQ4DescRdPsn10C || XpiPktTxQ4DescWrPns11C) ?
	   XpiPktTxQ4DescRdPsn10C : XpiPktTxQ4DescRdPsn11S;
  
DFFR #(1,1'b0) U116_dff (.q(XpiPktTxQ4DescRdPsn11S),.d(XpiPktTxQ4DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 1
  assign XpiPktTxQ5DescRdPsn11C = 
	 (XpiPktTxQ5DescRdPsn10C || XpiPktTxQ5DescWrPns11C) ?
	   XpiPktTxQ5DescRdPsn10C : XpiPktTxQ5DescRdPsn11S;
  
DFFR #(1,1'b0) U117_dff (.q(XpiPktTxQ5DescRdPsn11S),.d(XpiPktTxQ5DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 2
  assign XpiPktTxQ6DescRdPsn11C = 
	 (XpiPktTxQ6DescRdPsn10C || XpiPktTxQ6DescWrPns11C) ?
	   XpiPktTxQ6DescRdPsn10C : XpiPktTxQ6DescRdPsn11S;
  
DFFR #(1,1'b0) U118_dff (.q(XpiPktTxQ6DescRdPsn11S),.d(XpiPktTxQ6DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 3
  assign XpiPktTxQ7DescRdPsn11C = 
	 (XpiPktTxQ7DescRdPsn10C || XpiPktTxQ7DescWrPns11C) ?
	   XpiPktTxQ7DescRdPsn10C : XpiPktTxQ7DescRdPsn11S;
  
DFFR #(1,1'b0) U119_dff (.q(XpiPktTxQ7DescRdPsn11S),.d(XpiPktTxQ7DescRdPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  //-------------------------------------------
  //---- Two Phase Buffer Descriptor Write ----
  //-------------------------------------------
  
  // Enable indicating Descriptor Update
DFFR #(1,1'b0) U120_dff (.q(XpiPktTxDescUpdatePsn11S),.d(XpiPktTxDescPh2WrEnPsn10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxDescPtrRegLSBPns10C = XpiPktTxDescPh1WrEnPsn10C?
	 XpiPktTxDataPns10S : XpiPktTxDescPtrRegLSBPns10S;
  
  assign XpiPktTxDescPtrRegMSBPns10C = XpiPktTxDescPh2WrEnPsn10C ?
	 XpiPktTxDataPns10S : XpiPktTxDescPtrRegMSBPns10S;
  
DFFR #(64,64'b0) U121_dff (.q(XpiPktTxDescPtrRegLSBPns10S),.d(XpiPktTxDescPtrRegLSBPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(64,64'b0) U122_dff (.q(XpiPktTxDescPtrRegMSBPns10S),.d(XpiPktTxDescPtrRegMSBPns10C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxDescPtrRegPns10C = {XpiPktTxDescPtrRegMSBPns10S,
                                     XpiPktTxDescPtrRegLSBPns10S};

  
  //---------------------------------------------------------------------------------
  //---- Descriptor Update Enable after Descriptor Read or Packet Chunk Transfer ----
  //---------------------------------------------------------------------------------

  // New Descriptor Read Data Indication

  // Ingress
  assign XpiPktTxQ0DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ0DescRdPsn11S);
  
DFFR #(1,1'b0) U123_dff (.q(XpiPktTxQ0DescWrPns11S),.d(XpiPktTxQ0DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ1DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ1DescRdPsn11S);
  
DFFR #(1,1'b0) U124_dff (.q(XpiPktTxQ1DescWrPns11S),.d(XpiPktTxQ1DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ2DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ2DescRdPsn11S);
  
DFFR #(1,1'b0) U125_dff (.q(XpiPktTxQ2DescWrPns11S),.d(XpiPktTxQ2DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ3DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ3DescRdPsn11S);
  
DFFR #(1,1'b0) U126_dff (.q(XpiPktTxQ3DescWrPns11S),.d(XpiPktTxQ3DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress
  
  assign XpiPktTxQ4DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ4DescRdPsn11S);
  
DFFR #(1,1'b0) U127_dff (.q(XpiPktTxQ4DescWrPns11S),.d(XpiPktTxQ4DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ5DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ5DescRdPsn11S);
  
DFFR #(1,1'b0) U128_dff (.q(XpiPktTxQ5DescWrPns11S),.d(XpiPktTxQ5DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ6DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ6DescRdPsn11S);
  
DFFR #(1,1'b0) U129_dff (.q(XpiPktTxQ6DescWrPns11S),.d(XpiPktTxQ6DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  assign XpiPktTxQ7DescWrPns11C = (XpiPktTxDescUpdatePsn11S && 
				   XpiPktTxQ7DescRdPsn11S);
  
DFFR #(1,1'b0) U130_dff (.q(XpiPktTxQ7DescWrPns11S),.d(XpiPktTxQ7DescWrPns11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Enable indicating completion of Chunk Transfer
  
  assign XpiPktTxQ0UpdateStatusPsn11C = (XpiPktTxQ0ActivePsn12S    && 
					 XpiPktTxIDataRdStatePsn12S && 
					 XpiPktTxIChunkSendPsn11C);
  
  assign XpiPktTxQ1UpdateStatusPsn11C = (XpiPktTxQ1ActivePsn12S    && 
					 XpiPktTxIDataRdStatePsn12S && 
					 XpiPktTxIChunkSendPsn11C);
  
  assign XpiPktTxQ2UpdateStatusPsn11C = (XpiPktTxQ2ActivePsn12S    && 
					 XpiPktTxIDataRdStatePsn12S && 
					 XpiPktTxIChunkSendPsn11C);
  
  assign XpiPktTxQ3UpdateStatusPsn11C = (XpiPktTxQ3ActivePsn12S    && 
					 XpiPktTxIDataRdStatePsn12S && 
					 XpiPktTxIChunkSendPsn11C);

  assign XpiPktTxQ4UpdateStatusPsn11C = (XpiPktTxQ4ActivePsn12S    && 
					 XpiPktTxEDataRdStatePsn12S && 
					 XpiPktTxEChunkSendPsn11C);
  
  assign XpiPktTxQ5UpdateStatusPsn11C = (XpiPktTxQ5ActivePsn12S    && 
					 XpiPktTxEDataRdStatePsn12S && 
					 XpiPktTxEChunkSendPsn11C);
  
  assign XpiPktTxQ6UpdateStatusPsn11C = (XpiPktTxQ6ActivePsn12S    && 
					 XpiPktTxEDataRdStatePsn12S && 
					 XpiPktTxEChunkSendPsn11C);
  
  assign XpiPktTxQ7UpdateStatusPsn11C = (XpiPktTxQ7ActivePsn12S    && 
					 XpiPktTxEDataRdStatePsn12S && 
					 XpiPktTxEChunkSendPsn11C);
  
  // Enable indicating Final Chunk Transfer
  
  assign XpiPktTxQ0FinalUpdatePsn11C = 
	 (XpiPktTxQ0ActivePsn12S && XpiPktTxIChunkSendPsn11C &&
	  (XpiPktTxILastChunkPsn12S || XpiPktTxIFinalDataRdPsn11S));

  assign XpiPktTxQ1FinalUpdatePsn11C = 
	 (XpiPktTxQ1ActivePsn12S && XpiPktTxIChunkSendPsn11C &&
	  (XpiPktTxILastChunkPsn12S || XpiPktTxIFinalDataRdPsn11S));
  
  assign XpiPktTxQ2FinalUpdatePsn11C = 
	 (XpiPktTxQ2ActivePsn12S && XpiPktTxIChunkSendPsn11C &&
	  (XpiPktTxILastChunkPsn12S || XpiPktTxIFinalDataRdPsn11S));

  assign XpiPktTxQ3FinalUpdatePsn11C = 
	 (XpiPktTxQ3ActivePsn12S && XpiPktTxIChunkSendPsn11C &&
	  (XpiPktTxILastChunkPsn12S || XpiPktTxIFinalDataRdPsn11S));

  assign XpiPktTxQ4FinalUpdatePsn11C = 
	 (XpiPktTxQ4ActivePsn12S  && XpiPktTxEChunkSendPsn11C &&
	  (XpiPktTxELastChunkPsn12S || XpiPktTxEFinalDataRdPsn11S));

  assign XpiPktTxQ5FinalUpdatePsn11C = 
	 (XpiPktTxQ5ActivePsn12S  && XpiPktTxEChunkSendPsn11C &&
	  (XpiPktTxELastChunkPsn12S || XpiPktTxEFinalDataRdPsn11S));

  assign XpiPktTxQ6FinalUpdatePsn11C = 
	 (XpiPktTxQ6ActivePsn12S  && XpiPktTxEChunkSendPsn11C &&
	  (XpiPktTxELastChunkPsn12S || XpiPktTxEFinalDataRdPsn11S));

  assign XpiPktTxQ7FinalUpdatePsn11C = 
	 (XpiPktTxQ7ActivePsn12S  && XpiPktTxEChunkSendPsn11C &&
	  (XpiPktTxELastChunkPsn12S || XpiPktTxEFinalDataRdPsn11S));
    
  // Delaying the Chunk Transfer indication to align with descriptor update
DFFR #(1,1'b0) U131_dff (.q(XpiPktTxQ0UpdateStatusPsn11S),.d(XpiPktTxQ0UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U132_dff (.q(XpiPktTxQ1UpdateStatusPsn11S),.d(XpiPktTxQ1UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U133_dff (.q(XpiPktTxQ2UpdateStatusPsn11S),.d(XpiPktTxQ2UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U134_dff (.q(XpiPktTxQ3UpdateStatusPsn11S),.d(XpiPktTxQ3UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U135_dff (.q(XpiPktTxQ4UpdateStatusPsn11S),.d(XpiPktTxQ4UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U136_dff (.q(XpiPktTxQ5UpdateStatusPsn11S),.d(XpiPktTxQ5UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U137_dff (.q(XpiPktTxQ6UpdateStatusPsn11S),.d(XpiPktTxQ6UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U138_dff (.q(XpiPktTxQ7UpdateStatusPsn11S),.d(XpiPktTxQ7UpdateStatusPsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Delaying Final Chunk Transfer indication to align with descriptor update
DFFR #(1,1'b0) U139_dff (.q(XpiPktTxQ0FinalUpdatePsn11S),.d(XpiPktTxQ0FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U140_dff (.q(XpiPktTxQ1FinalUpdatePsn11S),.d(XpiPktTxQ1FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U141_dff (.q(XpiPktTxQ2FinalUpdatePsn11S),.d(XpiPktTxQ2FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U142_dff (.q(XpiPktTxQ3FinalUpdatePsn11S),.d(XpiPktTxQ3FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U143_dff (.q(XpiPktTxQ4FinalUpdatePsn11S),.d(XpiPktTxQ4FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U144_dff (.q(XpiPktTxQ5FinalUpdatePsn11S),.d(XpiPktTxQ5FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U145_dff (.q(XpiPktTxQ6FinalUpdatePsn11S),.d(XpiPktTxQ6FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U146_dff (.q(XpiPktTxQ7FinalUpdatePsn11S),.d(XpiPktTxQ7FinalUpdatePsn11C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //-----------------------------------------------------------
  //---- Packet Completion & CPU Buffer Full Determination ----
  //-----------------------------------------------------------

  // Determining Completion of Packet from any one of the eight Queues
  // This indication is used to Write Back the Descriptor corresponding
  // to the particular queue into CPU memory
  
  // Ingress Queue 0
  // Packet Complete
  assign XpiPktTxQ0PktCmpltPsn12C = 
	 (XpiPktTxQ0FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ0FinalUpdatePsn11S : XpiPktTxQ0PktCmpltPsn12S;
  
DFFR #(1,1'b0) U147_dff (.q(XpiPktTxQ0PktCmpltPsn12S),.d(XpiPktTxQ0PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ0BufFullPsn11C =  
	 {XpiPktTxQ0UsedBufLenPsn11S > {XpiPktTxQ0AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ0DescWrBackPsn12C = 
	 (XpiPktTxQ0BufFullPsn11C || XpiPktTxQ0PktCmpltPsn12S);
  
  // Ingress Queue 1
  assign XpiPktTxQ1PktCmpltPsn12C = 
	 (XpiPktTxQ1FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ1FinalUpdatePsn11S : XpiPktTxQ1PktCmpltPsn12S;
  
DFFR #(1,1'b0) U148_dff (.q(XpiPktTxQ1PktCmpltPsn12S),.d(XpiPktTxQ1PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ1BufFullPsn11C =  
	 {XpiPktTxQ1UsedBufLenPsn11S > {XpiPktTxQ1AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ1DescWrBackPsn12C = 
	 (XpiPktTxQ1BufFullPsn11C || XpiPktTxQ1PktCmpltPsn12S);

  // Ingress Queue 2
  assign XpiPktTxQ2PktCmpltPsn12C = 
	 (XpiPktTxQ2FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ2FinalUpdatePsn11S : XpiPktTxQ2PktCmpltPsn12S;
  
DFFR #(1,1'b0) U149_dff (.q(XpiPktTxQ2PktCmpltPsn12S),.d(XpiPktTxQ2PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ2BufFullPsn11C =  
	 {XpiPktTxQ2UsedBufLenPsn11S > {XpiPktTxQ2AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ2DescWrBackPsn12C = 
	 (XpiPktTxQ2BufFullPsn11C || XpiPktTxQ2PktCmpltPsn12S);

  // Ingress Queue 3
  assign XpiPktTxQ3PktCmpltPsn12C = 
	 (XpiPktTxQ3FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ3FinalUpdatePsn11S : XpiPktTxQ3PktCmpltPsn12S;
  
DFFR #(1,1'b0) U150_dff (.q(XpiPktTxQ3PktCmpltPsn12S),.d(XpiPktTxQ3PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ3BufFullPsn11C =  
	 {XpiPktTxQ3UsedBufLenPsn11S > {XpiPktTxQ3AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ3DescWrBackPsn12C = 
	 (XpiPktTxQ3BufFullPsn11C || XpiPktTxQ3PktCmpltPsn12S);

  // Egress Queue 0
  assign XpiPktTxQ4PktCmpltPsn12C = 
	 (XpiPktTxQ4FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ4FinalUpdatePsn11S : XpiPktTxQ4PktCmpltPsn12S;
  
DFFR #(1,1'b0) U151_dff (.q(XpiPktTxQ4PktCmpltPsn12S),.d(XpiPktTxQ4PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ4BufFullPsn11C =  
	 {XpiPktTxQ4UsedBufLenPsn11S > {XpiPktTxQ4AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ4DescWrBackPsn12C = 
	 (XpiPktTxQ4BufFullPsn11C || XpiPktTxQ4PktCmpltPsn12S);

  // Egress Queue 1
  assign XpiPktTxQ5PktCmpltPsn12C = 
	 (XpiPktTxQ5FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ5FinalUpdatePsn11S : XpiPktTxQ5PktCmpltPsn12S;
  
DFFR #(1,1'b0) U152_dff (.q(XpiPktTxQ5PktCmpltPsn12S),.d(XpiPktTxQ5PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ5BufFullPsn11C =  
	 {XpiPktTxQ5UsedBufLenPsn11S > {XpiPktTxQ5AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ5DescWrBackPsn12C = 
	 (XpiPktTxQ5BufFullPsn11C || XpiPktTxQ5PktCmpltPsn12S);

  // Egress Queue 2
  assign XpiPktTxQ6PktCmpltPsn12C = 
	 (XpiPktTxQ6FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ6FinalUpdatePsn11S : XpiPktTxQ6PktCmpltPsn12S;
  
DFFR #(1,1'b0) U153_dff (.q(XpiPktTxQ6PktCmpltPsn12S),.d(XpiPktTxQ6PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ6BufFullPsn11C =  
	 {XpiPktTxQ6UsedBufLenPsn11S > {XpiPktTxQ6AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ6DescWrBackPsn12C = 
	 (XpiPktTxQ6BufFullPsn11C || XpiPktTxQ6PktCmpltPsn12S);

  // Egress Queue 3
  assign XpiPktTxQ7PktCmpltPsn12C = 
	 (XpiPktTxQ7FinalUpdatePsn11S || XpiPktTxDescWrBackEn2Psn10C) ?
	   XpiPktTxQ7FinalUpdatePsn11S : XpiPktTxQ7PktCmpltPsn12S;
  
DFFR #(1,1'b0) U154_dff (.q(XpiPktTxQ7PktCmpltPsn12S),.d(XpiPktTxQ7PktCmpltPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Determining CPU Buffer Full Condition
  assign XpiPktTxQ7BufFullPsn11C =  
	 {XpiPktTxQ7UsedBufLenPsn11S > {XpiPktTxQ7AvailBufLenPns11C - `AVAIL_BUFFER_LENGTH'h0040}};
  
  assign XpiPktTxQ7DescWrBackPsn12C = 
	 (XpiPktTxQ7BufFullPsn11C || XpiPktTxQ7PktCmpltPsn12S);

  //---- A Packet Completion Indicator ----
  
  assign XpiPktTxIPktCmpltPsn12C =
	 (XpiPktTxQ0DescWrBackPsn12C || XpiPktTxQ1DescWrBackPsn12C ||
	  XpiPktTxQ2DescWrBackPsn12C || XpiPktTxQ3DescWrBackPsn12C);

  assign XpiPktTxEPktCmpltPsn12C =
	 (XpiPktTxQ4DescWrBackPsn12C || XpiPktTxQ5DescWrBackPsn12C ||
	  XpiPktTxQ6DescWrBackPsn12C || XpiPktTxQ7DescWrBackPsn12C);
	 
  assign XpiPktTxPktCmpltPsn12C = (XpiPktTxIPktCmpltPsn12C || XpiPktTxEPktCmpltPsn12C);

  //-----------------------------------------
  //---- Next Descriptor Read Indication ----
  //-----------------------------------------
  // After a Packet Transfer is Complete and existing descriptor
  // is written back to CPU memory, go read the Next Descriptor
  
  // Ingress Queue 0
  assign XpiPktTxQ0NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ0DescWrBackPsn12C);
  
  assign XpiPktTxQ0NextDescRdPsn12C =
	 (XpiPktTxQ0NextDescRdPsn11C || 
	  (XpiPktTxIDescPh2WrEnPsn10C && XpiPktTxQ0DescRdPsn11S)) ?
	   XpiPktTxQ0NextDescRdPsn11C : XpiPktTxQ0NextDescRdPsn12S;
  
DFFR #(1,1'b0) U155_dff (.q(XpiPktTxQ0NextDescRdPsn12S),.d(XpiPktTxQ0NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 1
  assign XpiPktTxQ1NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ1DescWrBackPsn12C);
  
  assign XpiPktTxQ1NextDescRdPsn12C =
	 (XpiPktTxQ1NextDescRdPsn11C || 
	  (XpiPktTxIDescPh2WrEnPsn10C && XpiPktTxQ1DescRdPsn11S)) ?
	   XpiPktTxQ1NextDescRdPsn11C : XpiPktTxQ1NextDescRdPsn12S;
  
DFFR #(1,1'b0) U156_dff (.q(XpiPktTxQ1NextDescRdPsn12S),.d(XpiPktTxQ1NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 2
  assign XpiPktTxQ2NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ2DescWrBackPsn12C);
  
  assign XpiPktTxQ2NextDescRdPsn12C =
	 (XpiPktTxQ2NextDescRdPsn11C || 
	  (XpiPktTxIDescPh2WrEnPsn10C && XpiPktTxQ2DescRdPsn11S)) ?
	   XpiPktTxQ2NextDescRdPsn11C : XpiPktTxQ2NextDescRdPsn12S;
  
DFFR #(1,1'b0) U157_dff (.q(XpiPktTxQ2NextDescRdPsn12S),.d(XpiPktTxQ2NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Ingress Queue 3
  assign XpiPktTxQ3NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ3DescWrBackPsn12C);
  
  assign XpiPktTxQ3NextDescRdPsn12C =
	 (XpiPktTxQ3NextDescRdPsn11C || 
	  (XpiPktTxIDescPh2WrEnPsn10C && XpiPktTxQ3DescRdPsn11S)) ?
	   XpiPktTxQ3NextDescRdPsn11C : XpiPktTxQ3NextDescRdPsn12S;
  
DFFR #(1,1'b0) U158_dff (.q(XpiPktTxQ3NextDescRdPsn12S),.d(XpiPktTxQ3NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  // Egress Queue 0
  assign XpiPktTxQ4NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ4DescWrBackPsn12C);
  
  assign XpiPktTxQ4NextDescRdPsn12C =
	 (XpiPktTxQ4NextDescRdPsn11C || 
	  (XpiPktTxEDescPh2WrEnPsn10C && XpiPktTxQ4DescRdPsn11S)) ?
	   XpiPktTxQ4NextDescRdPsn11C : XpiPktTxQ4NextDescRdPsn12S;
  
DFFR #(1,1'b0) U159_dff (.q(XpiPktTxQ4NextDescRdPsn12S),.d(XpiPktTxQ4NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Egress Queue 1
  assign XpiPktTxQ5NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ5DescWrBackPsn12C);
  
  assign XpiPktTxQ5NextDescRdPsn12C =
	 (XpiPktTxQ5NextDescRdPsn11C || 
	  (XpiPktTxEDescPh2WrEnPsn10C && XpiPktTxQ5DescRdPsn11S)) ?
	   XpiPktTxQ5NextDescRdPsn11C : XpiPktTxQ5NextDescRdPsn12S;
  
DFFR #(1,1'b0) U160_dff (.q(XpiPktTxQ5NextDescRdPsn12S),.d(XpiPktTxQ5NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Egress Queue 2
  assign XpiPktTxQ6NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ6DescWrBackPsn12C);
  
  assign XpiPktTxQ6NextDescRdPsn12C =
	 (XpiPktTxQ6NextDescRdPsn11C || 
	  (XpiPktTxEDescPh2WrEnPsn10C && XpiPktTxQ6DescRdPsn11S)) ?
	   XpiPktTxQ6NextDescRdPsn11C : XpiPktTxQ6NextDescRdPsn12S;
  
DFFR #(1,1'b0) U161_dff (.q(XpiPktTxQ6NextDescRdPsn12S),.d(XpiPktTxQ6NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Egress Queue 3
  assign XpiPktTxQ7NextDescRdPsn11C = 
	 (XpiPktTxDescWrBackEn2Psn10C && XpiPktTxQ7DescWrBackPsn12C);
  
  assign XpiPktTxQ7NextDescRdPsn12C =
	 (XpiPktTxQ7NextDescRdPsn11C || 
	  (XpiPktTxEDescPh2WrEnPsn10C && XpiPktTxQ7DescRdPsn11S)) ?
	   XpiPktTxQ7NextDescRdPsn11C : XpiPktTxQ7NextDescRdPsn12S;
  
DFFR #(1,1'b0) U162_dff (.q(XpiPktTxQ7NextDescRdPsn12S),.d(XpiPktTxQ7NextDescRdPsn12C),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
  // Delaying Next Descriptor Read Enable for two clocks to 
  // sync with PCI Application State Machine
  
DFFR #(1,1'b0) U163_dff (.q(XpiPktTxQ0NextDescRdPsn13S),.d(XpiPktTxQ0NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U164_dff (.q(XpiPktTxQ1NextDescRdPsn13S),.d(XpiPktTxQ1NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U165_dff (.q(XpiPktTxQ2NextDescRdPsn13S),.d(XpiPktTxQ2NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U166_dff (.q(XpiPktTxQ3NextDescRdPsn13S),.d(XpiPktTxQ3NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U167_dff (.q(XpiPktTxQ4NextDescRdPsn13S),.d(XpiPktTxQ4NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U168_dff (.q(XpiPktTxQ5NextDescRdPsn13S),.d(XpiPktTxQ5NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U169_dff (.q(XpiPktTxQ6NextDescRdPsn13S),.d(XpiPktTxQ6NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U170_dff (.q(XpiPktTxQ7NextDescRdPsn13S),.d(XpiPktTxQ7NextDescRdPsn12S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
  
DFFR #(1,1'b0) U171_dff (.q(XpiPktTxQ0NextDescRdPsn14S),.d(XpiPktTxQ0NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U172_dff (.q(XpiPktTxQ1NextDescRdPsn14S),.d(XpiPktTxQ1NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U173_dff (.q(XpiPktTxQ2NextDescRdPsn14S),.d(XpiPktTxQ2NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U174_dff (.q(XpiPktTxQ3NextDescRdPsn14S),.d(XpiPktTxQ3NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U175_dff (.q(XpiPktTxQ4NextDescRdPsn14S),.d(XpiPktTxQ4NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U176_dff (.q(XpiPktTxQ5NextDescRdPsn14S),.d(XpiPktTxQ5NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U177_dff (.q(XpiPktTxQ6NextDescRdPsn14S),.d(XpiPktTxQ6NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));
DFFR #(1,1'b0) U178_dff (.q(XpiPktTxQ7NextDescRdPsn14S),.d(XpiPktTxQ7NextDescRdPsn13S),.clk(XpiPciClk),.reset(GlCoreResetR00C));

  //===========================================
  //==== Descriptor Updates for all Queues ====
  //===========================================

  //-----------------------------------------------------------------
  //---- Ingress Queue 0 Descriptor Update Control State Machine ----
  //-----------------------------------------------------------------

`define XPIPKTTXQ0DESCUPDTIDLE 3'b000
`define XPIPKTTXQ0DESCUPDTS0   3'b001
`define XPIPKTTXQ0DESCUPDTS1   3'b010
`define XPIPKTTXQ0DESCUPDTS2   3'b011
`define XPIPKTTXQ0DESCUPDTS3   3'b101
  
  // State Variables
  wire [2:0] xpipkttxQ0descupdtstate;
  reg [2:0]  next_xpipkttxQ0descupdtstate;
 
  // State Change

