   dti1bitc U2_dti1bitc
      (/*AUTOINST*/
       // Outputs
       .DtiBitCtrlS                     (DtiBit2CtrlS[`DTI_BIT_CTRL_WIDTH-1:0]), // Templated
       .DtiDeskewFailureC               (DtiDeskewFailureC[2]),  // Templated
