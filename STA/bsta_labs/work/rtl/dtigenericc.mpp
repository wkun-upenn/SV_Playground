`include "dtiuc.vh"

module dtigenericc (
   /*AUTOARG*/
   // Outputs
   DtiTrainedS, DtiTrainS, DtiTrainRdValidS, DtiTrainRdDataS, 
   DtiCtrlS, DtiDataS, 
   // Inputs
   TmiTrainWrEnS, TmiTrainWrDataS, TmiTrainRdEnS, GlInitDoneR00C, 
   GlCoreSoftResetSynR00C, EnqGlPortVld, DtiSuperTwo9S, 
   DtiSuperTwo8S, DtiSuperTwo7S, DtiSuperTwo6S, DtiSuperTwo5S, 
   DtiSuperTwo4S, DtiSuperTwo3S, DtiSuperTwo2S, DtiSuperTwo1S, 
   DtiSuperTwo16S, DtiSuperTwo15S, DtiSuperTwo14S, DtiSuperTwo13S, 
   DtiSuperTwo12S, DtiSuperTwo11S, DtiSuperTwo10S, DtiSuperTwo0S, 
   DtiSuperOne9S, DtiSuperOne8S, DtiSuperOne7S, DtiSuperOne6S, 
   DtiSuperOne5S, DtiSuperOne4S, DtiSuperOne3S, DtiSuperOne2S, 
   DtiSuperOne1S, DtiSuperOne16S, DtiSuperOne15S, DtiSuperOne14S, 
   DtiSuperOne13S, DtiSuperOne12S, DtiSuperOne11S, DtiSuperOne10S, 
   DtiSuperOne0S, DtiPosMaskS, DtiNegMaskS, DtiCsixClk, DtiCoreClk, 
   TmiTrainAddrS
);

   parameter DTI_WORD_WIDTH = 17;
   parameter DTI_TCW_VALUE  = 17'h1_0fff;
   parameter DTI_ICW_VALUE  = 17'h1_000f;
   parameter DTI_ADDR_WIDTH = 5;


   //==========================================================================
   //==========               Interface Signals                      ==========
   //==========================================================================
   // You should not have to explicitly declare your input/output for a
   // connectivity file. The AUTOINPUT and AUTOOUTPUT should take care of it.

   /*AUTOINPUT*/
   // Beginning of automatic inputs (from unused autoinst inputs)
   input                DtiCoreClk;             // To U_dtictrlcores of dtictrlcores.v
   input                DtiCsixClk;             // To U_dticlklens of dticlklens.v, ...
   input [`DTI_CLK_MASK_WIDTH-1:0]DtiNegMaskS;  // To U_dticlklens of dticlklens.v
   input [`DTI_CLK_MASK_WIDTH-1:0]DtiPosMaskS;  // To U_dticlklens of dticlklens.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne0S;      // To U0_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne10S;     // To U10_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne11S;     // To U11_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne12S;     // To U12_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne13S;     // To U13_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne14S;     // To U14_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne15S;     // To U15_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne16S;     // To U16_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne1S;      // To U1_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne2S;      // To U2_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne3S;      // To U3_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne4S;      // To U4_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne5S;      // To U5_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne6S;      // To U6_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne7S;      // To U7_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne8S;      // To U8_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperOne9S;      // To U9_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo0S;      // To U0_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo10S;     // To U10_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo11S;     // To U11_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo12S;     // To U12_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo13S;     // To U13_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo14S;     // To U14_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo15S;     // To U15_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo16S;     // To U16_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo1S;      // To U1_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo2S;      // To U2_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo3S;      // To U3_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo4S;      // To U4_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo5S;      // To U5_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo6S;      // To U6_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo7S;      // To U7_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo8S;      // To U8_dti1bitc of dti1bitc.v
   input [`DTI_SSAMPLES-1:0]DtiSuperTwo9S;      // To U9_dti1bitc of dti1bitc.v
   input                EnqGlPortVld;           // To U_dtictrlcores of dtictrlcores.v
   input                GlCoreSoftResetSynR00C; // To U_dtictrlcores of dtictrlcores.v
   input                GlInitDoneR00C;         // To U_dtictrlcores of dtictrlcores.v
   input                TmiTrainRdEnS;          // To U_dtictrlcores of dtictrlcores.v
   input [`DTI_WRDATA_WIDTH-1:0]TmiTrainWrDataS;// To U_dtictrlcores of dtictrlcores.v
   input                TmiTrainWrEnS;          // To U_dtictrlcores of dtictrlcores.v
   // End of automatics

   // To avoid allowing its parameterized bus width to escape to higher
   // levels of hierarchy, we give this input an explicit width.
   input [4:0]          TmiTrainAddrS;


   /*AUTOOUTPUT*/
   // Beginning of automatic outputs (from unused autoinst outputs)
   output [`DTI_RDDATA_WIDTH-1:0]DtiTrainRdDataS;// From U_dtictrlcores of dtictrlcores.v
   output               DtiTrainRdValidS;       // From U_dtictrlcores of dtictrlcores.v
   output               DtiTrainS;              // From U_dticombines of dticombines.v
   output               DtiTrainedS;            // From U_dticombines of dticombines.v
   // End of automatics

   // Because of the way we templated them,
   // these outputs need to be declared explicitly.
   output [1:0]         DtiCtrlS;
   output [31:0]        DtiDataS;


   //==========================================================================
   //==========               Internal Signals                       ==========
   //==========================================================================
   // You should not have to explicitly declare wires for a connectivity file.
   // AUTOWIRE should declare it for you.

   /*AUTOWIRE*/
   // Beginning of automatic wires (for undeclared instantiated-module outputs)
   wire [DTI_ADDR_WIDTH-1:0]DtiAddrCoreS;       // From U_dtictrlcores of dtictrlcores.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit0CtrlS;  // From U0_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit10CtrlS; // From U10_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit11CtrlS; // From U11_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit12CtrlS; // From U12_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit13CtrlS; // From U13_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit14CtrlS; // From U14_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit15CtrlS; // From U15_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit16CtrlS; // From U16_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit1CtrlS;  // From U1_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit2CtrlS;  // From U2_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit3CtrlS;  // From U3_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit4CtrlS;  // From U4_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit5CtrlS;  // From U5_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit6CtrlS;  // From U6_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit7CtrlS;  // From U7_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit8CtrlS;  // From U8_dti1bitc of dti1bitc.v
   wire [`DTI_BIT_CTRL_WIDTH-1:0]DtiBit9CtrlS;  // From U9_dti1bitc of dti1bitc.v
   wire [DTI_WORD_WIDTH-1:0]DtiBitWrEnC;        // From U_dtictrlcsixs of dtictrlcsixs.v
   wire [`DTI_CLKLEN_CTRL_WIDTH-1:0]DtiClkLenCtrlS;// From U_dticlklens of dticlklens.v
   wire                 DtiClkLenWrEnC;         // From U_dtictrlcsixs of dtictrlcsixs.v
   wire                 DtiCsixSoftResetSynZ01SL;// From U_dtictrlcsixs of dtictrlcsixs.v
   wire [`DTI_CYCLE_THRESHOLD_WIDTH-1:0]DtiCycleThresholdS;// From U_dtictrlcsixs of dtictrlcsixs.v
   wire [16:0]          DtiDeskewFailureC;      // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiDeskewedWord0C;      // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiDeskewedWord1C;      // From U0_dti1bitc of dti1bitc.v, ...
   wire                 DtiDoTrainingC;         // From U_dtictrlcsixs of dtictrlcsixs.v
   wire                 DtiDoneStretchingZnS;   // From U_dtictrlcores of dtictrlcores.v
   wire                 DtiFirstTDWC;           // From U_dticombines of dticombines.v
   wire                 DtiFoundPrefTCWC;       // From U_dtifindtcws of dtifindtcws.v
   wire                 DtiGetNewPrimarySelC;   // From U_dticombines of dticombines.v
   wire [16:0]          DtiHistoryWord3S;       // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiHistoryWord4S;       // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiHistoryWord5S;       // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiHistoryWord6S;       // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiHistoryWord7C;       // From U0_dti1bitc of dti1bitc.v, ...
   wire [16:0]          DtiHistoryWord8C;       // From U0_dti1bitc of dti1bitc.v, ...
   wire                 DtiPrefOverSelReadyS;   // From U_dticlklens of dticlklens.v
   wire [`DTI_OSAMPLE_SEL_WIDTH-1:0]DtiPrefOverSelS;// From U_dticlklens of dticlklens.v
   wire [16:0]          DtiPrimarySelReadyS;    // From U0_dti1bitc of dti1bitc.v, ...
   wire [`DTI_RDDATA_WIDTH-1:0]DtiRdDataCsixS;  // From U_dtictrlcsixs of dtictrlcsixs.v
   wire                 DtiRdEnTransS;          // From U_dtictrlcores of dtictrlcores.v
   wire                 DtiRdValidTransS;       // From U_dtictrlcsixs of dtictrlcsixs.v
   wire [DTI_WORD_WIDTH-1:0]DtiTCWC;            // From U_dticombines of dticombines.v
   wire [`DTI_TRAINING_MODE_WIDTH-1:0]DtiTrainingModeS;// From U_dtictrlcsixs of dtictrlcsixs.v
   wire [`DTI_TRANS_THRESHOLD_WIDTH-1:0]DtiTransThresholdS;// From U_dtictrlcsixs of dtictrlcsixs.v
   wire [`DTI_WRDATA_WIDTH-1:0]DtiWrDataCoreS;  // From U_dtictrlcores of dtictrlcores.v
   wire [`DTI_WRDATA_WIDTH-1:0]DtiWrDataS;      // From U_dtictrlcsixs of dtictrlcsixs.v
   wire                 DtiWrEnTransS;          // From U_dtictrlcores of dtictrlcores.v
   // End of automatics


   //==========================================================================
   //==========             SubBlock Instantiation                   ==========
   //==========================================================================
   // You should instantiate your sub blocks here. It may be useful to use
   // AUTO_TEMPLATE when instantiating multiple instances of the same module.


   // Module Name: dticlklens
   // Instance Name: U_dticlklens
   // Description: Convert phase-overlap masks into average phase length

   dticlklens U_dticlklens
      (/*AUTOINST*/
       // Outputs
       .DtiPrefOverSelS                 (DtiPrefOverSelS[`DTI_OSAMPLE_SEL_WIDTH-1:0]),
       .DtiPrefOverSelReadyS            (DtiPrefOverSelReadyS),
       .DtiClkLenCtrlS                  (DtiClkLenCtrlS[`DTI_CLKLEN_CTRL_WIDTH-1:0]),
       // Inputs
       .DtiCsixClk                      (DtiCsixClk),
       .DtiCsixSoftResetSynZ01SL        (DtiCsixSoftResetSynZ01SL),
