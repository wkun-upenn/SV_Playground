        {5'd24,3'd1}: DtiPrefPrimarySelC = `DTI_OSAMPLE_24_1;
        {5'd24,3'd2}: DtiPrefPrimarySelC = `DTI_OSAMPLE_24_2;
        {5'd24,3'd3}: DtiPrefPrimarySelC = `DTI_OSAMPLE_24_3;
        {5'd24,3'd4}: DtiPrefPrimarySelC = `DTI_OSAMPLE_24_4;
// surefire lint_on ASWCBS ASWCBM

        default:      DtiPrefPrimarySelC = {`DTI_SSAMPLE_WIDTH{1'bx}};
      endcase // case({DtiOverSelS,DtiFittestOversampleS})
   end // always @(...)

   // Record the preferred supersample number when the fittest oversample
   // number is valid.
EDFF #(5) U6_dff (.q(DtiPrefPrimarySelS),.d(DtiPrefPrimarySelC),.en(DtiFittestOversampleValidS),.clk(DtiCsixClk));




   // Transfer the preferred supersample number to become the primary
   // selection point when directed to do so.  Or it can be overridden
   // by a forced value from software.

   assign DtiNextPrimarySelC = DtiSuperSelForceEnS  ? DtiSuperSelForceValueS :
                               DtiGetNewPrimarySelC ? DtiPrefPrimarySelS :
                                                      DtiPrimarySelS;

DFF #(5) U7_dff (.q(DtiPrimarySelS),.d(DtiNextPrimarySelC),.clk(DtiCsixClk));



   ////////////////////////////////////////////////////////////////////////////
   // Use the primary selection number to choose a primary sample in
   // each clock phase from the captured supersamples.

// surefire lint_off BWEEBB
   assign DtiSampleOneZ10C = |((1 << DtiPrimarySelS) & DtiSuperOneLocalS);
   assign DtiSampleTwoZ10C = |((1 << DtiPrimarySelS) & DtiSuperTwoLocalS);
// surefire lint_on BWEEBB


endmodule // dtiovers


